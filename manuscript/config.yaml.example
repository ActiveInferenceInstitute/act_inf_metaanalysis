# Example configuration for act_inf_metaanalysis (copy to config.yaml)

paper:
  title: "A Living Meta-Analysis Architecture for Active Inference"
  subtitle: "Assertion Extraction, Nanopublications, and Hypothesis Scoring"
  version: "2.0.1"

authors:
  - name: "Author Name"
    orcid: "0000-0000-0000-0000"
    email: "author@example.com"
    affiliations:
      - "Institution"
    corresponding: true

publication:
  doi: ""
  repository: "https://github.com/ActiveInferenceInstitute/act_inf_metaanalysis"

keywords:
  - "active inference"
  - "free energy principle"

metadata:
  license: "CC-BY-4.0"
  language: "en"

llm:
  reviews:
    enabled: false
  translations:
    enabled: false

project_config:
  search:
    start_year: 2000
    query: '"active inference" "free energy principle"'
    max_results: 1000
    resume: true
    clear_corpus: false
    arxiv_queries:
      - 'all:"active inference"'
      - 'all:"free energy principle"'
    relevance_keywords:
      - "active inference"
      - "free energy principle"
      - "predictive coding"

  knowledge_graph:
    checkpoint_interval: 50
    clear_assertions: false
    max_papers: null

  llm_extraction:
    model: "gemma3:4b"
    base_url: "http://localhost:11434"
    temperature: 0.1
    max_tokens: 2048
    timeout_seconds: 120
    max_retries: 3
    min_confidence: 0.6
