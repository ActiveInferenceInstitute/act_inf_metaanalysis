        ns2:claim "The paper demonstrates that goal shaping (exploitation) leads to the best performance *within* the task but simultaneously hinders learning about the environment's dynamics – a clear deviation from optimality in a broader sense."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "…it promotes exploitation) while sacrificing learning about the environment’s transition dynamics (i.e., it hampers exploration)."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "goal shaping enables the best performance overall (i.e., it promotes exploitation) while sacrificing learning about the environment’s transition dynamics (i.e., it hampers exploration)."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2512.03293> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.03293_AIF_OPTIMALITY> .
}

