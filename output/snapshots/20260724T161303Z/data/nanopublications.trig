<http://activeinference.institute/nanopub/9b0913d63e37#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_1805.09109> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1805.09109_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_1805.09109_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application (P300 speller) and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We appeal to a generic Bayesian approach, called Active Inference (AI), to infer user's intentions or states and act in a way that optimizes performance."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We appeal to a generic Bayesian approach, called Active Inference (AI), to infer user's intentions or states and act in a way that optimizes performance."^^xsd:string .
}

