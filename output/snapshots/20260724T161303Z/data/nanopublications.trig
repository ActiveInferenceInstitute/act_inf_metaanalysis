        ns2:prov_processing_date "2026-07-23T16:36:59.598393+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "This paper presents a continuous, information-theoretic extension of the Free Energy Principle through the concept of Markov blanket density, i.e., a scalar field that quantifies the degree of conditional independence between internal and external states at each point in space (ranging from 0 for full coupling to 1 for full separation). It demonstrates that active inference dynamics, including the minimization of variational and expected free energy, naturally emerge from spatial gradients in this density, "^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T16:36:59.598501+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_2506.05794> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/1dd220d83ec9> .
}

