<http://activeinference.institute/nanopub/3a4be61718a2#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1098_rspa.2025.0538> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rspa.2025.0538_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rspa.2025.0538_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses a general framework for modeling interacting systems using generative models and the FEP, but doesn't explicitly state that the FEP applies universally."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The FEP is a method whose use allows us to build a model of the dynamics of an object as if it were a process of variational inference..."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The ensuing variational free energy principle (FEP) has certain advantages over using random dynamical systems explicitly, notably, by being more tractable and offering a parsimonious explanation of why the joint system evolves in the way that it does, based on the properties of the coupling between system components."^^xsd:string .
}

