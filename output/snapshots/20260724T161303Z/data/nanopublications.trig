<http://activeinference.institute/nanopub/0201a01a4aff#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1080_17588928.2013.877880> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_17588928.2013.877880_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_17588928.2013.877880_FEP_UNIVERSALITY> ns2:citationCount 347 ;
        ns2:claim "The paper discusses a specific theory within the broader FEP framework but doesn't directly address the universality claim itself. It focuses on perceptual mechanisms rather than fundamental principles."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"While the generative models underlying normal perception are typically counterfactually rich (reflecting a large repertoire of possible sensorimotor dependencies), those underlying synesthetic concurrents are hypothesized to be counterfactually poor.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "These \"counterfactually-rich\" generative models encode sensorimotor contingencies related to repertoires of sensorimotor dependencies, with counterfactual richness determining the degree of perceptual presence associated with a stimulus."^^xsd:string .
}

