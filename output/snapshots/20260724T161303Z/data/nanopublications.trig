<http://activeinference.institute/nanopub/bf97bc5684d2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsif.2017.0792_FEP_UNIVERSALITY> ns2:citationCount 428 ;
        ns2:claim "The paper explicitly argues that the FEP applies to all autonomous systems, including those from individual cells to humans."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "any living system is a Markov blanketed system"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This work addresses the autonomous organization of biological systems. It does so by considering the boundaries of biological systems, from individual cells to <i>Home sapiens</i>, in terms of the presence of Markov blankets under the active inference scheme-a corollary of the free energy principle."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.1098_rsif.2017.0792> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsif.2017.0792_FEP_UNIVERSALITY> .
}

