<http://activeinference.institute/nanopub/5c370d312f2b#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_0905.3528_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
