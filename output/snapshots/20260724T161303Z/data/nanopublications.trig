<http://activeinference.institute/nanopub/aea974ec51af#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.10835_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly demonstrates a complex, self-organizing system (flocking agents) exhibiting emergent properties consistent with the FEP's core tenets."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "We combine active inference and information-theoretic analyses to explore how a minimal system of interacting agents can give rise to joint agency and collective knowledge."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We show how informational coupling among active inference agents can generate new levels of autonomy and inference, providing a framework for understanding the emergence of (implicit) collective knowledge and joint agency."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/arxiv_2511.10835> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.10835_FEP_UNIVERSALITY> .
}

