}

<http://activeinference.institute/nanopub/e0293f5c9f67#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1408.2037_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:1408.2037"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T22:32:56.679192+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "This paper presents studies on a deterministic annealing algorithm based on quantum annealing for variational Bayes (QAVB) inference, which can be seen as an extension of the simulated annealing for variational Bayes (SAVB) inference. QAVB is as easy as SAVB to implement. Experiments revealed QAVB finds a better local optimum than SAVB in terms of the variational free energy in latent Dirichlet allocation (LDA)."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:32:56.679620+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_1408.2037> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/e0293f5c9f67> .
}

<http://activeinference.institute/nanopub/1fc73a0acc72#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2004.08366_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper mentions inspiration from the Free Energy Principle (FEP) but doesn't explicitly state that it applies universally. It focuses on a specific application – model growth and evolution – rather than a general principle."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "drawing inspiration from from the free energy principle [15] to introduce the concept of reaction to discharge non-digestive energy"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We propose both a theory and a working system design which remove this limitation, and show that the resulting models are able to perform better and efficiently run at a much larger scale. Specifically, we achieve this by decoupling a model's content from its form to tackle architecture evolution and memory growth separately."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2004.08366> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2004.08366_FEP_UNIVERSALITY> .
}

