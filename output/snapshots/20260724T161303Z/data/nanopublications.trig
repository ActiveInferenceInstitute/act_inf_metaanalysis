        ns2:claim "The paper explicitly demonstrates how S-HAI reproduces behavioral signatures of rapid generalization – a key aspect of optimal decision-making under uncertainty within the AIF framework."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "S-HAI reproduces key behavioral signatures of rapid schema-based generalization in spatial navigation tasks..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Through a series of simulations, we show that S-HAI reproduces key behavioral signatures of rapid schema-based generalization in spatial navigation tasks, including the ability to flexibly remap abstract schemas onto novel contexts, resolve goal ambiguity, and balance reuse versus accommodation of novel mappings."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2601.18946> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2601.18946_AIF_OPTIMALITY> .
}

