<http://activeinference.institute/nanopub/4bdee5fd3a49#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.11829_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that a value-profile based Active Inference model outperforms simpler alternatives in probabilistic reversal learning, suggesting it achieves adaptive control (optimality) under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Model comparison favors the profile-based model over simpler alternatives (about 100-point AIC differences)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Model comparison favors the profile-based model over simpler alternatives (about 100-point AIC differences), and parameter-recovery analyses support structural identifiability even when context must be inferred from noisy observations."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2512.11829> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.11829_AIF_OPTIMALITY> .
}

