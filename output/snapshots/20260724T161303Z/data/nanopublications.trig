        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This paper proposes such a model based on active inference, a behavioral modeling framework originating in computational neuroscience."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2311.06417> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2311.06417_FEP_UNIVERSALITY> .
