    <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.03208_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that active inference achieves the same level of accuracy with fewer samples than existing baselines, implying optimal decision-making under uncertainty by efficiently utilizing data collection."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Active inference constructs provably valid confidence intervals and hypothesis tests while leveraging any black-box machine learning model and handling any data distribution."^^xsd:string ;
