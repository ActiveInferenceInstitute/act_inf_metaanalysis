    <http://activeinference.institute/ontology/assertion/llm_arxiv_2311.10216_MORPHOGENESIS> ns2:citationCount 0 ;
        ns2:claim "The paper suggests that the FEP can explain morphogenetic and developmental processes by describing how systems minimize free energy to match their environment, a core concept in morphogenesis."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "performing variational Bayesian inference of their interacting environment"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In essence, these self-organising systems can be read as performing variational Bayesian inference of their interacting environment."^^xsd:string ;
