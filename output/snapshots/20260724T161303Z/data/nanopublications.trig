<http://activeinference.institute/nanopub/c0066d9c4209#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnbot.2024.1341750_AIF_OPTIMALITY> ns2:citationCount 18 ;
        ns2:claim "The paper argues that the model's behavior (adaptive driving) emerges from minimizing expected free energy, which aligns with the core claim of AIF optimality – that agents driven by this principle will make optimal decisions."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The model offers a principled solution to how humans trade progress against caution through policy selection based on the single mandate to minimize expected free energy."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This casts goal-seeking and information-seeking (uncertainty-resolving) behavior under a single objective function, allowing the model to seamlessly resolve uncertainty as a means to obtain its goals."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnbot.2024.1341750> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnbot.2024.1341750_AIF_OPTIMALITY> .
}

