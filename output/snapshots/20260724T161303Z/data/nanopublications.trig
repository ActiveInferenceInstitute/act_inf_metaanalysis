    <http://activeinference.institute/ontology/assertion/llm_arxiv_1103.1587_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses a formal foundation for cognition based on the FEP but doesn't explicitly state that it applies universally. It frames the FEP as a foundational principle within their specific topological framework."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This framework distinguishes two modes: Inference (waking), where the scaffold predicts the flow (a Context-before-Content process); and Learning (sleep), an inverted Structure-before-Specificity process where memory traces sculpt the scaffold."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This framework distinguishes two modes: Inference (waking), where the scaffold predicts the flow (a Context-before-Content process); and Learning (sleep), an inverted Structure-before-Specificity process where memory traces sculpt the scaffold."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_1103.1587> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1103.1587_FEP_UNIVERSALITY> .
}

