    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_tmbmc.2023.3272158_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.1109/tmbmc.2023.3272158"^^xsd:string ;
