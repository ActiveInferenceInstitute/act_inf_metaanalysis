        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This theory, hierarchical or deep neurophenomenology, extends the notion of (neural) hermeneutics to systems beyond the brain, crucially including the shared ecological niche."^^xsd:string .
}

