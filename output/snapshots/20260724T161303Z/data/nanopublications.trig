<http://activeinference.institute/nanopub/f23c98c8feba#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3084523811_AIF_OPTIMALITY> ns2:citationCount 22 ;
        ns2:claim "The paper explicitly demonstrates that active inference (minimizing free energy) can lead to reward maximization when states are unambiguous, aligning with the definition of optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "When target states correspond to rewarding states, this maximises expected reward, as in reinforcement learning."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In active inference, agents select actions to minimise expected free energy. When target states correspond to rewarding states, this maximises expected reward, as in reinforcement learning."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/openalex_https___openalex.org_W3084523811> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3084523811_AIF_OPTIMALITY> .
}

