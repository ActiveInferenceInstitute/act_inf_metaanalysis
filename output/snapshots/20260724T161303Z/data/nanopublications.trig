<http://activeinference.institute/nanopub/31bb466c58e9#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.02447_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper proposes an optimization algorithm based on the Kelly criterion and free energy minimization, which aligns with the core principles of Active Inference – actively minimizing prediction error to achieve optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The algorithm was the result of casting the generalized Kelly criterion for optimal betting into a multiclass classification problem."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The proposed objective function was the expected free energy of a prospective active inference and could incorporate the candidate labels, the original reference labels, and the priors of the training samples while still being distribution-based."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2306.02447> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.02447_AIF_OPTIMALITY> .
}

