        ns2:sourceClaim "We argue that recently proposed principles of economy in language design—such as ‘minimal search’ criteria from theoretical syntax—adhere to the FEP."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_r3fcx> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_r3fcx_FEP_UNIVERSALITY> .
