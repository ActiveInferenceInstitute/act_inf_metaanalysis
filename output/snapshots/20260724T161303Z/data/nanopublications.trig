    <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.11811_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the algorithm aims to maximize reward by inferring future states and actions, aligning with the core principle of Active Inference – achieving optimality through minimizing free energy."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The algorithm thus reduces exploration costs by partially imitating experts as well as maximizing its return in a seamless way, resulting in a higher performance than the suboptimal expert."^^xsd:string ;
