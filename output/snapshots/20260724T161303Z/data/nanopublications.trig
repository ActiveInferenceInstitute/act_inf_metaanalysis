        ns2:claim "The paper describes attractors encoding prior beliefs and integrating sensory data into posterior beliefs, aligning with the predictive coding framework."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Attractors on the free energy landscape encode prior beliefs; inference integrates sensory data into posterior beliefs; and learning fine-tunes couplings to minimize long-term surprise."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Attractors on the free energy landscape encode prior beliefs; inference integrates sensory data into posterior beliefs; and learning fine-tunes couplings to minimize long-term surprise."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2505.22749> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2505.22749_PREDICTIVE_CODING> .
}

