<http://activeinference.institute/nanopub/b5d0595be0c2#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frai.2020.00030_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
