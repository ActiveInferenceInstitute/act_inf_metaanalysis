        ns2:claim "The introduction of a geometric extension and the use of spectral graph theory suggest a framework capable of handling high-dimensional data and complex network topologies – a key aspect of scalability."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "We derive the Spectral Rank Contraction Theorem, linking localized curvature constraints to global dimensionality collapse via Cheeger conductance bounds"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We derive the Spectral Rank Contraction Theorem, linking localized curvature constraints to global dimensionality collapse via Cheeger conductance bounds"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .
}

