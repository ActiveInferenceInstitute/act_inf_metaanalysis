        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "Abstract Research in evolutionary biology and philosophy of biology and cognition strongly suggests that human organisms modify their environment through active processes of niche construction. Recently, proponents of the free-energy principle and variational active inference have argued that their approach can deepen our understanding of the reciprocal causal relationship between organisms and their niche on various scales. This paper examines the feasibility and scope of variational formalisations and con"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:57:05.131787+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1007_s10539-021-09782-6> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/75c1bb464c9b> .
}

