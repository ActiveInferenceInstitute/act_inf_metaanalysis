<http://activeinference.institute/nanopub/bb429c03273d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e23060783_FEP_UNIVERSALITY> ns2:citationCount 52 ;
        ns2:claim "The paper primarily focuses on embodied cognition and self-modeling within the FEP framework, without directly addressing the universality claim of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"quasi-homuncular ESMs are suggested to constitute a major organizing principle for neural architectures due to their initial and ongoing significance for solutions to inference problems in cognitive (and affective) development.\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Drawing from both enactivist and cognitivist perspectives on mind, I propose that explaining teleological phenomena may require reappraising both \"Cartesian theaters\" and mental homunculi in terms of embodied self-models (ESMs)."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e23060783> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e23060783_FEP_UNIVERSALITY> .
}

