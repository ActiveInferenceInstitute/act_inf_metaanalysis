<http://activeinference.institute/nanopub/8122ba816a7d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsif.2017.0376_AIF_OPTIMALITY> ns2:citationCount 261 ;
        ns2:claim "The paper demonstrates how Active Inference (through simulated saccade behavior) leads to optimal decision-making – specifically, reduced saccades in regions of low sensory precision and shorter inhibition of return in volatile environments – aligning with the core principle of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In our simulations, saccades were deployed less frequently to regions with a lower sensory precision, while a greater volatility led to a shorter inhibition of return."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "In our simulations, saccades were deployed less frequently to regions with a lower sensory precision, while a greater volatility led to a shorter inhibition of return."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1098_rsif.2017.0376> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsif.2017.0376_AIF_OPTIMALITY> .
}

