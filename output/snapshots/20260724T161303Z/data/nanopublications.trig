        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here, we take a different approach: starting with active inference, a first principles framework for modelling behaviour as (approximate) Bayesian inference, and building up to a minimal theory of consciousness, which emerges from the shared features of computational models derived under active inference."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2410.06633> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2410.06633_FEP_UNIVERSALITY> .
