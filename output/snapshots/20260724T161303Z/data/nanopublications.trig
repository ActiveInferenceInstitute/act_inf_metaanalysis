<http://activeinference.institute/nanopub/c281603b654e#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.neucom.2024.129319_SCALABILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
