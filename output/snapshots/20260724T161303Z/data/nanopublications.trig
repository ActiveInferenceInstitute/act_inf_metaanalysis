<http://activeinference.institute/nanopub/c368af056c20#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-019-00805-w_FEP_UNIVERSALITY> ns2:citationCount 207 ;
        ns2:claim "The paper discusses a general free energy functional applicable to both action and perception, suggesting a broader applicability of the FEP beyond specific biological systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We compare two free energy functionals for active inference in the framework of Markov decision processes. One of these is a functional of beliefs (i.e. probability distributions) about states and policies, but a function of observations, while the second is a functional of beliefs about all three."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This implies a common objective function (variational free energy) for action and perception that scores the fit between an internal model and the world."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s00422-019-00805-w> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-019-00805-w_FEP_UNIVERSALITY> .
}

