        ns2:claim "The paper discusses active inference as a general control scheme for robots, aligning with the broader FEP's claim of universal applicability but doesn’t directly test this universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The proposed method is based on active inference, a promising neuroscientific theory of the brain, which describes a biologically plausible algorithm for perception and action."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This scheme is easily scalable to high degrees-of-freedom, and it maintains high performance even in the presence of large unmodeled dynamics."^^xsd:string .

