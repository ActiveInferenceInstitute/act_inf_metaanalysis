        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "This paper proposes a novel theoretical framework that reinterprets quantum behavior—superposition, interference, and wavefunction collapse—not as fundamental properties of matter but as emergent epistemic properties of a specific class of information-processing architectures, termed Ze systems. A Ze system is defined as an active predictive engine that operates on continuous data streams through two distinct modes: forward reading (ℱ) and retrograde encoding (ℛ). The core architectural constraint is that ℛ"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T23:38:19.604891+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.65649_93qfwv21> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/2bf1f01b6dfb> .
}

