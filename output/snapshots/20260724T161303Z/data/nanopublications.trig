<http://activeinference.institute/nanopub/97cb67bd2094#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2023.1150743_MARKOV_BLANKET_REALISM> ns2:citationCount 4 ;
        ns2:claim "The paper’s emphasis on contextual functions and a fitness interface suggests an active construction of reality rather than a passive correspondence to Markov blankets."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "This approach, formalized through a post-Skinnerian account of behaviorism called relational frame theory (RFT), can, in fact, be shown to correspond with an evolutionary fitness function"^^xsd:string ;
