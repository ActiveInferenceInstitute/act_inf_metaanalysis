<http://activeinference.institute/nanopub/abcfc21edd41#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_r3fcx_LANGUAGE_AIF> ns2:citationCount 6 ;
        ns2:claim "The paper's central argument is that Active Inference provides a viable framework for language processing, aligning with the principles of syntax and computation."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…offers linguistics a grounding in first principles with respect to computability"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We argue that recently proposed principles of economy in language design—such as ‘minimal search’ criteria from theoretical syntax—adhere to the FEP. This affords a greater degree of explanatory power to the FEP—with respect to higher language functions—and offers linguistics a grounding in first principles with respect to computability."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/language_aif> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_r3fcx> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_r3fcx_LANGUAGE_AIF> .
}

