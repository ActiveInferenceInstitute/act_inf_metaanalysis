    <http://activeinference.institute/ontology/assertion/llm_doi_10.1177_0963721415570732_PREDICTIVE_CODING> ns2:citationCount 360 ;
        ns2:claim "The paper explicitly frames language within the predictive processing framework, emphasizing its role in constructing predictions against which sensory signals are evaluated – a core tenet of predictive coding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…language begins to take on a surprisingly central role in cognition by providing a uniquely focused and flexible means of constructing predictions against which sensory signals can be evaluated."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…language begins to take on a surprisingly central role in cognition by providing a uniquely focused and flexible means of constructing predictions against which sensory signals can be evaluated."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .
}

