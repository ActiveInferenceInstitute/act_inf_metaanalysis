<http://activeinference.institute/nanopub/2c410713e6c7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2109.04139_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper presents a specific application of Active Inference (through predictive processing) in robotics, focusing on localization and navigation. While this demonstrates the principle's applicability within a defined system, it doesn’t directly address the universal claim of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We learn the generative model of the laser through self-supervised learning and perform both online state-estimation and navigation through stochastic gradient descent on the variational free-energy bound."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We learn the generative model of the laser through self-supervised learning and perform both online state-estimation and navigation through stochastic gradient descent on the variational free-energy bound."^^xsd:string .

