<http://activeinference.institute/nanopub/e6c72e130124#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17880033_AIF_OPTIMALITY> ns2:citationCount 2 ;
        ns2:claim "The paper frames intelligence as thermodynamically constrained organization of information flows and growth, which is fundamentally different from the optimization-based approach of AIF."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "Under information-thermodynamic inequalities and Landauer-type structural cost assumptions, the paper proves law-like resource inequalities that bound the long-time growth rate of intrinsic semantic capacity in terms of entropy-production budgets and non-isothermal information-processing cost factors."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "These are shown to be robust under broad equivalence classes of codes and alphabets, under explicit asymptotic scaling assumptions."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.17880033> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17880033_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/e350ea98367a#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frobt.2018.00021_FEP_UNIVERSALITY> ns2:citationCount 93 ;
        ns2:claim "The paper explicitly states that free energy minimization provides a theoretical basis for unifying particles, organisms, and machines across diverse domains, suggesting universal applicability."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The latter provides a theoretical basis for a unified treatment of particles, organisms, and interactive machines, spanning from the inorganic to organic, non-life to life, and natural to artificial agents."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
