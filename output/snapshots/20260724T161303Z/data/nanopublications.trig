    <http://activeinference.institute/ontology/assertion/llm_arxiv_1112.1125_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that agents learn efficiently using Bayesian inference and achieve greater success in tasks, aligning with the core principle of AIF."^^xsd:string ;
