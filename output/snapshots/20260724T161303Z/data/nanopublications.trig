<http://activeinference.institute/nanopub/8eab00d181dc#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2023.1170480_MARKOV_BLANKET_REALISM> ns2:citationCount 3 ;
        ns2:claim "Cieri's use of the Default Network (DN) and its overlap with time perception suggests a specific boundary (the DN) that defines a relevant region for self-representation, aligning with Markov blanket concepts."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "The ontogenetic development of time perception is discussed, consistent with the development of self and the DN's function."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Cieri starts from the philosophical and scientific tradition of a proximity between time and self, suggesting a neural overlap in the Default Network (DN), supporting his hypothesis with studies in cognitive neurosciences and functional Magnetic Resonance Imaging (rs-fMRI)."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnhum.2023.1170480> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2023.1170480_MARKOV_BLANKET_REALISM> .
}

