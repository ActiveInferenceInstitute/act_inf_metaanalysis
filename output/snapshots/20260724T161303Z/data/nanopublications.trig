        ns2:evidenceQuote "brain-body-environment interactions"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "we argue that the translator’s mind emerges, rather than being merely extended, through loops of brain-body-environment interactions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/language_aif> .
}

