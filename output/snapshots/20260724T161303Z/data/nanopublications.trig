<http://activeinference.institute/nanopub/697b8e434a02#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01341_FEP_UNIVERSALITY> ns2:citationCount 220 ;
        ns2:claim "The paper focuses on a specific instantiation of Active Inference (affective inference) and doesn't directly address the universality claim of the FEP itself. It demonstrates its applicability within a particular domain – emotion – but doesn’t prove it applies to *all* self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We show how maintaining internal valence representations allows the ensuing affective agent to optimize confidence in action selection preemptively."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This formulation offers a principled account of the link between affect, (mental) action, and implicit metacognition."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01341> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01341_FEP_UNIVERSALITY> .
}

