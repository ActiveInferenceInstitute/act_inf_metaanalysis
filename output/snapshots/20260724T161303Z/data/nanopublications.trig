<http://activeinference.institute/nanopub/61f591af326f#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2512.17735> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.17735_PREDICTIVE_CODING> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.17735_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper's emphasis on predictive mechanisms (internal models of gravity and extended temporal horizons) aligns with the core concept of predictive coding – minimizing prediction errors through hierarchical processing."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "predicting the future interception point yields lower action values and smoother trajectories"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Predicting the future interception point yields lower action values and smoother trajectories compared to short-horizon prediction."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .
}

