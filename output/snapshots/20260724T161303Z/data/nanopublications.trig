<http://activeinference.institute/nanopub/751f7d62df87#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.60087_jaigs.v4i1.78> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.60087_jaigs.v4i1.78_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.60087_jaigs.v4i1.78_FEP_UNIVERSALITY> ns2:citationCount 1 ;
        ns2:claim "The paper introduces active inference as a framework for AI, focusing on decision-making and introspection, but doesn't explicitly address the universality of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Initially, we offer a concise introduction to active inference, emphasizing its relevance to modeling decision-making, introspection, and the generation of both overt and covert actions."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This paper explores the feasibility of constructing interpretable artificial intelligence (AI) systems rooted in active inference and the free energy principle."^^xsd:string .
}

<http://activeinference.institute/nanopub/251b64612cf5#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_icassp49357.2023.10096947_FEP_UNIVERSALITY> ns2:citationCount 5 ;
        ns2:claim "The paper focuses on a specific application (autonomous driving) and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The proposed approach affords explainable decision-making as a combination of self-information and novelty-seeking or exploratory behavior in a hierarchical generative model."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We integrate the imitation learning method with active inference to minimize the expected free energy under the supervision of an expert model."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1109_icassp49357.2023.10096947> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_icassp49357.2023.10096947_FEP_UNIVERSALITY> .
}

