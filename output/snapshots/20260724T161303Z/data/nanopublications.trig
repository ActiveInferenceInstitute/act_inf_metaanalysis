        ns2:evidenceQuote "\"However, proposing a sharp distinction neglects the value of recognising a continuum spanning from instrumental to ontological. However, proposing a sharp distinction neglects the value of recognising a continuum spanning from instrumental to ontological.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Bruineberg and colleagues helpfully distinguish between instrumental and ontological interpretations of Markov blankets, exposing the dangers of using the former to make claims about the latter."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2201.06900> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2201.06900_MARKOV_BLANKET_REALISM> .
}

