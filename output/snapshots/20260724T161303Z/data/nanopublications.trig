<http://activeinference.institute/nanopub/7bff940e3cc9#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.10088_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The model's design – incorporating discrete and continuous processing, hierarchical relationships, and dynamic trajectories – suggests it *could* scale to complex environments."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…the representation of potential body configurations in relation to the objects of interest; the use of hierarchical relationships that enable the agent to easily interpret and flexibly expand its body schema for tool use; the definition of potential trajectories related to the agent’s intentions, used to infer and plan with dynamic elements at different temporal scales."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2402.10088> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.10088_SCALABILITY> .
}

