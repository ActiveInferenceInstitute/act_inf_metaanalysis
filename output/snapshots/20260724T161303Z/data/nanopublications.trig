        ns2:claim "The paper describes a system using Active Inference to solve a specific problem (fetal heart rate tracking). While it demonstrates the application of AIF, it doesn't directly address the universal applicability of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The proposed cognitive ultrasound system leverages a sequential Monte Carlo method to infer the fetal heart position from the power Doppler signal, and employs a greedy information-seeking criterion to select the steering angle that minimizes the positional uncertainty for future timesteps."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The proposed cognitive ultrasound system leverages a sequential Monte Carlo method to infer the fetal heart position from the power Doppler signal..."^^xsd:string .

