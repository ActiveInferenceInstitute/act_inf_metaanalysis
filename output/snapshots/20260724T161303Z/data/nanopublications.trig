    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11097-017-9525-z_PREDICTIVE_CODING> ns2:citationCount 151 ;
        ns2:claim "The paper’s central premise is based on the information-theoretic view of brains as prediction error minimization devices, directly supporting the core mechanism of predictive coding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "minimize prediction error signals: signals that encode the difference between actual and expected sensory stimulations"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Recent work in cognitive and computational neuroscience depicts human brains as devices that minimize prediction error signals: signals that encode the difference between actual and expected sensory stimulations."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s11097-017-9525-z> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11097-017-9525-z_PREDICTIVE_CODING> .
}

<http://activeinference.institute/nanopub/50082aa26aa8#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2025.3636032_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The proposed framework (multiple timescale dynamics and abstracting actions) is designed to address the scalability challenges of conventional deep active inference approaches, specifically regarding computational cost."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "The action model compresses action sequences into abstract actions using vector quantization, and the abstract world model predicts future slow states conditioned on the abstract action, enabling low-cost action selection."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We propose a novel deep active inference framework that consists of a world model, an action model, and an abstract world model. The action model compresses action sequences into abstract actions using vector quantization, and the abstract world model predicts future slow states conditioned on the abstract action, enabling low-cost action selection."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_LRA.2025.3636032> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2025.3636032_SCALABILITY> .
}

