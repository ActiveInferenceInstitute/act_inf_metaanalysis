<http://activeinference.institute/nanopub/c4009ea3a834#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.09696_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper argues that patterns guide agent behavior without fully prescribing it, aligning with AIF's core idea of agents optimizing their predictions and actions to minimize surprise."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Active Inference agents achieve optimal decision-making under uncertainty"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This provides a proof of concept that pattern-capable agents can be created using now-standard software tools."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2506.09696> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.09696_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/040e1cae2318#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01357_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper argues that active inference agents can carry out epistemic exploration and account for uncertainty in a Bayes-optimal fashion, suggesting they achieve optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "by operating in a pure belief-based setting, active inference agents can carry out epistemic exploration, and account for uncertainty about their environment in a Bayes-optimal fashion."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "active inference agents can carry out epistemic exploration, and account for uncertainty about their environment in a Bayes-optimal fashion"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01357> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01357_AIF_OPTIMALITY> .
}

