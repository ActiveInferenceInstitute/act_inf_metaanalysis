<http://activeinference.institute/nanopub/fc66865f1bf6#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.04941_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The core of the model is active inference – a mechanism designed to optimize decisions under uncertainty by minimizing prediction error. The experiment directly demonstrates how attenuating priors leads to suboptimal behavior (incorrect inferences and fragmented reading)."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "attenuating the contribution of priors during the reading process leads to incorrect inferences and a more fragmented reading style, characterized by a greater number of shorter saccades"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Furthermore, our model can potentially aid in understanding how maladaptive predictive processing can produce reading deficits associated with dyslexia."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2308.04941> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.04941_AIF_OPTIMALITY> .
