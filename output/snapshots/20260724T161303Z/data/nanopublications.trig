    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.18717273_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses a geometric extension of FEP and its application to fMRI data, but doesn't directly address the universality claim itself. It focuses on refining the mathematical framework within the existing FEP paradigm."^^xsd:string ;
