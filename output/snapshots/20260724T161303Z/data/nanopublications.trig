        ns2:claim "The 'dark room' paradox highlights a potential flaw in assuming agents *always* seek optimality through prediction error minimization; a lack of input can be the most optimal state."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "the trivial solution of a dark room, where the complete lack of sensory stimuli would provide the easiest way to minimise prediction errors"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The ‘dark room’ is defined as a state that an agent would occupy should it only look to minimise this sum of prediction errors."^^xsd:string .

