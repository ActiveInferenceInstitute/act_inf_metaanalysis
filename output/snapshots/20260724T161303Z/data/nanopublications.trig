<http://activeinference.institute/nanopub/105aa5fe405e#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1606.04820_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
