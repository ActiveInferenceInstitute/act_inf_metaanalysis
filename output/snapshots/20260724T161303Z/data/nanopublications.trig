<http://activeinference.institute/nanopub/f822af2af9c8#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W2964662954_AIF_OPTIMALITY> ns2:citationCount 5 ;
        ns2:claim "The paper describes active inference as a biologically plausible algorithmic implementation of the FEP, focusing on sensorimotor loops and minimization of variational free energy. While this relates to optimal decision-making, it doesn't directly address or test optimality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "In active inference, the two of them are combined in a closed sensorimotor loopasco-dependent processes of minimisation of a single loss function, variational free energy, with respect to different sets of variables."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:sourceClaim "In active inference, the two of them are combined in a closed sensorimotor loopasco-dependent processes of minimisation of a single loss function,variational free energy, with respect to different sets of variables."^^xsd:string .

    <http://activeinference.institute/ontology/paper/openalex_https___openalex.org_W2964662954> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W2964662954_AIF_OPTIMALITY> .
}

