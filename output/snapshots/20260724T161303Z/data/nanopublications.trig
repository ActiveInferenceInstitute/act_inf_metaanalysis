<http://activeinference.institute/nanopub/3cb5596440a3#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.04084_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper's findings – decreasing VFE and increasing Bayesian surprise during perceptual inference – are consistent with the core mechanism of predictive coding: minimizing prediction errors through hierarchical processing."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "a proxy measure of integrated information and the size of the main complex followed a hill-shaped trajectory"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Network-level analyses revealed that a proxy measure of integrated information and the size of the main complex followed a hill-shaped trajectory, with informational cores organizing diverse neuronal activity."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/arxiv_2510.04084> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.04084_PREDICTIVE_CODING> .
}

