<http://activeinference.institute/nanopub/1b75c32c4fd2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2024.01.004_MARKOV_BLANKET_REALISM> ns2:citationCount 15 ;
        ns2:claim "The paper implicitly argues against the interpretation of archaeological traces as representing a linear 'ladder' of cognitive evolution, suggesting that unrecognized individual variation and chance events could disrupt this narrative, thus challenging the concept of a fixed Markov blanket."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "Such failure, as well as diverse fortuitous demographic accidents, would cause exceptional personal behavior to be ignored and hence unremembered."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Such failure, as well as diverse fortuitous demographic accidents, would cause exceptional personal behavior to be ignored and hence unremembered. It could disappear by a pitfall, down a ‘snake’, as it were, in the figurative evolutionary board game; thereby causing a discontinuity in the evolution of human behavior that presents like an evolutionary puzzle."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1016_j.plrev.2024.01.004> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2024.01.004_MARKOV_BLANKET_REALISM> .
}

