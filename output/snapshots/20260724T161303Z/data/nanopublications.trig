<http://activeinference.institute/nanopub/568470b09a60#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e24111576_FEP_UNIVERSALITY> ns2:citationCount 39 ;
        ns2:claim "The paper explicitly states that cognition is found in all living organisms, aligning with the FEP's universal application to self-organizing systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "This study approaches cognition from an info-computational stance, in which structures in nature are seen as information, and processes (information dynamics) are seen as computation, from the perspective of a cognizing agent."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Cognition is understood as a network of concurrent morphological/morphogenetic computations unfolding as a result of self-assembly, self-organization, and autopoiesis of physical, chemical, and biological agents."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e24111576> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e24111576_FEP_UNIVERSALITY> .
}

