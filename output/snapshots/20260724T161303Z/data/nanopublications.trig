        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference is a normative framework for explaining behaviour under the free energy principle—a theory of self-organisation originating in neuroscience."^^xsd:string .

