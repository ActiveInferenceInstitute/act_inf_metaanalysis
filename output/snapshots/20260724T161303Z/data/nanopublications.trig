    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_SP.2019.00065_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on privacy attacks against deep learning models, a specific computational system. While the FEP is a broad principle, this research doesn't directly address its universal applicability to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We measure the privacy leakage through parameters of fully trained models as well as the parameter updates of models during training."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We design white-box inference attacks to perform a comprehensive privacy analysis of deep learning models."^^xsd:string .
}

