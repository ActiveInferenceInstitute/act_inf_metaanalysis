<http://activeinference.institute/nanopub/34bed895d972#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2002.12636> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2002.12636_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2002.12636_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper presents active inference as an alternative to traditional RL, focusing on evidence maximization rather than reward maximization. While this suggests a broader applicability of the underlying principle, it doesn't explicitly address universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The central tenet of reinforcement learning (RL) is that agents seek to maximize the sum of cumulative rewards. In contrast, active inference, an emerging framework within cognitive and computational neuroscience, proposes that agents act to maximize the evidence for a biased generative model."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here, we illustrate how ideas from active inference can augment traditional RL approaches"^^xsd:string .
}

<http://activeinference.institute/nanopub/89e107ef9e29#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.01676_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the PML with AIF approach 'achieves performance comparable to conventional methods' and is based on minimizing prediction error – a core tenet of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "\"allowing HAVs to perform lane-keeping maneuvers...without extensive retraining\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Our approach unifies deep learning with active inference principles, allowing HAVs to perform lane-keeping maneuvers with minimal data and without extensive retraining across different environments."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2503.01676> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.01676_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/aefa7a49c9f4#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_1112.1125> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1112.1125_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_1112.1125_FEP_UNIVERSALITY> ns2:citationCount 0 ;
