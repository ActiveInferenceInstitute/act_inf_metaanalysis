<http://activeinference.institute/nanopub/11683ca5216e#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1710.09118_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:1710.09118"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T22:01:17.398426+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "We formulate the computational processes of perception in the framework of the principle of least action by postulating the theoretical action as a time integral of the free energy in the brain sciences. The free energy principle is accordingly rephrased as that for autopoietic grounds all viable organisms attempt to minimize the sensory uncertainty about the unpredictable environment over a temporal horizon. By varying the informational action, we derive the brain's recognition dynamics (RD) which conducts"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:01:17.398587+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_1710.09118> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/11683ca5216e> .
}

<http://activeinference.institute/nanopub/41de79a095a7#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2403.01977> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.01977_PREDICTIVE_CODING> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.01977_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper’s description of the Top-down Decoder and Adaptive Normalisation aligns with the core mechanism of predictive coding – minimizing prediction errors through hierarchical inference."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "By decomposing VFE into its constituent components--prediction error and Bayesian surprise–"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "By decomposing VFE into its constituent components--prediction error and Bayesian surprise--we propose a dual-mechanism architecture: a Top-down Decoder that provides an internal expectation of uncorrupted sensory input, and Adaptive Normalisation that dynamically aligns shifted feature distributions with prior beliefs."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .
}

