<http://activeinference.institute/nanopub/0bb010827548#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1523_jneurosci.0200-14.2014_PREDICTIVE_CODING> ns2:citationCount 183 ;
        ns2:claim "The core finding of the paper – a deficit in prediction error signals within a cortical hierarchy – directly supports the predictive coding mechanism."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "Patients activated a voice-sensitive region of the auditory cortex while they experienced AVHs in the scanner and displayed a concomitant deficit in prediction error signals in a similar portion of auditory cortex."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "We used model-based fMRI to study sensory prediction errors in human patients with schizophrenia who report daily auditory verbal hallucinations (AVHs) and sociodemographically matched healthy control subjects. Patients activated a voice-sensitive region of the auditory cortex while they experienced AVHs in the scanner and displayed a concomitant deficit in prediction error signals in a similar portion of auditory cortex."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1523_jneurosci.0200-14.2014> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1523_jneurosci.0200-14.2014_PREDICTIVE_CODING> .
}

