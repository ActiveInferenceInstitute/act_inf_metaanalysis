<http://activeinference.institute/nanopub/e44242752735#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2410.02972_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper frames synaptic learning as an inference problem and demonstrates how the brain minimizes 'synaptic surprisal' by organizing an optimal trajectory in neural phase space. This directly aligns with AIF’s core principle of achieving optimality under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "which variationally minimizes synaptic surprisal"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Consequently, we exemplify the synaptic plasticity in the brain with a simple model: we illustrate that the brain organizes an optimal trajectory in neural phase space during synaptic learning in continuous time, which variationally minimizes synaptic surprisal."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2410.02972> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2410.02972_AIF_OPTIMALITY> .
}

