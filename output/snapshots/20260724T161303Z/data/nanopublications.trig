<http://activeinference.institute/nanopub/266b28a6ba9d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnsys.2016.00049_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses minimizing free energy, which is a core component of Active Inference, but doesn't directly address the optimality aspect. It focuses on updating generative models based on surprise."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"Minimization of free energy implies that the implicit measure of 'surprise' experienced serves to update the generative model in a Bayesian manner.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:sourceClaim "Minimization of free energy implies that the implicit measure of 'surprise' experienced serves to update the generative model in a Bayesian manner."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnsys.2016.00049> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnsys.2016.00049_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/0ae827e87bbc#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.17450_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application (autonomous reconnaissance) and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The generative model of active inference uses Dempster-Shafer theory and a Gaussian sensor model, which provides input to the agent."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We develop an active inference route-planning method for the autonomous control of intelligent agents."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2510.17450> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.17450_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/e2c09f7d1485#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_IJCNN48605.2020.9206617_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames PID control as an active inference formulation, implying that the system is actively minimizing free energy and thus achieving optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…stochastic (optimal) control has shown remarkable results in different fields, including reinforcement learning"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…based on active inference, a theory with roots in variational Bayesian methods..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_IJCNN48605.2020.9206617> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_IJCNN48605.2020.9206617_AIF_OPTIMALITY> .
}

