    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01351_FEP_UNIVERSALITY> ns2:citationCount 117 ;
        ns2:claim "The paper focuses on a specific implementation of Active Inference (recursive free energy) and doesn't directly address the universality claim of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Active inference finesses the exploitation-exploration dilemma in relation to prior preferences by placing information gain on the same footing as reward or value."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference offers a first principle account of sentient behavior, from which special and important cases...can be derived."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01351> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01351_FEP_UNIVERSALITY> .
