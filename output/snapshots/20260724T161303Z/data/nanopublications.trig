<http://activeinference.institute/nanopub/2085154ae5e7#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2512.21129> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.21129_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.21129_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly describes how policies are selected based on expected free energy (information gain and value), aligning with the core principle of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Information gain corresponds to the KL divergence between predictive posteriors with, and without, the consequences of action."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "policies - i.e., combinations of actions - are selected based on their expected free energy, which comprises expected information gain and value."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

<http://activeinference.institute/nanopub/fe4da3ce9359#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1109_icra48891.2023.10160593> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_icra48891.2023.10160593_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_icra48891.2023.10160593_AIF_OPTIMALITY> ns2:citationCount 13 ;
        ns2:claim "The paper demonstrates that active inference achieves superior cumulative regret compared to other strategies in a CMAB simulation, suggesting it's an optimal action selection strategy."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "...generally achieves superior cumulative regret"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "…active inference generally requires far fewer iterations to identify optimal options and generally achieves superior cumulative regret..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

