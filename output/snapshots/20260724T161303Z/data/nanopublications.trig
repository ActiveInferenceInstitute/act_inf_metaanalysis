<http://activeinference.institute/nanopub/de8cb06b58a7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2021.3090015_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper describes a specific application of the FEP (active inference) in robotic interaction, focusing on dynamics rather than asserting universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"The model is based on the free energy principle such that a pair of interacting robots find themselves in a loop, attempting to predict and infer each other's actions using active inference.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We examine dyadic imitative interactions of robots using a variational recurrent neural network model based on the free energy principle."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1109_LRA.2021.3090015> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2021.3090015_FEP_UNIVERSALITY> .
}

