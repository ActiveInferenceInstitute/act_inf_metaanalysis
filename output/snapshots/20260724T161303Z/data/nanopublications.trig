<http://activeinference.institute/nanopub/5e146ef6b9fe#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.02447_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific optimization problem within neural networks and doesn't directly address the universal applicability of the FEP to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The incorporation of the priors into the optimization not only helped to tackle errors in the reference labels but also allowed to reduce classification biases towards the dominant classes by focusing the attention of the neural network on important but minority foreground classes."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This was achieved by proposing a novel algorithm to find candidate classification labels of the training samples from their prior probabilities and the currently estimated posteriors on the network and a novel objective function for the optimizations."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2306.02447> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.02447_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/9be0b8e18925#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2024.01.004_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.1016/j.plrev.2024.01.004"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T23:20:25.408038+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "We propose a parsimonious account that (1) could explain a particular, frequently-encountered, archeological outcome of behavior in early Homo - namely, the fashioning of a Paleolithic stone 'handaxe' - from a biological theoretic perspective informed by the free energy principle (FEP); and that (2) regards instances of the outcome as postdictive or retrodictive, circumstantial corroboration."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T23:20:25.408484+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1016_j.plrev.2024.01.004> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/9be0b8e18925> .
}

<http://activeinference.institute/nanopub/443c9ebfe3b6#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2109.04139_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly describes the robot inferring actions to minimize prediction error, aligning with the core principle of Active Inference – agents optimizing their states by minimizing surprise."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Furthermore, conversely to standard Bayesian estimation approaches our method also enables the robot to navigate when providing the desired goal by inferring the actions that minimize the prediction error."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Furthermore, conversely to standard Bayesian estimation approaches our method also enables the robot to navigate when providing the desired goal by inferring the actions that minimize the prediction error."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2109.04139> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2109.04139_AIF_OPTIMALITY> .
}

