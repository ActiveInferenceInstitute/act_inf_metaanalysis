        ns2:sourceClaim "This particular state factorisation facilitates the ability to not just discover tools but invent them through the offline induction of an appropriate tool property."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

