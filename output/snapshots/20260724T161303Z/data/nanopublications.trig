        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This model unifies mapping, localisation, and decision-making within a single generative model."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2510.09574> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.09574_FEP_UNIVERSALITY> .
