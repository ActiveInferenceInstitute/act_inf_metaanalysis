        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We develop this argument from first principles, following a chain from probability theory through Bayesian machine learning and variational inference to active inference and reactive message passing."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/arxiv_2603.20927> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.20927_FEP_UNIVERSALITY> .
