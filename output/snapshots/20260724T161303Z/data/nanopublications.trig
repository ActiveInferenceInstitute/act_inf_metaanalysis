<http://activeinference.institute/nanopub/99f91274b06f#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fncir.2024.1283372> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncir.2024.1283372_PREDICTIVE_CODING> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncir.2024.1283372_PREDICTIVE_CODING> ns2:citationCount 10 ;
        ns2:claim "The paper describes a generative model that predicts sensory input and minimizes prediction error, which is consistent with predictive coding but doesn't delve into the hierarchical aspects."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Active inference (AIF) is a theory of the behavior of information-processing open dynamic systems...GMs generate predictions about sensory input"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/predictive_coding> ;
        ns2:sourceClaim "Active inference (AIF) is a theory of the behavior of information-processing open dynamic systems. It describes them as generative models (GM) generating inferences on the causes of sensory input they receive from their environment. Based on these inferences, GMs generate predictions about sensory input."^^xsd:string .
}

