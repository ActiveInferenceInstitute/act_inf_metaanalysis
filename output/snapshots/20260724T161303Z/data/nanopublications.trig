<http://activeinference.institute/nanopub/9083f44eea81#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2106.15844> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.15844_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.15844_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses a hierarchical representation of games based on the Free Energy Principle but doesn't explicitly state that FEP universality applies to all self-organizing systems. It focuses on game theory and decision-making."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This representation enables us to treat simultaneous games in a similar manner to sequential games, where reasoning resources deplete throughout the game-tree."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This representation enables us to treat simultaneous games in a similar manner to sequential games, where reasoning resources deplete throughout the game-tree."^^xsd:string .
}

<http://activeinference.institute/nanopub/ba5cf4ba264c#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2201.06387> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2201.06387_MARKOV_BLANKET_REALISM> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2201.06387_MARKOV_BLANKET_REALISM> ns2:citationCount 9 ;
        ns2:claim "The paper’s focus on conditional independencies and Bayesian partitionings implicitly challenges the notion of Markov blankets as representing real physical boundaries."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "establishing a particular partition of states based upon conditional independencies that inherit from sparsely coupled dynamics"^^xsd:string .
}

<http://activeinference.institute/nanopub/c994b95128d7#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2022.789377> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2022.789377_CLINICAL_UTILITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2022.789377_CLINICAL_UTILITY> ns2:citationCount 265 ;
        ns2:claim "The paper directly translates theoretical frameworks into clinical suggestions for MSK pain treatment, aligning with the goal of clinically useful models."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Precisely, it is argued that different strategies should be implemented when treating MSK pain patients, depending on the nature of their expectations (i.e., positive or negative and the level of their precision)."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Precisely, it is argued that different strategies should be implemented when treating MSK pain patients, depending on the nature of their expectations (i.e., positive or negative and the level of their precision)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/clinical_utility> .
}

