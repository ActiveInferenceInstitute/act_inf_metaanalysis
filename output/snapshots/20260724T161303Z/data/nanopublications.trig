        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Friston elaborated how there were ways of making an optimal decision using active inference that can offer perspectives to advances in artificial intelligence."^^xsd:string .
}

