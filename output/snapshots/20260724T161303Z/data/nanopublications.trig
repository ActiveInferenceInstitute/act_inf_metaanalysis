    <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.04034_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses the Free Energy Principle broadly but doesn't directly test its universality across all systems. It focuses on AIED and embodied learning."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "grounded in embodied, embedded, enactive, and extended (4E) cognition, active inference and dual coding theory that shifts AIED’s guiding metaphor from instruction to sensemaking."^^xsd:string ;
