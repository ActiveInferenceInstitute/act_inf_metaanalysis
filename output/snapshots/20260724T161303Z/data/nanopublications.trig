<http://activeinference.institute/nanopub/e55cd14bf372#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.14460_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper's focus on constrained prior preferences in one setting suggests that AIF doesn’t necessarily lead to optimal decision-making due to limitations imposed by the generative model."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "Indeed, only a limited class of prior preferences over observations is compatible with the likelihood mapping of the generative model."^^xsd:string ;
