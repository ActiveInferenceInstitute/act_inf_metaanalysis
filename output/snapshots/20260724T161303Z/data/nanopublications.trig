<http://activeinference.institute/nanopub/99568ee1374f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e25070964_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The paper argues for populations of 'natural kinds' influencing each other, suggesting that Markov blankets (representing boundaries) are not necessarily corresponding to real physical boundaries."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "It is not possible to describe or model a population of conspecifics per se. Rather, it is necessary to consider populations - and nested meta-populations - of different natural kinds that influence each other."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "It is not possible to describe or model a population of conspecifics per se. Rather, it is necessary to consider populations - and nested meta-populations - of different natural kinds that influence each other."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e25070964> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e25070964_MARKOV_BLANKET_REALISM> .
}

<http://activeinference.institute/nanopub/8e1b66c81585#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsos.241655_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses how different utilities (including those related to active inference) shape collective behavior, but doesn't definitively state that Active Inference *achieves* optimality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "In particular, thermodynamic efficiency -- measuring the ratio of predictability gained by the system to its energy costs -- reaches its maximum at the critical regime."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:sourceClaim "By interpreting the Ising model as a perception-action loop, we compare how different intrinsic utilities shape collective behaviour and analyse the distinct characteristics that arise when each is optimised."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1098_rsos.241655> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsos.241655_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/ea6609ae402c#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2407.21051_LANGUAGE_AIF> ns2:citationCount 0 ;
        ns2:claim "The paper proposes an active inference-based prompting protocol for LLMs, suggesting a viable framework for language processing within the AIF paradigm."^^xsd:string ;
        ns2:confidence 8.5e-01 ;
        ns2:evidenceQuote "We introduce an actor-critic LLM prompting protocol based on active inference principles of human cognition..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We introduce an actor-critic LLM prompting protocol based on active inference principles of human cognition, where a Therapist agent initially responds to patient queries, and a Supervisor agent evaluates and adjusts responses to ensure accuracy and reliability."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/language_aif> .

    <http://activeinference.institute/ontology/paper/arxiv_2407.21051> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2407.21051_LANGUAGE_AIF> .
}

<http://activeinference.institute/nanopub/086e2e26671b#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2602.15050> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.15050_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.15050_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses convergence between different frameworks (Smolin, Friston, psychology) but doesn't explicitly state or test the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceStatus "no_evidence"^^xsd:string ;
        ns2:evidenceType "none"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Although formulated within different domains -- physics, biology, and psychology -- all three frameworks, in one form or another, appeal to processes of transition from uncertainty to certainty..."^^xsd:string .
}

<http://activeinference.institute/nanopub/fdf30b364fa5#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.01792_FEP_UNIVERSALITY> ns2:citationCount 345 ;
        ns2:claim "The paper discusses predictive coding as a general mechanism for perception but doesn't explicitly address the universality of the Free Energy Principle itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This simple conception, the hierarchical exchange of prediction and prediction error, confronts a rich cortical microcircuitry that is yet to be fully documented."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Predictive coding theories interpret the hierarchical construction of the cerebral cortex as a Bayesian, generative model capable of predicting the sensory data consistent with any given percept."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2016.01792> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.01792_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/e821b1b6c14a#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.1911.02362_PREDICTIVE_CODING> ns2:citationCount 9 ;
        ns2:claim "The paper explicitly states that predictive coding implements analogical reasoning and is a core cognitive process."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "\"Here in the spirit of the work of George Lakoff and Mark Johnson, I propose that embodiment provides many of the inductive biases that are usually described in terms of innate core knowledge\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "However, both Bayesian cognitive science and models of cognitive development via analogical reasoning require rich base domains and priors (or reliably learnable posteriors) from which they can commence the process of bootstrapping minds. Here in the spirit of the work of George Lakoff and Mark Johnson, I propose that embodiment provides many of the inductive biases that are usually described in terms of innate core knowledge."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

