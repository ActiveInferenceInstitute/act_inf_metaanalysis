    <http://activeinference.institute/ontology/assertion/llm_arxiv_2509.12754_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly describes ActOwL as a framework that enables robots to *actively* generate questions to maximize information gain – this aligns directly with the core principle of Active Inference: agents optimize their predictions and actions by minimizing surprise (prediction error) through active exploration."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "By leveraging commonsense knowledge from Large Language Models (LLM), objects are pre-classified as either shared or owned, and only owned objects are targeted for questioning."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "ActOwL employs a probabilistic generative model to select questions that maximize information gain, thereby acquiring ownership knowledge efficiently."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2509.12754> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2509.12754_AIF_OPTIMALITY> .
}

