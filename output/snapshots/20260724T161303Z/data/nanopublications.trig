<http://activeinference.institute/nanopub/f6f33a07fd84#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2025.1438080_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper proposes a model where epistemic emotions (curiosity/interest) drive an ‘ideal inquiry cycle’ to minimize free energy and achieve optimal arousal – aligning with the core tenets of Active Inference regarding optimizing predictions under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The results show that greater prediction uncertainty, meaning an open-minded attitude, and less observational uncertainty, meaning precise observation with attention, are expected to provide greater information gains through a greater range of exploration."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "We exhaustively analyzed the effects of prediction uncertainty (prior variance) and observation uncertainty (likelihood variance) on the peaks of the information gain function as optimal surprises."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2025.1438080> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2025.1438080_AIF_OPTIMALITY> .
}

