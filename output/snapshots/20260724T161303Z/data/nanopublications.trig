<http://activeinference.institute/nanopub/973bd5a253ec#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2110.10083> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2110.10083_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2110.10083_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that contrastive AIF achieves performance comparable to reinforcement learning agents with human-designed rewards, suggesting it can achieve optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…closely matches their performance"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Our method performs notably better than likelihood-based active inference in image-based tasks, while also being computationally cheaper and easier to train. We compare to reinforcement learning agents that have access to human-designed reward functions, showing that our approach closely matches their performance."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

