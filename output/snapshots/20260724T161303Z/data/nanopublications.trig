<http://activeinference.institute/nanopub/8b958eae74b7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10339-013-0571-3_AIF_OPTIMALITY> ns2:citationCount 515 ;
        ns2:claim "The paper explicitly frames active inference as minimizing prediction error and achieving 'Bayes optimal behaviour', directly supporting the idea of optimality within the AIF framework."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…minimising prediction error: we can either change our predictions to explain sensory input through perception. Alternatively, we can actively change sensory input to fulfil our predictions."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This can be seen most easily as minimising prediction error: we can either change our predictions to explain sensory input through perception. Alternatively, we can actively change sensory input to fulfil our predictions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s10339-013-0571-3> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10339-013-0571-3_AIF_OPTIMALITY> .
}

