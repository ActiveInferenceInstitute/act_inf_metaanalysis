        ns2:claim "The paper's controller is explicitly designed to minimize expected free energy, which aligns with the core principle of Active Inference – agents actively seek information to reduce their uncertainty and thus optimize their actions."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "...and contains information-theoretic terms expressing uncertainty over model parameters and output predictions."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The controller's objective function is derived from an expected free energy functional..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2312.15046> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2312.15046_AIF_OPTIMALITY> .
