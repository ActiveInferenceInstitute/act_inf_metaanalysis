<http://activeinference.institute/nanopub/a80fa0119884#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.jmp.2020.102447_PREDICTIVE_CODING> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.1016/j.jmp.2020.102447"^^xsd:string ;
