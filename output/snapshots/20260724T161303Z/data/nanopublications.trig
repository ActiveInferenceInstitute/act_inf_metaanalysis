        ns2:claim "The paper describes a system (CC devices) that achieves optimal performance (SLO compliance, load balancing) through active inference – minimizing prediction errors and adapting to constraints."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "underlying causal structures were also rationally explainable"^^xsd:string ;
