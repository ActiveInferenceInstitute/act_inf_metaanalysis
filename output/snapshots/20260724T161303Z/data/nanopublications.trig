<http://activeinference.institute/nanopub/6819c155981f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2103.12649_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on synaptic interactions and doesn't provide a framework for Markov blankets as boundaries of reality; it suggests internal models drive behavior."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "The parameters of the learning rules are fully determined by the parameters of the post-synaptic neuron model, suggesting a close interplay between the synaptic and somatic compartment"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "By focusing on an experimentally well understood biological system we are able to derive learning rules from first principles while keeping assumptions minimal."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2103.12649> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2103.12649_MARKOV_BLANKET_REALISM> .
}

