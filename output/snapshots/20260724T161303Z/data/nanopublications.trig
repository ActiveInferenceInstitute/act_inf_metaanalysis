<http://activeinference.institute/nanopub/89f78f24d1a3#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1093_nc_niab038_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
