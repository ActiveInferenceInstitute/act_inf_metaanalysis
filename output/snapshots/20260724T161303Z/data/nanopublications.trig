<http://activeinference.institute/nanopub/673b7b08b21f#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fnhum.2016.00550> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2016.00550_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2016.00550_AIF_OPTIMALITY> ns2:citationCount 449 ;
        ns2:claim "The paper argues that the observed fatigue and depression are not necessarily *optimal* responses driven by Active Inference but rather arise from a metacognitive misinterpretation of dyshomeostasis leading to reduced self-efficacy."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "…generalized belief of low self-efficacy and lack of control (cf. learned helplessness)…"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In this framework, fatigue might represent an early response with adaptive value (cf. sickness behavior), the experience of chronic dyshomeostasis may trigger a generalized belief of low self-efficacy and lack of control (cf. learned helplessness)…"^^xsd:string .
}

<http://activeinference.institute/nanopub/19b437032be1#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2016.00550_FEP_UNIVERSALITY> ns2:citationCount 449 ;
        ns2:claim "The paper focuses on a specific instantiation of the FEP – interoception and allostasis – within the context of fatigue and depression. While broadly applicable, it doesn't directly address the universal claim."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…low evidence for the brain’s model of bodily states…"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Specifically, viewing interoception as the inversion of a generative model of viscerosensory inputs allows for a formal definition of dyshomeostasis (as chronically enhanced surprise about bodily signals, or, equivalently, low evidence for the brain's model of bodily states) and allostasis (as a change in prior beliefs or predictions which define setpoints for homeostatic reflex arcs)."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnhum.2016.00550> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2016.00550_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/8029c28feb59#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2502.04249> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.04249_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.04249_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper frames FEP as a foundational principle for risk measurement across agentic systems, suggesting broad applicability but doesn't explicitly test universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This framework naturally accounts for uncertainty in both world model and preference model, allowing for decision-making that is epistemically and axiologically humble, parsimonious, and future-proof."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We investigate the Free Energy Principle as a foundation for measuring risk in agentic and multi-agent systems."^^xsd:string .
}

