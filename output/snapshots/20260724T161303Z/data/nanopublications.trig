<http://activeinference.institute/nanopub/c98bebea785c#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.20936_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates robust cooperation in the Iterated Prisoner's Dilemma through empathic perspective-taking, suggesting an agent achieving a desirable outcome (cooperation) via Active Inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Cooperation emerges only when empathy is reciprocated, while asymmetric empathy leads to systematic exploitation."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "We show that empathic perspective-taking induces robust cooperation without explicit communication or reward shaping."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2602.20936> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.20936_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/0c44035445df#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01514_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:2303.01514"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T17:11:04.491967+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "Living systems face both environmental complexity and limited access to free-energy resources. Survival under these conditions requires a control system that can activate, or deploy, available perception and action resources in a context specific way. We show here that when systems are described as executing active inference driven by the free-energy principle (and hence can be considered Bayesian prediction-error minimizers), their control flow systems can always be represented as tensor networks (TNs). We"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T17:11:04.492296+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_2303.01514> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/0c44035445df> .
}

<http://activeinference.institute/nanopub/0569fd8d5dfc#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_4qkjp_AIF_OPTIMALITY> ns2:citationCount 2 ;
        ns2:claim "The paper frames intelligence within Active Inference, which inherently posits that agents strive to minimize surprise (prediction error) and thus achieve optimal decision-making."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Intelligence may be understood as capacities for compressing (and thereby predicting) data and achieving goals via programs with minimal algorithmic complexity."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Intelligence may be understood as capacities for compressing (and thereby predicting) data and achieving goals via programs with minimal algorithmic complexity."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_4qkjp> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_4qkjp_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/611f6dfe6832#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_s00422-024-01001-1> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-024-01001-1_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-024-01001-1_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that the projective group leads to behaviors (approach) that are not necessarily optimal in terms of minimizing prediction error or maximizing epistemic value; instead, it's driven by a specific geometric distortion."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "The projective group's nonlinear magnification of information transformed epistemic value according to the choice of frame, generating behaviors of approach toward an object of interest."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "The projective group's nonlinear magnification of information transformed epistemic value according to the choice of frame, generating behaviors of approach toward an object of interest."^^xsd:string .
}

