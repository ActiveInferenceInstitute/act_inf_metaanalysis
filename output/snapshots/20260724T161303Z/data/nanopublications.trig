<http://activeinference.institute/nanopub/2bf1f01b6dfb#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.65649_93qfwv21_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
