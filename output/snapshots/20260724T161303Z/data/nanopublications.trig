        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "user behaviour is modeled as Bayesian inference on progress and goal distributions that predicts the next action"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2502.05935> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.05935_AIF_OPTIMALITY> .
