<http://activeinference.institute/nanopub/38b9e326d387#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2023.11.004_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
