<http://activeinference.institute/nanopub/92b6951c6cd2#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2006.04120> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2006.04120_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2006.04120_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper describes a sophisticated form of Active Inference that uses recursive free energy and effectively implements a deep tree search over actions and outcomes in the future, aligning with the goal of optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In brief, active inference replaces value functions with functionals of (Bayesian) beliefs..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In brief, active inference replaces value functions with functionals of (Bayesian) beliefs, in the form of an expected (variational) free energy."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

