        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The architecture pairs volitional photography with immediate voice reflection, constrains AI to Socratic provocation rather than answer delivery, and applies Epistemic Trajectory Modeling (ETM) to represent field learning as a continuous trajectory through conjoined physical-epistemic space."^^xsd:string .
}

