    <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.00140_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses applications of the FEP across machine learning and neuroscience, but doesn't explicitly state or argue for universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "A core postulate of the theory is that complex systems can be seen as performing variational Bayesian inference and minimizing an information-theoretic quantity called the variational free energy."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The free energy principle is a general mathematical theory of the necessary information-theoretic behaviours of systems that maintain a separation from their environment."^^xsd:string .
}

