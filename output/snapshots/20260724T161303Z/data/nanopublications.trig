<http://activeinference.institute/nanopub/2843bf6e400f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_icra48891.2023.10160593_FEP_UNIVERSALITY> ns2:citationCount 13 ;
        ns2:claim "The paper focuses on a specific application (CMABs) and doesn't broadly address the universality of the FEP across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…as derived from the free-energy principle."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
