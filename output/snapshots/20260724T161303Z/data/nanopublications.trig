        ns2:evidenceQuote "capable of directly integrating over 30,000-dimensional visuo-proprioceptive inputs without dimensionality reduction"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
