<http://activeinference.institute/nanopub/ab8a0275f645#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2106.04316> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.04316_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.04316_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific learning mechanism within the FEP and its application to simulated environments. While it demonstrates a functional trade-off, it doesn't directly address the broader claim of universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Given a constant environment, these agents learn confident (i.e., precise) preferences and act to satisfy them. Conversely, in a volatile setting, perpetual preference uncertainty maintains exploratory behaviour."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our approach enables the agent to learn preferences that encourage adaptive behaviour at test time."^^xsd:string .
}

<http://activeinference.institute/nanopub/a7e65ee749ca#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_s10915-022-01939-z> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10915-022-01939-z_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10915-022-01939-z_FEP_UNIVERSALITY> ns2:citationCount 2082 ;
        ns2:claim "The paper discusses PINNs as a multi-task learning framework and their application across various PDEs, but doesn't directly address the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This novel methodology has arisen as a multi-task learning framework in which a NN must fit observed data while reducing a PDE residual."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "PINNs are neural networks that encode model equations like Partial Differential Equations (PDEs)."^^xsd:string .
}

<http://activeinference.institute/nanopub/02777039117d#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2308.08307> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.08307_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.08307_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper directly compares an active inference agent to a naive clone graph agent and finds the active inference agent more effective in challenging scenarios, suggesting it achieves better decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "the active inference agent is more effective when planning in challenging scenarios, in which sensory observations provide ambiguous information about location."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "the active inference agent is more effective when planning in challenging scenarios, in which sensory observations provide ambiguous information about location."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

