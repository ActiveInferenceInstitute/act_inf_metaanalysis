<http://activeinference.institute/nanopub/62552aafee9b#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.5194_egusphere-egu21-15347_MARKOV_BLANKET_REALISM> ns2:citationCount 1 ;
        ns2:claim "The paper explicitly uses the concept of a Markov blanket to explain the Earth system's dynamics and relates it to statistical boundaries."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "This Markov blanket...amounts to describing the dynamics of the internal states as actively inferring external states."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Our formalization rests on how the metabolic rates of the biosphere (i.e., internal states) relate vicariously to solar radiation at the Earth’s surface (i.e., external states), through the changes in greenhouse and albedo effects (i.e. active states) and ocean-driven global temperature changes (i.e. sensory states)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> .

    <http://activeinference.institute/ontology/paper/doi_10.5194_egusphere-egu21-15347> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5194_egusphere-egu21-15347_MARKOV_BLANKET_REALISM> .
}

