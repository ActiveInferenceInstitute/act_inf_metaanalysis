<http://activeinference.institute/nanopub/a4f020965d1f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.14033_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly demonstrates BRAIN’s superior adaptability and robust causal reasoning compared to DRL benchmarks, suggesting it achieves better decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8.5e-01 ;
        ns2:evidenceQuote "BRAIN exhibits (i) robust causal reasoning... (ii) superior adaptability with up to 28.3% higher robustness..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "BRAIN exhibits (i) robust causal reasoning for dynamic radio resource allocation, maintaining slice-specific quality of service (QoS) targets (throughput, latency, reliability) under varying traffic loads, (ii) superior adaptability with up to 28.3% higher robustness to sudden traffic shifts versus benchmarks (achieved without any retraining),"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2602.14033> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.14033_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/2d8a0849d4ac#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1017_s0140525x22000206> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0140525x22000206_MARKOV_BLANKET_REALISM> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0140525x22000206_MARKOV_BLANKET_REALISM> ns2:citationCount 1 ;
        ns2:claim "The paper argues against the blanket being an *active* generator of boundaries, implying it's not a 'real' physical boundary in the sense of actively defining itself."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "\"...biological and cognitive agents actively generate their own boundaries...\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The gap between the Markov blanket and ontological boundaries arises from the former's inability to capture the dynamic process through which biological and cognitive agents actively generate their own boundaries with the environment."^^xsd:string .
}

