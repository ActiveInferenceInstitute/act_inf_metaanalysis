<http://activeinference.institute/nanopub/c8bd44145999#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2204.00032> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2204.00032_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2204.00032_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper describes a deliberate manipulation of training data to extract private information – this directly contradicts the notion that Active Inference agents always achieve optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "targeted attacks can poison <0.1% of the training dataset to boost the performance of inference attacks by 1 to 2 orders of magnitude."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "an adversary who can poison a training dataset can cause models trained on this dataset to leak significant private details of training points belonging to other parties."^^xsd:string .
}

