<http://activeinference.institute/nanopub/15917434df22#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_4qkjp> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_4qkjp_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_4qkjp_FEP_UNIVERSALITY> ns2:citationCount 2 ;
        ns2:claim "The paper explicitly connects the FEP to self-organizing systems, suggesting a fundamental role in intelligence and potentially consciousness across diverse systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Within the Free Energy Principle and Active Inference framework, intelligence may be understood as capacity for inference and learning of predictive models for goal-realization, with beliefs favored to the extent they fit novel data with minimal updating of priors."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Intelligence may be understood as capacity for inference and learning of predictive models for goal-realization, with beliefs favored to the extent they fit novel data with minimal updating of priors."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .
}

