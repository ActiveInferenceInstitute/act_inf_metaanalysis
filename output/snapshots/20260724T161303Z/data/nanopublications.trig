    <http://activeinference.institute/ontology/assertion/llm_arxiv_2601.18946_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper's core mechanism – schema-based hierarchical active inference – is fundamentally rooted in predictive coding and the minimization of prediction errors."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "…combines predictive processing and active inference with schema-based mechanisms."^^xsd:string ;
