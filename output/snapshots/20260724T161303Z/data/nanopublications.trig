<http://activeinference.institute/nanopub/36ae2d052592#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2109.04155_SCALABILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
