<http://activeinference.institute/nanopub/a4beebeabe39#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "AXIOM's ability to master games in 10,000 steps with a small number of parameters demonstrates scalability – the model can handle complex environments efficiently."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "AXIOM masters various games within only 10,000 interaction steps, with both a small number of parameters compared to DRL, and without the computational expense of gradient-based optimization."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "AXIOM masters various games within only 10,000 interaction steps, with both a small number of parameters compared to DRL, and without the computational expense of gradient-based optimization."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2505.24784> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_SCALABILITY> .
}

<http://activeinference.institute/nanopub/e5d1d883a9d4#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2511.19334> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.19334_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.19334_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses AIF as a general framework for understanding AI behavior under legal constraints, but doesn't explicitly state or prove the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We propose that lawful and norm-sensitive AI behavior can be achieved through regulation by design, where agents are endowed with intentional control systems, or behavioral safety valves that guide real-time decisions in accordance with normative expectations."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The ensuing model aims to capture the complexity of human decision-making under legal constraints, offering a candidate mechanism for agent governance in AI systems."^^xsd:string .
}

