        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "\"Markov blankets are not guaranteed to follow from sparse coupling.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The authors demonstrate that in general, Markov blankets are not guaranteed to follow from sparse coupling."^^xsd:string .

