<http://activeinference.institute/nanopub/47118e57a1bb#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1371_journal.pcbi.1012973> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1012973_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1012973_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses the FEP's application to embodied cognition but doesn’t explicitly state it applies universally."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"Leveraging foundational concepts from evolutionary theory, neuronal packets, and free energy principle, we propose a hierarchical model of cognitive states...\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This paper introduces the 'thoughtseed' framework, proposing that cognition arises from the dynamic interaction of self-organizing units of embodied knowledge called \"thoughtseeds\" within the Global Workspace."^^xsd:string .
}

