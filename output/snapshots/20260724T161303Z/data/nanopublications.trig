<http://activeinference.institute/nanopub/1f28519c830d#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2022.11.001_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.1016/j.plrev.2022.11.001"^^xsd:string ;
