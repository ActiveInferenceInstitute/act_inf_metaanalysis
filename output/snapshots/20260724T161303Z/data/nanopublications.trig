<http://activeinference.institute/nanopub/3858f285f5cb#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2403.16104> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.16104_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.16104_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on rigorous statistical mechanics and doesn't directly address the universality of the FEP across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We showed that statistical systems are particular representations of partially ordered sets (posets), that we call A-specifications, and expressed their phases, i.e., Gibbs measures, as invariants of these representations."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Rigorous Statistical Mechanics is centered on the mathematical study of statistical systems."^^xsd:string .
}

