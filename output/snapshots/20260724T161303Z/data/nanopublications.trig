        ns2:sourceClaim "Active inference addresses these challenges by minimizing prediction error (termed \"surprise\") through a dynamic model that balances perception and action."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

