    <http://activeinference.institute/ontology/assertion/llm_arxiv_2208.10601_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper's core contribution is a formulation of active inference that aims to achieve optimal decision-making by minimizing average sensory surprise over time – a direct reflection of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Our formulation provides a unified objective functional for sensorimotor control and allows for reference states to vary over time."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Active inference offers a principled account of behavior as minimizing average sensory surprise over time."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2208.10601> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2208.10601_AIF_OPTIMALITY> .
