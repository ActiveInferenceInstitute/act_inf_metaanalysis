<http://activeinference.institute/nanopub/984237e06015#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_1903.02610> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1903.02610_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_1903.02610_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application (neural population data) and doesn't directly address the broad claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Unlike Gaussian processes, Deep Random Splines allow us to readily enforce shape constraints while inheriting the richness and tractability of deep generative models."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We propose Deep Random Splines, a flexible class of random functions obtained by transforming Gaussian noise through a deep neural network whose output are the parameters of a spline."^^xsd:string .
}

<http://activeinference.institute/nanopub/7f11b7b8bfe4#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2024.1498160_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific computational model mimicking animal navigation, aligning with the FEP's broader principle of self-organization but doesn’t directly test universality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "incorporating a dynamically expanding cognitive map over predicted poses within an Active Inference framework"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
