<http://activeinference.institute/nanopub/ce5cebc18122#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_17588928.2015.1020053_AIF_OPTIMALITY> ns2:citationCount 724 ;
        ns2:claim "The paper directly links minimizing expected free energy to maximizing extrinsic value and information gain, aligning with the core concept of optimal decision-making in Active Inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Maximizing information gain or intrinsic value (or reducing uncertainty about the causes of valuable outcomes)."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Minimizing expected free energy is therefore equivalent to maximizing extrinsic value or expected utility (defined in terms of prior preferences or goals), while maximizing information gain or intrinsic value (or reducing uncertainty about the causes of valuable outcomes)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1080_17588928.2015.1020053> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_17588928.2015.1020053_AIF_OPTIMALITY> .
}

