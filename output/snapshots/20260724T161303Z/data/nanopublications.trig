    <http://activeinference.institute/ontology/assertion/llm_doi_10.1177_1059712319862774_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
