<http://activeinference.institute/nanopub/a5c7d36c3362#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3390_e26060518> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e26060518_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e26060518_FEP_UNIVERSALITY> ns2:citationCount 4 ;
        ns2:claim "The paper discusses the universal nature of wishful thinking within the FEP but doesn't directly test or support the claim that it applies universally to *all* self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This elucidates an optimism bias as a foundational tenet of self-evidencing."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
