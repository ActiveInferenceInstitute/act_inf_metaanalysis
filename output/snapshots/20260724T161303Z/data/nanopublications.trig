<http://activeinference.institute/nanopub/255d1d18808f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1704.00766_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific anomaly detection problem within heterogeneous processes and doesn't directly address the broad claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The paper references Chernoff's work on sequential design of experiments, implying a foundational theoretical framework."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This problem falls into the general setting of sequential design of experiments pioneered by Chernoff in 1959, in which a randomized strategy, referred to as the Chernoff test, was proposed and shown to be asymptotically optimal as the error probability approaches zero."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_1704.00766> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1704.00766_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/7ced6a089492#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1101_2021.02.02.429272_AIF_OPTIMALITY> ns2:citationCount 1 ;
        ns2:claim "The paper directly states that active inference can be used to optimize BCI decision-making criteria based on Friston's free energy principle, aligning with the core tenet of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "BCIs can expand their framework of optimal decision-making using active inference."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Under Friston’s free energy principle, we can optimize the criterion a BCI uses to infer the intentions of the user from EEG observations."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1101_2021.02.02.429272> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1101_2021.02.02.429272_AIF_OPTIMALITY> .
}

