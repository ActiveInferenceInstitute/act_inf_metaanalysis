        ns2:prov_source_passage "The neurobiological understanding of mood, and by extension mood disorders, remains elusive despite decades of research implicating several neuromodulator systems. This review considers a new approach based on existing theories of functional brain organisation. The free energy principle (a.k.a. active inference), and its instantiation in the Bayesian brain, offers a complete and simple formulation of mood. It has been proposed that emotions reflect the precision of - or certainty about - the predicted senso"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:42:00.997315+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1017_s0033291718000430> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/f1483f92395d> .
}

