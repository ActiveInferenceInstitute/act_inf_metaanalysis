<http://activeinference.institute/nanopub/925635fee260#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2010.00262_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
