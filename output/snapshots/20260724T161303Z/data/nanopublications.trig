<http://activeinference.institute/nanopub/4be4af1670d7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.00925_PREDICTIVE_CODING> ns2:citationCount 53 ;
        ns2:claim "The paper explicitly integrates predictive coding as a core component of the unified theory, describing how it minimizes prediction errors through hierarchical encoding and adaptation."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In the light of such a potential unification, it is discussed how abstract cognitive, conceptualized knowledge and understanding may be learned from actively gathered sensorimotor experiences. The unification rests on the free energy-based inference principle, which essentially implies that the brain builds a predictive, generative model of its environment."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In the light of such a potential unification, it is discussed how abstract cognitive, conceptualized knowledge and understanding may be learned from actively gathered sensorimotor experiences. The unification rests on the free energy-based inference principle, which essentially implies that the brain builds a predictive, generative model of its environment."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2016.00925> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.00925_PREDICTIVE_CODING> .
}

