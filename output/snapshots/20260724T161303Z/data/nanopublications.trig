        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We then present an approach to the recognition and learning based on thermodynamics, showing that adaptation by causal learning results in the second law of thermodynamics whereas inference dynamics that fuses observation with prior knowledge forms a thermodynamic process. These provide a unified view on the adaptation of organisms to the environment."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/arxiv_1902.11233> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1902.11233_FEP_UNIVERSALITY> .
}

