<http://activeinference.institute/nanopub/a579186fa8b5#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01618_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that agents maximizing reward successfully solve the dSprites environment, implying optimal decision-making under uncertainty as a consequence of this reward maximization strategy."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Finally, we compare the similarity of the representation learned by the layers of various agents using centered kernel alignment. Importantly, the agent maximising reward and the agent minimising expected free energy learn very similar representations except for the last layer of the critic network (reflecting the difference in learning objective)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "the models able to solve the dSprites environment are the ones that maximise rewards"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2303.01618> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01618_AIF_OPTIMALITY> .
}

