<http://activeinference.institute/nanopub/6a219a4aaf9f#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.23258_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
