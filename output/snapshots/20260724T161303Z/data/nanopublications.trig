<http://activeinference.institute/nanopub/e92982c72036#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_s00422-012-0512-8> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-012-0512-8_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-012-0512-8_FEP_UNIVERSALITY> ns2:citationCount 247 ;
        ns2:claim "The paper focuses on decision-making problems within a specific framework (Markov decision problems) and doesn't directly address the universality of the FEP across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "In active inference, both action and posterior beliefs about hidden states minimise a free energy bound on the negative log-likelihood of observed states, under a generative model."^^xsd:string ;
