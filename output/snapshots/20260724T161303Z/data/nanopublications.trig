    <http://activeinference.institute/ontology/assertion/llm_arxiv_2203.12652_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper’s core argument – that attention is about minimizing uncertainty and precision control – directly aligns with the AIF goal of optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "...and salience with uncertainty minimisation that underwrites the selection of future sensory data."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "For this, we make a distinction between attention and salience. Briefly, we associate attention with precision control, i.e., the confidence with which beliefs can be updated given sampled sensory data..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

