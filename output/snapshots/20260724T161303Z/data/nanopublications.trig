    <http://activeinference.institute/ontology/paper/arxiv_2412.00748> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2412.00748_MORPHOGENESIS> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2412.00748_MORPHOGENESIS> ns2:citationCount 0 ;
