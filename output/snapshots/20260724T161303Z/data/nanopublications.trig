<http://activeinference.institute/nanopub/7120f801adc0#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_frobt.2019.00020> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frobt.2019.00020_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frobt.2019.00020_FEP_UNIVERSALITY> ns2:citationCount 42 ;
        ns2:claim "The paper discusses the FEP as a general principle for biological agents but doesn't explicitly test its universality across all systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "However, Active inference (AI) is a corollary of the FEP, which states that biological agents act to fulfill prior beliefs about preferred future observations (target priors)."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The free energy principle (FEP) offers a variational calculus-based description for how biological agents persevere through interactions with their environment."^^xsd:string .
}

