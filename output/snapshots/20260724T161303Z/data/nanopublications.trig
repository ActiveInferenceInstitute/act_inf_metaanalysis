        ns2:claim "The paper's focus on compositional predictive coding and lens-based semantics suggests a mechanistic account of cortical function that doesn’t necessarily imply Markov blankets represent physical boundaries."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
