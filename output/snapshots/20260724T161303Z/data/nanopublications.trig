<http://activeinference.institute/nanopub/105a306f2522#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1523_jneurosci.5069-11.2012_PREDICTIVE_CODING> ns2:citationCount 394 ;
        ns2:claim "The paper's core finding – feedback modulation of activity in the inferior frontal gyrus and superior temporal gyrus based on prior knowledge – directly aligns with the principles of predictive coding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "activity in the inferior frontal gyrus was modulated by prior knowledge before activity in lower-level sensory regions of the superior temporal gyrus."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "activity in the inferior frontal gyrus was modulated by prior knowledge before activity in lower-level sensory regions of the superior temporal gyrus."^^xsd:string ;
