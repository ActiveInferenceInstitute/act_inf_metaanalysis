<http://activeinference.institute/nanopub/106d26a2a049#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3196561192_AIF_OPTIMALITY> ns2:citationCount 13 ;
        ns2:claim "The paper explicitly states that robots 'find themselves in a loop, attempting to predict and infer each other's actions,' which aligns with the core concept of AIF – agents actively minimizing surprise through inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "When one robot trained with tighter regulation and another trained with looser regulation interact, the latter tends to lead the interaction by exerting stronger action intention, while the former tends to follow by adapting to its observations."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
