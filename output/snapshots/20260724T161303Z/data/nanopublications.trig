    <http://activeinference.institute/ontology/assertion/llm_doi_10.4324_9781003084082-3_FEP_UNIVERSALITY> ns2:citationCount 7 ;
        ns2:claim "The paper discusses a variational principle applicable to sentient systems, aligning with the broad scope of the FEP but doesn't explicitly test universality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "We argue that these bodies of work provide the foundation for an active inference theory of conscious experience."^^xsd:string ;
