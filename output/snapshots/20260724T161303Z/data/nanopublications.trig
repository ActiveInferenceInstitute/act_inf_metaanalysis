    <http://activeinference.institute/ontology/assertion/llm_arxiv_2207.09897_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper claims that successor representations offer advantages in planning horizon and computational cost, implying better scalability to complex environments."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "We demonstrate that active inference successor representations have significant advantages over current active inference agents in terms of planning horizon and computational cost."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2207.09897> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2207.09897_SCALABILITY> .
}

