<http://activeinference.institute/nanopub/5e15c00fe1c1#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01357_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper presents active inference as a general framework for autonomous agents, but doesn't explicitly address the universality of the FEP itself. It focuses on demonstrating active inference’s applicability within a specific context (discrete-state environments)."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This problem is also considered in reinforcement learning (RL), but limited work exists on comparing the two approaches on the same discrete-state environments."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference is a first principle account of how autonomous agents operate in dynamic, non-stationary environments."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01357> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01357_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/933b771f0410#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1911.10601_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:1911.10601"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T17:44:47.379903+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "In reinforcement learning (RL), agents often operate in partially observed and uncertain environments. Model-based RL suggests that this is best achieved by learning and exploiting a probabilistic model of the world. 'Active inference' is an emerging normative framework in cognitive and computational neuroscience that offers a unifying account of how biological agents achieve this. On this framework, inference, learning and action emerge from a single imperative to maximize the Bayesian evidence for a niche"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T17:44:47.380622+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_1911.10601> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/933b771f0410> .
}

