        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This paper offers a prospectus of what might be achievable in the development of emotional recognition devices."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fncom.2020.00030> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2020.00030_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/a39362682da2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2202.11154_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper's approach (Parallel Active Inference) directly addresses the scalability issue of MCMC by enabling parallel computation and improved sampling quality, which is a key aspect of scaling Active Inference."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "While efficient, this framework is very sensitive to the quality of subposterior sampling. Common sampling problems such as missing modes or misrepresentation of low-density regions are amplified -- instead of being corrected -- in the combination phase, leading to catastrophic failures."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "While efficient, this framework is very sensitive to the quality of subposterior sampling. Common sampling problems such as missing modes or misrepresentation of low-density regions are amplified -- instead of being corrected -- in the combination phase, leading to catastrophic failures."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2202.11154> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2202.11154_SCALABILITY> .
}

<http://activeinference.institute/nanopub/1e5257b36b8a#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2504.06209_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses the Free Energy Principle broadly as a foundational principle for information processing, but doesn't explicitly test its universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"While the usefulness of the predictive paradigm is undisputed...\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Predicting future observations plays a central role in machine learning, biology, economics, and many other fields. It lies at the heart of organizational principles such as the variational free energy principle..."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2504.06209> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2504.06209_FEP_UNIVERSALITY> .
