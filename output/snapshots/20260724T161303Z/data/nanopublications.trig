<http://activeinference.institute/nanopub/9431b838bcb1#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2023.08.016_MARKOV_BLANKET_REALISM> ns2:citationCount 105 ;
        ns2:claim "The paper describes blanket states as mediating inference between internal and external states, implying a conceptualization of boundaries that differs from the purely physical realism suggested by Markov blankets."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "Particles are defined by a particular partition, in which internal states are individuated from external states by active and sensory blanket states."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Particles are defined by a particular partition, in which internal states are individuated from external states by active and sensory blanket states."^^xsd:string .

