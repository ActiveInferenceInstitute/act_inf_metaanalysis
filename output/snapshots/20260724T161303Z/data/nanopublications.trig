<http://activeinference.institute/nanopub/cf7ec7688232#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1111_pcn.13138_PREDICTIVE_CODING> ns2:citationCount 171 ;
        ns2:claim "The paper explicitly frames the brain as a 'prediction machine' using predictive coding to minimize prediction errors."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In recent years, neuroscience has converged on the notion that the brain is a ‘prediction machine,’ in that it actively predicts the sensory input that it will receive if one or another course of action is chosen."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In recent years, neuroscience has converged on the notion that the brain is a ‘prediction machine,’ in that it actively predicts the sensory input that it will receive if one or another course of action is chosen."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1111_pcn.13138> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1111_pcn.13138_PREDICTIVE_CODING> .
}

<http://activeinference.institute/nanopub/51a3a5f783d7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.65649_93qfwv21_FEP_UNIVERSALITY> ns2:citationCount 2 ;
        ns2:claim "The paper explicitly frames quantum behavior as an emergent property of a predictive engine, aligning with the FEP's core principle of self-organization across diverse systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "By deriving quantum phenomena from a principle of predictive inference, the theory bridges the Free Energy Principle, relational quantum mechanics, and decoherence theory..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This framework generates quantum phenomena from a principle of predictive inference, suggesting that quantumness is a universal signature of systems that must pause to look backward in order to predict the future."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.65649_93qfwv21> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.65649_93qfwv21_FEP_UNIVERSALITY> .
}

