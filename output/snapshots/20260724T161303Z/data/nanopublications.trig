<http://activeinference.institute/nanopub/2db0ec6b6740#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_1710.09118> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1710.09118_PREDICTIVE_CODING> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_1710.09118_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper describes RD as Bayesian filtering of external causes and minimizing free energy, which is consistent with the predictive coding framework."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Consequently, we effectively cast the gradient-descent scheme of minimizing the free energy into Hamiltonian mechanics by addressing only positions and momenta of the organisms’ representations of the causal environment."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .
}

<http://activeinference.institute/nanopub/af8c745bae84#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.7449368> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.7449368_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.7449368_FEP_UNIVERSALITY> ns2:citationCount 1 ;
        ns2:claim "The paper describes a broad literature analysis focusing on the application of FEP and Active Inference across various domains, suggesting exploration but not definitive proof of universality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "For a subset of papers with accessible full texts, we performed manual annotation (related to structural, visual, and mathematical features) and automated analyses (related to the terms in the Active Inference Institute’s Active Inference Ontology)."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here we perform a literature analysis of publications in scientific literature using the term “Free Energy Principle” or “Active Inference”, with an emphasis on works by Karl J Friston."^^xsd:string .
}

<http://activeinference.institute/nanopub/5a69b7c2bfa4#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.17735_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that strategies incorporating gravity and longer temporal horizons outperform others, aligning with the core principle of Active Inference – minimizing free energy to achieve optimal control."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Performance is evaluated across diverse initial conditions using spatial and temporal error, action magnitude, and movement corrections."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "none"^^xsd:string ;
        ns2:sourceClaim "Those that incorporate gravity and longer temporal horizons outperform others."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2512.17735> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.17735_AIF_OPTIMALITY> .
