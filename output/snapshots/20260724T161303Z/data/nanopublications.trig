        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Neuronal computations rely upon local interactions across synapses. For a neuronal network to perform inference, it must integrate information from locally computed messages that are propagated among elements of that network."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1038_s41598-018-38246-3> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1038_s41598-018-38246-3_FEP_UNIVERSALITY> .
}

