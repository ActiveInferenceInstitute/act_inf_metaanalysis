<http://activeinference.institute/nanopub/b2a33f2a2df9#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-021-00859-9_AIF_OPTIMALITY> ns2:citationCount 9 ;
        ns2:claim "The paper explicitly builds a Bayesian mechanics (BM) based on free energy minimization and control signals arising from prediction errors, aligning with the core concept of AIF – agents optimizing decisions by minimizing surprise."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The resulting BM is provided as an effective Hamilton’s equation of motion and subject to the control signal arising from the brain’s prediction errors at the proprioceptive level."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The BM is a neural implementation of variational Bayes under the FEP in continuous time. The resulting BM is provided as an effective Hamilton's equation of motion and subject to the control signal arising from the brain's prediction errors at the proprioceptive level."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s00422-021-00859-9> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-021-00859-9_AIF_OPTIMALITY> .
