        ns2:evidenceQuote "…inspiring innovative solutions in robotics and artificial intelligence."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "By dynamic planning, we refer to the ability of the human brain to infer and impose motor trajectories related to cognitive decisions."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2402.11658> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.11658_FEP_UNIVERSALITY> .
