<http://activeinference.institute/nanopub/50cab00e81f9#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2112.15459> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.15459_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.15459_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper primarily focuses on social learning and AI architecture rather than directly addressing the universality of the FEP itself. It suggests a broader application of biological principles to AI, which aligns with some interpretations of the FEP but doesn't explicitly test its universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We thus argue that social interactions not only are largely unexplored in this field but also are an essential element of advanced cognitive ability, and therefore constitute metaphorically the dark matter of AI."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We argue that the complex human cognitive architecture owes a large portion of its expressive power to its ability to engage in social and cultural learning."^^xsd:string .
}

