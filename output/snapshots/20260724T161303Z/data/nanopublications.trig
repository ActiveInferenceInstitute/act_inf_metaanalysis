<http://activeinference.institute/nanopub/22816a744245#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-022-03480-w_AIF_OPTIMALITY> ns2:citationCount 39 ;
        ns2:claim "The paper argues that active inference formulations of decision processes *do* include terms for desires, suggesting it doesn't necessarily lead to optimal decision-making in the traditional sense (which often assumes optimizing a reward function)."^^xsd:string ;
