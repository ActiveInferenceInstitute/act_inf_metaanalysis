<http://activeinference.institute/nanopub/c5635d53c6b3#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1705.09156_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper reviews a specific implementation of the FEP and doesn't directly address whether it applies universally to all self-organizing systems. It focuses on a biologically plausible model."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "Here, we provide a detailed mathematical evaluation of a suggested biologically plausible implementation of the FEP that has been widely used to develop the theory."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The 'free energy principle' (FEP) has been suggested to provide a unified theory of the brain, integrating data and theory relating to action, perception, and learning."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_1705.09156> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1705.09156_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/896fc864b9f6#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2204.00032_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on data poisoning attacks within machine learning models, a specific application of predictive coding and self-organization rather than demonstrating universal applicability of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Our attacks are effective across membership inference, attribute inference, and data extraction."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our active inference attacks connect two independent lines of work targeting the integrity and privacy of machine learning training data."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2204.00032> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2204.00032_FEP_UNIVERSALITY> .
}

