<http://activeinference.institute/nanopub/b5eb4e12f8cb#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_k4cas_FEP_UNIVERSALITY> ns2:citationCount 1 ;
        ns2:claim "The paper explicitly discusses the FEP-AI framework as a solution to existential risks, suggesting its applicability across diverse systems and highlighting its potential for realizing control systems operating according to principles of hierarchical Bayesian modeling."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Such FEP-AI agents are equipped with hierarchically-organized world models capable of counterfactual planning, realized by the kinds of reciprocal message passing performed by mammalian nervous systems, so allowing for the flexible construction of representations of self-world dynamics with varying degrees of temporal depth."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Here, we explore how the Free Energy Principle and Active Inference (FEP-AI) framework may provide solutions for these challenges via affording the realization of control systems operating according to principles of hierarchical Bayesian modeling and prediction-error (i.e., surprisal) minimization."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_k4cas> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_k4cas_FEP_UNIVERSALITY> .
}

