<http://activeinference.institute/nanopub/d98a15f74694#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2412.14741_MORPHOGENESIS> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
