        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We introduce a novel online noise smoothness estimator based on the idea of free energy principle."^^xsd:string .

