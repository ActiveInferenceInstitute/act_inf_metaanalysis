<http://activeinference.institute/nanopub/1768a89e29db#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2012.00096_PREDICTIVE_CODING> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.3389/fpsyg.2012.00096"^^xsd:string ;
