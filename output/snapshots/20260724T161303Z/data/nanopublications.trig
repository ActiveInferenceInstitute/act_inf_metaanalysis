<http://activeinference.institute/nanopub/2db0ec6b6740#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1710.09118_PREDICTIVE_CODING> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
