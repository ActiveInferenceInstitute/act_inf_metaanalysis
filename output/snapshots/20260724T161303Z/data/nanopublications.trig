        ns2:claim "The paper discusses applying the FEP to a robot, suggesting its general applicability but doesn't explicitly test universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The model relies on the free energy principle…gradient descent on the variational free energy bound."^^xsd:string ;
