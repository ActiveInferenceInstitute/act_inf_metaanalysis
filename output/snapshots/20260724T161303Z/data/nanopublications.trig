<http://activeinference.institute/nanopub/563b22689e2b#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2016.00925> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.00925_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.00925_FEP_UNIVERSALITY> ns2:citationCount 53 ;
        ns2:claim "The paper discusses the FEP as a unifying principle across multiple disciplines (psychology, AI, neuroscience), suggesting its broad applicability but doesn't explicitly test universality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "The unification rests on the free energy-based inference principle, which essentially implies that the brain builds a predictive, generative model of its environment."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The unification rests on the free energy-based inference principle, which essentially implies that the brain builds a predictive, generative model of its environment."^^xsd:string .
}

<http://activeinference.institute/nanopub/8fd43c173050#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1000211_PREDICTIVE_CODING> ns2:citationCount 974 ;
        ns2:claim "The hierarchical model with prediction error minimization aligns with the core tenets of predictive coding, where higher levels predict lower levels' activity."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The ensuing hierarchy furnishes a model for many types of data, of arbitrary complexity."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The model comprises hidden layers of state-space or dynamic causal models, arranged so that the output of one provides input to another. Crucially, all of these models can be inverted using exactly the same scheme, namely, dynamic expectation maximization."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1371_journal.pcbi.1000211> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1000211_PREDICTIVE_CODING> .
}

<http://activeinference.institute/nanopub/7b1746e21b9d#provenance> {
