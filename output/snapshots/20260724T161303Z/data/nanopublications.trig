<http://activeinference.institute/nanopub/b37ecfad1695#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_frobt.2022.794464> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frobt.2022.794464_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frobt.2022.794464_FEP_UNIVERSALITY> ns2:citationCount 8 ;
        ns2:claim "The paper focuses on a specific implementation of AIF (CBFE) within a simulated environment and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The key intuition behind the CBFE is that we impose a point-mass constraint on predicted outcomes, which explicitly encodes the assumption that the agent will make observations in the future."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Crucially, variational optimization of the CBFE can be expressed in terms of message passing on free-form generative models."^^xsd:string .
}

