<http://activeinference.institute/nanopub/5510d4954296#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1093_cercor_bhn161_PREDICTIVE_CODING> ns2:citationCount 330 ;
        ns2:claim "The paper's central finding – that prediction error drives changes in connectivity – is a core tenet of predictive coding models of perception."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "Critically, this prediction-error response was observed even when the absence of a visual stimulus was surprising."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Consistent with predictive coding models of perception, associative learning is mediated by prediction-error dependent changes in connectivity."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1093_cercor_bhn161> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1093_cercor_bhn161_PREDICTIVE_CODING> .
