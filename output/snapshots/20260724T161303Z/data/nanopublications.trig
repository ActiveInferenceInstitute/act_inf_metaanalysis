<http://activeinference.institute/nanopub/931747f6e8b2#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01383_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
