<http://activeinference.institute/nanopub/18c8f08e4571#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-014-0620-8_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper's use of a generative model with hierarchical structure and anticipatory responses aligns with the core principle of predictive coding – minimizing prediction errors through hierarchical representations."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "Finally, the generative model is equipped with a hierarchical structure, so that it can recognise and remember unseen (occluded) trajectories and emit anticipatory responses."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Finally, the generative model is equipped with a hierarchical structure, so that it can recognise and remember unseen (occluded) trajectories and emit anticipatory responses."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

