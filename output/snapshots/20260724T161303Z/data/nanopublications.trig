<http://activeinference.institute/nanopub/e5b433807878#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.26465_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The model uses structured binary gating variables and Boltzmann-style energy functions to represent interactions – this is a highly specific representation of a Markov blanket, potentially obscuring the more general concept of real physical boundaries."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "Query-key similarity defines local bias terms, learnable pairwise interactions capture synergy and competition between edges, and latent hidden units model higher-order combinatorial dependencies."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Query-key similarity defines local bias terms, learnable pairwise interactions capture synergy and competition between edges, and latent hidden units model higher-order combinatorial dependencies."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2603.26465> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.26465_MARKOV_BLANKET_REALISM> .
}

<http://activeinference.institute/nanopub/bb61cec52139#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.08991_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly describes active sampling as a method to improve estimation accuracy by prioritizing uncertain data points – a core tenet of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The drawback, however, is that inaccurate uncertainty estimates can make active sampling produce highly noisy results, potentially worse than those from naive uniform sampling."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Given a budget on the number of labeled data points that can be collected and assuming access to an AI predictive model, the basic idea is to improve estimation accuracy by prioritizing the collection of labels where the model is most uncertain."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2511.08991> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.08991_AIF_OPTIMALITY> .
}

