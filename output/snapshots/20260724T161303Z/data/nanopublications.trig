    <http://activeinference.institute/ontology/assertion/llm_arxiv_2004.08128_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper argues that minimizing EFE doesn't directly lead to exploration, challenging the notion of optimal decision-making in active inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "...thus demonstrating that exploration does not directly follow from free energy minimization into the future."^^xsd:string ;
