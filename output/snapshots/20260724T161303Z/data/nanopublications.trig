<http://activeinference.institute/nanopub/ef7683e242db#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.03308_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper uses Active Inference (a manifestation of the FEP) to model NFT, suggesting a broader applicability but doesn't explicitly test universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Using Active Inference, a Bayesian framework modelling perception, action, and learning, we simulate agents interacting with an NFT environment."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
