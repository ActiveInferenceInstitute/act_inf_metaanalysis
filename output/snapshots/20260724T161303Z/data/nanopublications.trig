    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e14112100_MARKOV_BLANKET_REALISM> ns2:citationCount 385 ;
        ns2:claim "The paper describes a system where external states are random and internal states are deterministic, implying an informational boundary (Markov blanket) rather than a physical one."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "circular causality is induced by separating the states of a random dynamical system into external and internal states, where external states are subject to random fluctuations and internal states are not."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "circular causality is induced by separating the states of a random dynamical system into external and internal states, where external states are subject to random fluctuations and internal states are not."^^xsd:string .

