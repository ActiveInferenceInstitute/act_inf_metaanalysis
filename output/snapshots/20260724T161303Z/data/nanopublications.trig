<http://activeinference.institute/nanopub/f24529fd13ee#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.1906.03022_PREDICTIVE_CODING> ns2:citationCount 29 ;
        ns2:claim "The core mechanism of the model – minimizing prediction error through sensory sampling and internal models – directly reflects predictive coding."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "minimising the difference between the observed…predicted ones. Simultaneously, the action makes sensory data sampling to better correspond to the prediction made by the inner model"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The body state (latent variable) is inferred by minimising the difference between the observed (visual and proprioceptive) sensor values and the predicted ones. Simultaneously, the action makes sensory data sampling to better correspond to the prediction made by the inner model."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.1906.03022> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.1906.03022_PREDICTIVE_CODING> .
}

