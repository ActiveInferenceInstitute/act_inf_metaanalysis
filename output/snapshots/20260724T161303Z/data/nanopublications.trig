    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyt.2013.00047_CLINICAL_UTILITY> ns2:citationCount 850 ;
        ns2:claim "The paper proposes an Active Inference model of psychosis, suggesting it could provide a clinically useful framework for understanding and potentially treating the condition."^^xsd:string ;
        ns2:confidence 8.5e-01 ;
        ns2:evidenceQuote "…this represents a pernicious failure of metacognition (beliefs about beliefs) that can confound perceptual inference."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…this represents a pernicious failure of metacognition (beliefs about beliefs) that can confound perceptual inference. In the embodied setting of active (Bayesian) inference, it can lead to behaviors that are paradoxically more accurate than Bayes-optimal behavior."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/clinical_utility> .
}

