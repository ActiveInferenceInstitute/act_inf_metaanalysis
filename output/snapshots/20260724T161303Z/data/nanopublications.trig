        ns2:claim "The paper explicitly demonstrates that active inference (specifically the sophisticated scheme) can produce Bellman optimal actions, directly supporting the claim that Active Inference agents achieve optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…the optimal solution to the Bellman equation"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Precisely, we show the conditions under which active inference produces the optimal solution to the Bellman equation--a formulation that underlies several approaches to model-based reinforcement learning and control."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2009.08111> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2009.08111_AIF_OPTIMALITY> .
