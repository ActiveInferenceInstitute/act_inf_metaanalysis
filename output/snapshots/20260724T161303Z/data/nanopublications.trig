<http://activeinference.institute/nanopub/06d7ee22c568#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_k4cas_AIF_OPTIMALITY> ns2:citationCount 1 ;
        ns2:claim "The paper emphasizes minimizing prediction-error (surprisal) as a core mechanism of Active Inference agents, directly linking this process to achieving optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "minimization-prediction-error (i.e., surprisal) minimization"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Such FEP-AI agents are equipped with hierarchically-organized world models capable of counterfactual planning, realized by the kinds of reciprocal message passing performed by mammalian nervous systems, so allowing for the flexible construction of representations of self-world dynamics with varying degrees of temporal depth."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_k4cas> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_k4cas_AIF_OPTIMALITY> .
}

