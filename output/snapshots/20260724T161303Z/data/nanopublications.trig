    <http://activeinference.institute/ontology/assertion/llm_arxiv_2110.10083_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly addresses the limitations of scaling Active Inference to complex environments and proposes a contrastive objective to reduce computational burden, suggesting it tackles this issue."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/scalability> ;
        ns2:evidenceQuote "...strongly reduces the computational burden..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In this work, we propose a contrastive objective for active inference that strongly reduces the computational burden in learning the agent's generative model and planning future actions. Our method performs notably better than likelihood-based active inference in image-based tasks..."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2110.10083> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2110.10083_SCALABILITY> .
