        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "thanks to the cognitive broadening of homininan \"zones of bounded surprisal\" (ZBS) with respect to paninans' ZBS"^^xsd:string .

