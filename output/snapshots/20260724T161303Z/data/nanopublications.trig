        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our framework utilizes active inference to predict reliable modalities based on posterior distributions and subsequently organizes them accordingly."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2506.13322> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.13322_FEP_UNIVERSALITY> .
