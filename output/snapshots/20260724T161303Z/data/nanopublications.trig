    <http://activeinference.institute/ontology/paper/arxiv_2308.11463> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.11463_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.11463_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific neural circuit (HC-mPFC) and its role in spatial alternation tasks, rather than making a broad claim about the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Through a series of simulations, we demonstrate that the model's dual layers acquire effective cognitive maps for navigation within physical (HC map) and task (mPFC map) spaces..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We advance a novel hierarchical active inference model clarifying how the HC - mPFC circuit enables the resolution of spatial alternation tasks, by merging physical and task-space cognitive maps."^^xsd:string .
}

