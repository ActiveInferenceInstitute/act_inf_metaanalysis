    <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.06049_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses computational psychiatry as a broader approach to understanding illness, but doesn't explicitly address the universality of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We find that, in this literature, affect is an important source of modulation in decision making, and has a bidirectional influence on how individuals infer both internal and external states."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Computational psychiatry approaches promise to bridge this gap by providing formal accounts of the latent information processing changes that underlie the development and maintenance of psychiatric phenomena."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2503.06049> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.06049_FEP_UNIVERSALITY> .
}

