<http://activeinference.institute/nanopub/d9631cc662a7#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2020.574372_SCALABILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
