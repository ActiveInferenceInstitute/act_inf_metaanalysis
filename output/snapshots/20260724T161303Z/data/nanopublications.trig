<http://activeinference.institute/nanopub/2a9b6b1af82e#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_udc42_PREDICTIVE_CODING> ns2:citationCount 5 ;
        ns2:claim "The paper describes how ESMs utilize predictive coding mechanisms and backward-chained imaginings to minimize prediction errors, directly relating to the core mechanism of Predictive Coding."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "…predictive coding mechanisms and backward-chained imaginings (as self-realizing predictions)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…answering an unresolved question in Bayesian cognitive science: what are biologically plausible mechanisms for equipping learners with sufficiently powerful inductive biases to adequately constrain inference spaces? Drawing on models from neurophysiology, psychology, and developmental robotics, I describe how embodiment provides fundamental sources of empirical priors (as reliably learnable posterior expectations)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_udc42> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_udc42_PREDICTIVE_CODING> .
}

<http://activeinference.institute/nanopub/42ef7951798f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1205.3997_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on decision trees and generalized optimality equations, not a universal application of the FEP across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We derive generalized sequential optimality equations that not only include the Bellman optimality equations as a limit case, but also lead to well-known decision-rules such as Expectimax, Minimax and Expectiminimax."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here we apply the free energy principle to general decision trees that include both adversarial and stochastic environments."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_1205.3997> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1205.3997_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/ca4ea979c337#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.23681_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper describes ODAR as using an active inference framework with a difficulty estimator and dynamic routing between agents, directly supporting the idea that Active Inference agents can achieve optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "difficulty estimator grounded in amortized active inference to dynamically route queries…"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We propose ODAR-Expert, an adaptive routing framework that optimizes the accuracy-efficiency trade-off via principled resource allocation. ODAR uses a difficulty estimator grounded in amortized active inference to dynamically route queries between a heuristic Fast Agent and a deliberative Slow Agent."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2602.23681> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.23681_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/1f3218cdcece#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2110.14157_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The use of Bayesian nonparametric models and Gaussian processes to discover latent world dynamics suggests a potential approach for scaling Active Inference to complex environments by mitigating data efficiency issues."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "Bayesian nonparametric models provide automatic model adaptation..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Bayesian nonparametric models provide automatic model adaptation, which not only combats underfitting and overfitting, but also allows the model's unbounded dimension to be both flexible and computationally tractable."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2110.14157> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2110.14157_SCALABILITY> .
}

<http://activeinference.institute/nanopub/1e079abc515f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17873550_FEP_UNIVERSALITY> ns2:citationCount 4 ;
        ns2:claim "The paper explicitly contrasts its approach to Free Energy Principle (FEP) while acknowledging similarities but stating it's not reduced *to* FEP. It focuses on a specific instantiation of the FEP – autopoietic intelligence – suggesting universality is an open question."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "It is explicitly compared to—but not reduced to—Free-Energy Principle and active inference approaches to adaptive agents and AI."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The framework clarifies how survival-oriented and non-utilitarian meanings can coexist in physically realistic, self-modifying intelligent systems, and it is explicitly compared to—but not reduced to—Free-Energy Principle and active inference approaches to adaptive agents and AI."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.17873550> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17873550_FEP_UNIVERSALITY> .
}

