<http://activeinference.institute/nanopub/a6a71ac942f5#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_s12559-021-09960-4> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s12559-021-09960-4_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s12559-021-09960-4_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application of Active Inference (collaborative agents) and doesn't directly address the universal applicability of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…inferred mental states of one agent influence another agent's predictive beliefs about its own goals and intentions."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
