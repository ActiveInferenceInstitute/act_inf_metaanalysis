<http://activeinference.institute/nanopub/312a6225c70a#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1177_1059712319862774_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
