        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…how they can be seen as emitting the same observations, and thus minimise prediction error, over time without strict assumptions about structural similarity."^^xsd:string .
}

