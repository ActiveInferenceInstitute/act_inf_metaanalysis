<http://activeinference.institute/nanopub/5561fc76c73d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints202410.1895.v1_FEP_UNIVERSALITY> ns2:citationCount 2 ;
        ns2:claim "The paper discusses active inference as a framework applicable across scales, suggesting broad applicability of the FEP but doesn't directly test universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Crucially, a collective of active inference agents can, if they maintain a group-level Markov Blanket, constitute a larger group-level active inference agent with a generative model of its own."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference under the Free Energy Principle has been proposed as an across-scales compatible framework for understanding and modelling behaviour and self-maintenance."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.20944_preprints202410.1895.v1> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints202410.1895.v1_FEP_UNIVERSALITY> .
}

