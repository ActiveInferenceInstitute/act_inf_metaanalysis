<http://activeinference.institute/nanopub/12b3692d9987#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.01977_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly describes FEP-Nav as a framework for 'real-time perceptual adaptation' and demonstrates improved navigation performance compared to non-adaptive baselines, aligning with the core principle of AIF – achieving optimal decision-making through active inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "FEP-Nav facilitates a substantial recovery of navigation performance, consistently exceeding the capabilities of both non-adaptive baselines and strong adaptive methods."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Evaluations across a diverse suite of simulated and real-world visual corruptions demonstrate that FEP-Nav facilitates a substantial recovery of navigation performance, consistently exceeding the capabilities of both non-adaptive baselines and strong adaptive methods."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2403.01977> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2403.01977_AIF_OPTIMALITY> .
}

