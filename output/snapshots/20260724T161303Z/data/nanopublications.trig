<http://activeinference.institute/nanopub/4072ba67ed38#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2016.00925_LANGUAGE_AIF> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.3389/fpsyg.2016.00925"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T22:48:34.966303+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "Moreover, it is sketched-out how symbol-like thought can be generated by a temporarily active set of predictive encodings, which constitute a distributed neural attractor in the form of an interactive free-energy minimum. The activated, interactive network attractor essentially characterizes the semantics of a concept or a concept composition, such as an actual or imagined situation in our environment. Temporal successions of attractors then encode unfolding semantics, which may be generated by a behavioral or mental interaction with an actual or imagined situation in our environment."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:48:34.966684+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2016.00925> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/4072ba67ed38> .
}

<http://activeinference.institute/nanopub/cbba27e30fd1#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.11070_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
