    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01351_AIF_OPTIMALITY> ns2:citationCount 117 ;
        ns2:claim "The paper explicitly describes a sophisticated form of Active Inference that uses a recursive free energy functional, which is fundamentally about achieving optimal decision-making by minimizing uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Crucially, this search is over sequences of belief states as opposed to states per se."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In brief, active inference replaces value functions with functionals of (Bayesian) beliefs, in the form of an expected (variational) free energy."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01351> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01351_AIF_OPTIMALITY> .
}

