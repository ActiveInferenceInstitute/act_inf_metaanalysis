<http://activeinference.institute/nanopub/0ad23471eec1#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fsoc.2023.1269621_AIF_OPTIMALITY> ns2:citationCount 2 ;
        ns2:claim "The paper discusses how shared beliefs (a form of active inference) scale identity and align perspectives, but doesn't directly address the optimality aspect of AIF."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"Behavioral bias, subjective emotions, and social norms scale the scope of identity...\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:sourceClaim "Behavioral bias, subjective emotions, and social norms scale the scope of identity by coalescing agents with otherwise disparate goals and aligning their perspectives into a coherent structure."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fsoc.2023.1269621> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fsoc.2023.1269621_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/9fd8195761e2#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2310.12563> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.12563_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.12563_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper proposes an algorithm based on maximizing information gain, a core concept in Active Inference (optimizing decision-making under uncertainty). The asymptotic optimality proof further strengthens this link."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "this method yields strong performances in classical bandit settings. Owing to its empirical success, we prove its asymptotic optimality for the two-armed bandit problem with Gaussian rewards."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "To this end, we develop an approximated analytical physics-based representation of an entropy to forecast the information gain of each action and greedily choose the one with the largest information gain."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

