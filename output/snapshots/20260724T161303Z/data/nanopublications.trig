        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/7b1746e21b9d> .
}

<http://activeinference.institute/nanopub/1a5a984b2d65#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2103.12649_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a micro-level implementation of the FEP (synaptic connections) and doesn't directly address the universality claim at larger scales."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The parameters of the learning rules are fully determined by the parameters of the post-synaptic neuron model, suggesting a close interplay between the synaptic and somatic compartment"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This synapse-centric account of the FEP predicts that synapses interact with the soma of the post-synaptic neuron through stochastic synaptic releases to probe their behavior and use back-propagating action potentials as feedback to update the synaptic weights."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2103.12649> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2103.12649_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/8241ee2bb5a0#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2510.04084> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.04084_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.04084_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explores a specific instantiation of the FEP in neuronal cultures, focusing on integrated information and belief updating. While suggestive, it doesn't directly address the universal applicability of the FEP to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The hill-shaped trajectory of Φ during inference can be functionally interpreted as a transition from exploration to exploitation."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "These findings suggest that integrated information increases specifically during belief updating, when sensory inputs are most informative, rather than tracking model efficiency."^^xsd:string .
}

<http://activeinference.institute/nanopub/93ba12de3cce#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1162_isal_a_00288> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_isal_a_00288_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_isal_a_00288_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses the application of the Free Energy Principle to a specific system (Watt governor) without making a broad claim about universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Recently, active inference has been proposed as part of a new and unifying framework in the cognitive sciences: predictive processing."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We introduce an active inference formulation of the Watt centrifugal governor, a system often portrayed as the canonical \"anti-representational\" metaphor for cognition."^^xsd:string .
}

