<http://activeinference.institute/nanopub/9df677bd9ab8#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.tics.2013.09.007_CLINICAL_UTILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
