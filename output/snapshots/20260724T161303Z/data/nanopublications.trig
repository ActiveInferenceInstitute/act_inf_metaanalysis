<http://activeinference.institute/nanopub/8984d249eb47#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_1709.03573> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1709.03573_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_1709.03573_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly proposes an active inference strategy designed to minimize sample complexity under a reliability constraint, directly supporting the idea that AIF agents can achieve optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "We then establish its order optimality in terms of both the size of the search space (i.e., the number of data streams) and the reliability requirement."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The objective is an active inference strategy that determines, sequentially, which data stream to collect samples from in order to minimize the sample complexity under a reliability constraint."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

<http://activeinference.institute/nanopub/de825c9409b6#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fncom.2016.00056> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2016.00056_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2016.00056_FEP_UNIVERSALITY> ns2:citationCount 178 ;
        ns2:claim "The paper discusses active inference as a general framework for perception and action, but doesn't explicitly address universality of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This assumption generalizes risk-sensitive control and expected utility theory to include epistemic value; namely, the value (or salience) of information inherent in resolving uncertainty about the causes of ambiguous cues or outcomes."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference assumes that perception and action minimize variational free energy, where actions are selected to minimize the free energy expected in the future."^^xsd:string .
}

