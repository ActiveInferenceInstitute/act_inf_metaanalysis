<http://activeinference.institute/nanopub/a6399ab7bc40#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnbot.2022.844773_FEP_UNIVERSALITY> ns2:citationCount 31 ;
        ns2:claim "The paper discusses potential incompatibilities between enactive cognitive science and the FEP but ultimately argues for a complementary relationship, suggesting the FEP's applicability isn't definitively refuted by enactive arguments."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The FEP needs enactive cognitive science for the solution it provides to the problem of meaning. Enactive cognitive science needs the FEP to formally model the properties it argues to be constitutive of agency."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "There are undeniable conceptual differences between the two frameworks but in our view each has something important and necessary to offer."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnbot.2022.844773> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnbot.2022.844773_FEP_UNIVERSALITY> .
}

