        ns2:claim "The paper explicitly states that the framework minimizes variational free energy to update the policy, which is a core mechanism of Active Inference aimed at optimizing decisions under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "minimizing the variational free energy"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "A belief based learning method is exploited for updating the policy by minimizing the variational free energy."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2308.11402> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.11402_AIF_OPTIMALITY> .
