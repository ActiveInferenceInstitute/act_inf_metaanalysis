    <http://activeinference.institute/ontology/assertion/llm_arxiv_2007.01647_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper highlights the agent's ability to flexibly solve new tasks in an 'active inference style,' suggesting it’s achieving a form of optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "the agent can execute kinematic simulations of the environment's future, and use those for action planning. We demonstrate its performance on a set of several related, but different one-shot imitation tasks, which the agent flexibly solves in an active inference style."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "the agent can execute kinematic simulations of the environment's future, and use those for action planning. We demonstrate its performance on a set of several related, but different one-shot imitation tasks, which the agent flexibly solves in an active inference style."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

