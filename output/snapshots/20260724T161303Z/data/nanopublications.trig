<http://activeinference.institute/nanopub/76514f0b4e94#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.15201_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the model is based on active inference, which posits agents minimize surprise by acting upon the world – a core tenet of optimality under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "minimize surprise"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "According to active inference, the agent acts upon the world so as to minimize surprise defined as a measure of the extent to which an agent's current sensory observations differ from its preferred sensory observations."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2303.15201> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.15201_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/de8aa06d8f8c#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1155_2009_785152> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2009_785152_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2009_785152_FEP_UNIVERSALITY> ns2:citationCount 340 ;
        ns2:claim "The paper focuses on a specific statistical technique (NMF) within a Bayesian framework, not directly addressing the broad claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Our construction retains conjugacy and enables us to develop more powerful models while retaining attractive features of standard NMF such as monotonic convergence and easy implementation."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We describe nonnegative matrix factorisation (NMF) with a Kullback-Leibler (KL) error measure in a statistical framework, with a hierarchical generative model consisting of an observation and a prior component."^^xsd:string .
}

<http://activeinference.institute/nanopub/b7a1644c7ae8#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1016_j.neubiorev.2016.06.022> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.neubiorev.2016.06.022_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.neubiorev.2016.06.022_FEP_UNIVERSALITY> ns2:citationCount 668 ;
        ns2:claim "The paper discusses a general account of behaviour within the FEP but doesn't explicitly address universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Although goal-directed and habitual policies are usually associated with model-based and model-free schemes, we find the more important distinction is between belief-free and belief-based schemes."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We show that active inference reduces to a classical (Bellman) scheme, in the absence of ambiguity."^^xsd:string .
}

