        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We examine dyadic imitative interactions of robots using a variational recurrent neural network model. The model is based on the free energy principle such that interacting robots find themselves in a loop, attempting to predict and infer each other's actions using active inference."^^xsd:string .

