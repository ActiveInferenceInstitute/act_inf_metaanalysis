<http://activeinference.institute/nanopub/e87f48abf8f6#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fsoc.2023.1269621_FEP_UNIVERSALITY> ns2:citationCount 2 ;
        ns2:claim "The paper explicitly argues that the FEP is a foundational principle for understanding human symbolic capacity and belief systems, suggesting its universal applicability."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "\"To perceive any object in a world of non-diminishing (perhaps irreducible) uncertainty, according to the FEP, its constituent parts must display common probabilistic tendencies, known as statistical beliefs, prior to its interpretation, or active inference...\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "I employ the free energy principle (FEP) to argue that the belief in moral objectivity, although perhaps fallacious, amounts to an ancient and universal human myth that is essential for our symbolic capacity."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fsoc.2023.1269621> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fsoc.2023.1269621_FEP_UNIVERSALITY> .
}

