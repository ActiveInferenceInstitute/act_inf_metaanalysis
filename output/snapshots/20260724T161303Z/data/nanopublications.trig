<http://activeinference.institute/nanopub/9f9b71b7ecdc#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.14611_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific HCI application (mouse pointing) and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "In contrast to previous optimal feedback control-based models, the agent's actions are selected by minimizing Expected Free Energy, solely based on preference distributions over percepts, such as observing clicking a button correctly."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our results show that the agent creates plausible pointing movements and clicks when the cursor is over the target, with similar end-point variance to human users."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2510.14611> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.14611_FEP_UNIVERSALITY> .
}

