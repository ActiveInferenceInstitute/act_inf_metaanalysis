    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e27020143_SCALABILITY> ns2:citationCount 5 ;
        ns2:claim "The paper's exploration of multi-scale active inference and the potential for scale-free structures directly addresses scalability as a key application of the FEP."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…across spatiotemporal scales, from cells to human collectives."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This potential for computational scale-free structures speaks to the application of active inference to self-organizing systems across spatiotemporal scales, from cells to human collectives."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e27020143> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e27020143_SCALABILITY> .
