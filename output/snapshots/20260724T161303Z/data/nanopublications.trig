        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "I demonstrate that, largely by contrasting with overly reductive analytical models that assume individual rational pursuit of extrinsic rewards, shared belief in moral conceptions, i.e., what amounts to a religious faith..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/language_aif> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fsoc.2023.1269621> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fsoc.2023.1269621_LANGUAGE_AIF> .
