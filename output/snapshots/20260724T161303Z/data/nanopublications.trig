<http://activeinference.institute/nanopub/e33e7323f167#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2603.18888> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.18888_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.18888_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific mechanism (ALPs) within the FEP and doesn't directly address the broader claim of universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "ALPs determine admissibility itself."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "ALPs are not additional representational states nor hyperpriors over precision; they constrain which hypotheses are admissible for regulatory control."^^xsd:string .
}

<http://activeinference.institute/nanopub/bef33b7f429e#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2501.13083> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2501.13083_SCALABILITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2501.13083_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper claims that the synergy between MCTS and Active Inference maintains coherent value estimates and uncertainty without sacrificing computational tractability, suggesting scalability to complex environments."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "This synergy allows our planner to maintain coherent estimates of value and uncertainty throughout planning, without sacrificing computational tractability."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This synergy allows our planner to maintain coherent estimates of value and uncertainty throughout planning, without sacrificing computational tractability."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .
}

<http://activeinference.institute/nanopub/4a47fde8c03f#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3390_e27020143> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e27020143_MARKOV_BLANKET_REALISM> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e27020143_MARKOV_BLANKET_REALISM> ns2:citationCount 5 ;
        ns2:claim "The paper's focus on characterizing generative models within a group-level agent suggests an abstraction of the Markov blanket, implying it’s a computational construct rather than a direct physical boundary."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "…with a group-level Markov blanket."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Crucially, a collective of active inference agents can, if they maintain a group-level Markov blanket, constitute a larger group-level active inference agent with a generative model of its own."^^xsd:string .
}

