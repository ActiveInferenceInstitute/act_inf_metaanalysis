        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We propose a novel scalable VI method where the learning objective combines the score matching loss and the proximal penalty term in iterations..."^^xsd:string .

