<http://activeinference.institute/nanopub/1181b8dfff4f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_pcs.2013.6737675_AIF_OPTIMALITY> ns2:citationCount 12 ;
        ns2:claim "The paper explicitly uses an active inference model (specifically a free energy minimization approach) to address the problem of noisy image quality assessment, suggesting that this is a mechanism for achieving optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "\"So image quality is closely related to the agreement between the noisy observation and the internal generative model explainable part of the image\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "So image quality is closely related to the agreement between the noisy observation and the internal generative model explainable part of the image."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_pcs.2013.6737675> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_pcs.2013.6737675_AIF_OPTIMALITY> .
}

