    <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2012_937860_AIF_OPTIMALITY> ns2:citationCount 141 ;
        ns2:claim "The paper argues that optimal policies correspond to empirical priors on the trajectories of hidden environmental states, implying agents seek outcomes aligned with their expectations (a form of optimality)."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "optimal policies correspond to empirical priors...compel agents to seek out the (valuable) states they expect to encounter."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "optimal policies correspond to empirical priors on the trajectories of hidden environmental states, which compel agents to seek out the (valuable) states they expect to encounter."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1155_2012_937860> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2012_937860_AIF_OPTIMALITY> .
}

