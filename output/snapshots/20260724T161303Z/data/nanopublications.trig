<http://activeinference.institute/nanopub/77d699a47025#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.07406_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses Branching Time Active Inference as an extension of Active Inference, which itself is a neuroscientific framework. While it touches on the foundational ideas of the FEP, it doesn't directly test or confirm universality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "Its root can be found in Active Inference (Friston et al., 2016; Da Costa et al., 2020; Champion et al., 2021c), a neuroscientific framework widely used for brain modelling, as well as in Monte Carlo Tree Search (Browne et al., 2012), a method broadly applied in the Reinforcement Learning literature."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Branching Time Active Inference (Champion et al., 2021b,a) is a framework proposing to look at planning as a form of Bayesian model expansion."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2112.07406> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.07406_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/87c92786e357#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2018.02714> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2018.02714_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2018.02714_FEP_UNIVERSALITY> ns2:citationCount 195 ;
        ns2:claim "The paper focuses on consciousness and a specific physiological mechanism within the brainstem, not broadly applying the FEP to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "After clarifying some philosophical issues concerning functionalism, it identifies the elemental form of consciousness as <i>affect</i> and locates its physiological mechanism (an extended form of homeostasis) in the upper brainstem."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This article applies the free energy principle to the hard problem of consciousness."^^xsd:string .
}

