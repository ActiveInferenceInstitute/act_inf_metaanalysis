<http://activeinference.institute/nanopub/4f9063184ad4#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-030-64919-7_8_SCALABILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.1007/978-3-030-64919-7_8"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T17:35:37.174601+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "Deep active inference has been proposed as a scalable approach to perception and action that deals with large policy and state spaces. However, current models are limited to fully observable domains. In this paper, we describe a deep active inference model that can learn successful policies directly from high-dimensional sensory inputs. The deep learning architecture optimizes a variant of the expected free energy and encodes the continuous state representation by means of a variational autoencoder. We show"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T17:35:37.174701+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1007_978-3-030-64919-7_8> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/4f9063184ad4> .
}

