<http://activeinference.institute/nanopub/114c7f31fe20#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2306.04025> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2306.04025_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2306.04025_FEP_UNIVERSALITY> ns2:citationCount 1 ;
        ns2:claim "The paper discusses active inference within the broader framework of the Free Energy Principle but doesn't explicitly test universality. It focuses on applying the principle to AI design rather than demonstrating its universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We then discuss how active inference can be leveraged to design explainable AI systems, namely, by allowing us to model core features of ‘introspective’ processes and by generating useful, human-interpretable models of the processes involved in decision-making."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We first provide a brief overview of active inference, and in particular, of how it applies to the modeling of decision-making, introspection, as well as the generation of overt and covert actions."^^xsd:string .
}

