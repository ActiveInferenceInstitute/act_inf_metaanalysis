<http://activeinference.institute/nanopub/6413386cd932#assertion> {
    <http://activeinference.institute/ontology/paper/openalex_https___openalex.org_W2964662954> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W2964662954_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W2964662954_FEP_UNIVERSALITY> ns2:citationCount 5 ;
        ns2:claim "The paper explicitly frames the FEP as a general computational principle applicable to biological systems, including potentially ‘hypotheses on the origins of life’ and discussions about its implications for cognitive science."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "More recently, it has been proposed that Bayesian frameworks are not only useful for building descriptive models of biological functions, but that living systems themselves can be seen as Bayesian (inference) machines."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The free energy principle (FEP) was later extended to encompass hypotheses on the origins of life, and is nowadays discussed in the cognitive science community for its possible implications for theories of the mind."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .
}

