        ns2:claim "The paper's central argument is about predictive processing, which fundamentally relies on minimizing prediction errors through a hierarchical coding system."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "three features of predictive processing’s account of internal representation"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "First, I broaden the representation wars to include three foundational challenges to representational cognitive science. Second, I articulate three features of predictive processing’s account of internal representation that distinguish it from more orthodox representationalist frameworks."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s11023-017-9441-6> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11023-017-9441-6_PREDICTIVE_CODING> .
