    <http://activeinference.institute/ontology/assertion/llm_doi_10.1101_284562_FEP_UNIVERSALITY> ns2:citationCount 4 ;
        ns2:claim "The paper discusses the broader implications of active inference within a framework of general process theories, but doesn't directly test or address the universality claim."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Furthermore, it has been argued that one such proposal, active inference, combines both information and control theory..."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here we argue that if the active inference proposal is to be taken as a general process theory for biological systems, we need to consider how existing control theoretical approaches to biological systems relate to it."^^xsd:string .
}

