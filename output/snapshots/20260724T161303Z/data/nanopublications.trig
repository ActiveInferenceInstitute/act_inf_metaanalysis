        ns2:claim "The paper discusses a free energy principle-based model applied to robotic interaction, but doesn't explicitly test or argue for the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The model is based on the free energy principle..."^^xsd:string ;
