    <http://activeinference.institute/ontology/assertion/llm_arxiv_2209.02550_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper's technique (k-means clustering for policy embedding) is explicitly designed to improve the scalability of active inference by reducing the search space."^^xsd:string ;
