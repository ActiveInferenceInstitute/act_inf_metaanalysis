    <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.06323_MORPHOGENESIS> ns2:citationCount 0 ;
        ns2:claim "The paper suggests a mechanism for the emergence of adaptive capabilities at the origin of life, which aligns with the FEP's explanation of developmental processes."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"...offering a concrete scenario for the acquisition of adaptive capabilities at the origin of life.\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "These findings provide a constructive proof-of-concept for how a core process of active inference can emerge from a simple physicochemical system, offering a concrete scenario for the acquisition of adaptive capabilities at the origin of life."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/morphogenesis> .

    <http://activeinference.institute/ontology/paper/arxiv_2508.06323> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.06323_MORPHOGENESIS> .
