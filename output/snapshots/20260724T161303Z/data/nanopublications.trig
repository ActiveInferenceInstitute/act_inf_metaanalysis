<http://activeinference.institute/nanopub/b59e4c57c522#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1804.03826_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the agent minimizes prediction error by selecting appropriate actions, aligning with AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In this way, the top-down prediction originally comes from the prior experience from both perception and action representing the higher levels of this hierarchical cognition."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Therefore, this predictive stream in the sensorimotor loop is generated in a top-down manner. In this way, the top-down prediction originally comes from the prior experience from both perception and action representing the higher levels of this hierarchical cognition."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_1804.03826> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1804.03826_AIF_OPTIMALITY> .
}

