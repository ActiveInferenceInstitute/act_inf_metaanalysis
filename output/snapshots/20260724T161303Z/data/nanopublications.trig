<http://activeinference.institute/nanopub/b12133e7bb54#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "AXIOM's design – actively learning a world model to minimize prediction errors – directly aligns with the core principle of AIF that agents optimize their decisions based on minimizing uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The resulting approach, which we call AXIOM, combines the usual data efficiency and interpretability of Bayesian approaches with the across-task generalization usually associated with DRL."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Active inference offers a principled framework for integrating sensory information with prior knowledge to learn a world model and quantify the uncertainty of its own beliefs and predictions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2505.24784> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_AIF_OPTIMALITY> .
}

