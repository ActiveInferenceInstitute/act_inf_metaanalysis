<http://activeinference.institute/nanopub/ba17d1774484#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e21030257_AIF_OPTIMALITY> ns2:citationCount 66 ;
        ns2:claim "The paper explicitly connects PID control (a mechanism for achieving goals) to the free energy minimization framework of active inference, implying that agents are actively minimizing their surprise/error – a core tenet of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Specifically, we then show how these problems can be understood in terms of the optimisation of the precisions (inverse variances) modulating different prediction errors in the free energy functional."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "\"This more general interpretation also provides a new perspective on traditional problems of PID controllers such as parameter tuning as well as the need to balance performances and robustness conditions of a controller.\""^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e21030257> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e21030257_AIF_OPTIMALITY> .
}

