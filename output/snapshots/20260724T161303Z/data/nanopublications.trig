<http://activeinference.institute/nanopub/cbba27e30fd1#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2310.11070> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.11070_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.11070_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames its approach as an Active Inference method designed to achieve optimal resource allocation in a dynamic environment (UAV mobility and cognitive NOMA). This aligns directly with the core tenet of AIF – that agents driven by minimizing free energy will converge towards optimal decisions."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The UAV then uses this model for online inference. The method incrementally derives new generative models from training data by identifying dynamic equilibrium conditions between required actions and variables, represented within a unique dynamic Bayesian network."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We aim to maximize the cumulative sum rate by jointly optimizing the subchannel and power allocation based on the UAV's mobility at each time step."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

<http://activeinference.institute/nanopub/f604d3b34709#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.34229_KCA2522-9664.26.2.3> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.34229_KCA2522-9664.26.2.3_MORPHOGENESIS> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.34229_KCA2522-9664.26.2.3_MORPHOGENESIS> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly uses morphogenetic self-organization inspired by developmental biology and the FEP to generate neural networks."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…morphogen dynamics …morphogenetic self-organization"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "MorphoNAS…inspired by morphogenetic self-organization …morphogen dynamics"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/morphogenesis> .
}

<http://activeinference.institute/nanopub/c617b2672f2e#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.20944_preprints202405.0113.v1> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints202405.0113.v1_MARKOV_BLANKET_REALISM> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints202405.0113.v1_MARKOV_BLANKET_REALISM> ns2:citationCount 3 ;
        ns2:claim "The paper doesn't discuss Markov blankets or their relationship to physical boundaries. It focuses on system-level dynamics and resource management, not the underlying representational mechanisms."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "none"^^xsd:string ;
        ns2:evidenceStatus "no_evidence"^^xsd:string ;
        ns2:evidenceType "none"^^xsd:string ;
        ns2:sourceClaim "We explain how sustainability manifests at the level of an agent, and then at the level of collectives and systems."^^xsd:string .
}

