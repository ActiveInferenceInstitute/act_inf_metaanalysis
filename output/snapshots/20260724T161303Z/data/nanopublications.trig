        ns2:evidenceQuote "Describes an active strategy for minimizing uncertainty, central to AIF."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The objective is to design a sequential probing strategy that dynamically determines which processes to observe at each time and when to terminate the search so that the expected detection time is minimized under a constraint on the probability of misclassifying any process."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_1704.00766> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1704.00766_AIF_OPTIMALITY> .
}

