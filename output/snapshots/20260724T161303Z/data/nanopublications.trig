        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This framework has been successfully used to solve reinforcement learning and stochastic control problems, yet, the formal relation between active inference and reward maximisation has not been fully explicated."^^xsd:string .

