    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2020.00030_FEP_UNIVERSALITY> ns2:citationCount 42 ;
        ns2:claim "The paper presents a conceptual overview of the FEP without directly testing its universality across all systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "It provides a conceptual overview of the free energy principle; including Markov blankets, active inference, and-in particular-a discussion of selfhood and theory of mind..."^^xsd:string ;
