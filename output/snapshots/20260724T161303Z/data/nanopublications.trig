<http://activeinference.institute/nanopub/50fd67a258f7#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2201.01668> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2201.01668_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2201.01668_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper directly challenges the core assumption of AIF – that agents always optimize based on minimizing free energy – suggesting this interpretation lacks physical grounding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "\"What can we hope to learn about brains from the free energy principle?\""^^xsd:string ;
