<http://activeinference.institute/nanopub/129f62379e26#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2204.00032_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper's core mechanism – poisoning the training data to extract information – is a direct manifestation of predictive coding, where an agent attempts to minimize prediction errors by manipulating its environment."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "Our targeted attacks can poison <0.1% of the training dataset to boost the performance of inference attacks by 1 to 2 orders of magnitude."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "We introduce a new class of attacks on machine learning models. We show that an adversary who can poison a training dataset can cause models trained on this dataset to leak significant private details of training points belonging to other parties."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/arxiv_2204.00032> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2204.00032_PREDICTIVE_CODING> .
}

