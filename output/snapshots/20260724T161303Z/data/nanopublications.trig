<http://activeinference.institute/nanopub/e6e84d420cb3#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_s11229-016-1239-1> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-016-1239-1_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-016-1239-1_AIF_OPTIMALITY> ns2:citationCount 380 ;
        ns2:claim "The paper directly challenges the Helmholtzian interpretation of active inference as analogous to scientific hypothesis-testing, suggesting a more fundamental and less optimized process."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "Active inference, as understood by the free-energy principle, is incompatible with unconscious inference understood as analagous to scientific hypothesis-testing"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Active inference, as understood by the free-energy principle, is incompatible with unconscious inference understood as analagous to scientific hypothesis-testing..."^^xsd:string .
}

