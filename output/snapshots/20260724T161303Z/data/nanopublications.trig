<http://activeinference.institute/nanopub/8279fc62de2d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e24020301_SCALABILITY> ns2:citationCount 39 ;
        ns2:claim "The paper discusses deep learning and computational affordability, implying potential scalability but doesn't provide specific evidence of it."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/scalability> ;
        ns2:sourceClaim "This framework lends itself to being realized in silico, as it comprehends important aspects that make it computationally affordable, such as variational inference and amortized planning."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e24020301> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e24020301_SCALABILITY> .
}

<http://activeinference.institute/nanopub/34cf1fdf3ff2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01574_FEP_UNIVERSALITY> ns2:citationCount 31 ;
        ns2:claim "The paper focuses on a specific application of the Free Energy Principle – reward maximization in reinforcement learning – and doesn't broadly address universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Precisely, we show the conditions under which active inference produces the optimal solution to the Bellman equation, a formulation that underlies several approaches to model-based reinforcement learning and control."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this article, we clarify the connection between reward maximization and active inference by demonstrating how and when active inference agents execute actions that are optimal for maximizing reward."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01574> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01574_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/cbec2b3f388d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1523_jneurosci.0114-13.2013_FEP_UNIVERSALITY> ns2:citationCount 320 ;
        ns2:claim "The paper focuses on auditory perception and doesn't directly address the universal applicability of the FEP to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "These results provide convergent empirical support to promising recent accounts of attention and expectation in predictive coding."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We test these notions within auditory perception by independently manipulating top-down expectation and attentional precision alongside bottom-up stimulus predictability."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1523_jneurosci.0114-13.2013> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1523_jneurosci.0114-13.2013_FEP_UNIVERSALITY> .
}

