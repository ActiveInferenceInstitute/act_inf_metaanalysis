        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "To capture semantics, the paper defines a thermodynamic viability vector that bundles future environment, boundary configuration, nonequilibrium free energy, and internal/boundary entropy-production rates."^^xsd:string .

