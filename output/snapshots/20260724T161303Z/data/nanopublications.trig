    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.17735_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific motor control task within an Active Inference framework and doesn't directly address the universal applicability of the FEP to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Internal models of physical dynamics and extended predictive horizons can enhance interceptive control, providing a unified computational account of how the brain may integrate sensory uncertainty, physical expectations, and motor planning."^^xsd:string ;
