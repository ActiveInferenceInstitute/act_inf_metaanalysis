<http://activeinference.institute/nanopub/6235794b289f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_kf6wc_SCALABILITY> ns2:citationCount 23 ;
        ns2:claim "The paper's implementation successfully scales up predictive coding and active inference to a more complex reinforcement learning environment (cart-pole) than previously attempted."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "predictive coding and active inference approaches can be successfully scaled up to tasks more challenging than the mountain car"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "It demonstrates empirically that predictive coding and active inference approaches can be successfully scaled up to tasks more challenging than the mountain car (Friston 2009, 2012)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_kf6wc> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_kf6wc_SCALABILITY> .
}

<http://activeinference.institute/nanopub/423a396cd006#assertion> {
    <http://activeinference.institute/ontology/paper/openalex_https___openalex.org_W3196561192> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3196561192_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3196561192_FEP_UNIVERSALITY> ns2:citationCount 13 ;
        ns2:claim "The paper describes a specific application of the FEP (active inference) in robotic interaction, focusing on dynamics rather than asserting universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The model is based on the free energy principle such that a pair of interacting robots find themselves in a loop, attempting to predict and infer each other's actions using active inference."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We examine dyadic imitative interactions of robots using a variational recurrent neural network model based on the free energy principle."^^xsd:string .
}

