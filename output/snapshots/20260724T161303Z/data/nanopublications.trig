<http://activeinference.institute/nanopub/c49a01ab7f2a#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2506.06897> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.06897_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.06897_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on resilience within the FEP framework and doesn't directly address whether this applies universally to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The free energy principle is about existence and identity, and resilience is the condition under which things exist at all."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this paper we will articulate a view of resilience under the free energy principle and vice versa."^^xsd:string .
}

<http://activeinference.institute/nanopub/6d7aa15c3195#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.18905666_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.5281/zenodo.18905666"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T23:07:12.461130+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "Adaptive theories of biological and artificial systems typically model hierarchical inferenceas minimizing prediction error or variational free energy, with precision (inverse prediction-error variance) treated as a modulatory gain. We reformulate this perspective by showing that,under finite resource constraints, hierarchical adaptation is governed by a geometric conservationstructure of precision allocation. When total allocable precision is bounded, confidence cannotbe uniformly amplified; it must be red"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T23:07:12.461944+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.18905666> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/6d7aa15c3195> .
}

