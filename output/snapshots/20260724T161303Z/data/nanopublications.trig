<http://activeinference.institute/nanopub/556270968b1f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.12027_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that action-unaware agents can achieve comparable performance to action-aware agents, suggesting that active inference doesn't necessarily lead to optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "action-unaware agents can achieve performances comparable to action-aware ones while at a severe disadvantage"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "In this work we compare the performances of action-aware and action-unaware agents in two navigations tasks, showing how action-unaware agents can achieve performances comparable to action-aware ones while at a severe disadvantage."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2508.12027> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.12027_AIF_OPTIMALITY> .
}

