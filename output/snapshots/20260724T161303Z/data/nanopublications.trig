<http://activeinference.institute/nanopub/00747757cdad#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1371_journal.pcbi.1003157> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1003157_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1003157_FEP_UNIVERSALITY> ns2:citationCount 208 ;
        ns2:claim "The paper discusses general principles of neuronal efficiency and relates them to the Free Energy Principle without explicitly testing universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "an example can be found in neurons, where fluctuations in biophysical states limit the information they can encode--with almost 20-60% of the total energy allocated for the brain used for signalling purposes, either via action potentials or by synaptic transmission."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here, we consider the imperatives for neurons to optimise computational and metabolic efficiency, wherein benefits and costs trade-off against each other in the context of self-organised and adaptive behaviour."^^xsd:string .
}

