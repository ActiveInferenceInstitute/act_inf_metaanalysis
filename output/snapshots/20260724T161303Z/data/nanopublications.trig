<http://activeinference.institute/nanopub/813c0ed4d574#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2012.00151> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2012.00151_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2012.00151_AIF_OPTIMALITY> ns2:citationCount 479 ;
        ns2:claim "The paper directly proposes saccades as ‘optimal experiments’ designed to minimize entropy and achieve efficient sampling, aligning with the core tenets of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "This provides a plausible model of visual search that can be motivated from the basic principles of self-organized behavior: namely, the imperative to minimize the entropy of hidden states of the world and their sensory consequences."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This provides a plausible model of visual search that can be motivated from the basic principles of self-organized behavior: namely, the imperative to minimize the entropy of hidden states of the world and their sensory consequences."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

