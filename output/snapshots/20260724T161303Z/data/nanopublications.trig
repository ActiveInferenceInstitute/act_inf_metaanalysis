<http://activeinference.institute/nanopub/5c1d5162d306#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2203.12652_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:2203.12652"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T17:21:48.032980+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "For this, we make a distinction between attention and salience. Briefly, we associate attention with precision control, i.e., the confidence with which beliefs can be updated given sampled sensory data, and salience with uncertainty minimisation that underwrites the selection of future sensory data."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T17:21:48.033925+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_2203.12652> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/5c1d5162d306> .
}

<http://activeinference.institute/nanopub/4b64d7c32f7b#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00429-012-0475-5_FEP_UNIVERSALITY> ns2:citationCount 795 ;
        ns2:claim "The paper focuses on a specific system (motor cortex) and doesn't broadly address the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This process mirrors perceptual inference in sensory cortex, where descending connections convey predictions, while ascending connections convey prediction errors."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This explanation appeals to active inference, in which higher cortical levels send descending proprioceptive predictions, rather than motor commands."^^xsd:string .

