<http://activeinference.institute/nanopub/433b63f7f13c#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0033291718000430_PREDICTIVE_CODING> ns2:citationCount 212 ;
        ns2:claim "The paper explicitly uses predictive coding as a foundation for its model of mood, framing it as minimizing uncertainty about action consequences."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "By extending this reasoning, in a hierarchical setting, we suggest mood states act as (hyper) priors over uncertainty (i.e. emotions)."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "It has been proposed that emotions reflect the precision of - or certainty about - the predicted sensorimotor/interoceptive consequences of action."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1017_s0033291718000430> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0033291718000430_PREDICTIVE_CODING> .
}

