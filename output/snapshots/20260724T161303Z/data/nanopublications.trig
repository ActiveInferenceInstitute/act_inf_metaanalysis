<http://activeinference.institute/nanopub/367c844620ad#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.07559_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper claims an 'interpretable and scalable paradigm,' suggesting the framework can handle complex temporal behavior modeling, a key aspect of scalability."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "This work offers an interpretable and scalable paradigm for temporal behavior modeling under low-resource and noisy conditions, with broad applicability to wearable sensing, HCI, and clinical emotion monitoring."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This work offers an interpretable and scalable paradigm for temporal behavior modeling under low-resource and noisy conditions, with broad applicability to wearable sensing, HCI, and clinical emotion monitoring."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2603.07559> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.07559_SCALABILITY> .
}

<http://activeinference.institute/nanopub/36bdb3cc912d#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1073_pnas.2320239121> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1073_pnas.2320239121_SCALABILITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1073_pnas.2320239121_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that active inference can model complex collective behaviors without needing explicit behavioral rules, suggesting scalability to high-dimensional environments. The exploration of parameter space and model generalization hints at this."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "individual beliefs about uncertainty determine collective decision-making accuracy.  agents can update their generative model over time"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We also explore how individual beliefs about uncertainty determine collective decision-making accuracy. Finally, we show how agents can update their generative model over time, resulting in groups that are collectively more sensitive to external fluctuations and encode information more robustly."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .
}

