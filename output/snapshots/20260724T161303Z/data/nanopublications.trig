<http://activeinference.institute/nanopub/52587a766cbd#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1088_2634-4386_aca7de_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
