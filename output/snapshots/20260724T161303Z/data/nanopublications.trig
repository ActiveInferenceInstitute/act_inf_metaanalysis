        ns2:claim "The paper explicitly frames collective behavior as arising from minimizing surprise, a core tenet of the FEP. The demonstration of empirically observed phenomena through active inference strengthens this connection."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "to minimize surprise"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We introduce an approach to modelling collective behavior based on active inference. This cognitive framework casts behavior as the consequence of a single imperative: to minimize surprise."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.1073_pnas.2320239121> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1073_pnas.2320239121_FEP_UNIVERSALITY> .
