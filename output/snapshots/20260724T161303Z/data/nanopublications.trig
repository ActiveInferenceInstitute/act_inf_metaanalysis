        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "By coupling a generative perception model with an action-driven control policy, EASE dynamically aligns predictions with observations, enabling emergent behaviors such as implicit memory, target continuity, and adaptability to novel environments."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2506.17516> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.17516_AIF_OPTIMALITY> .
}

