<http://activeinference.institute/nanopub/9d7f1eb31cc3#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01618_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses Active Inference broadly as a theory of perception and decision-making without explicitly stating it applies universally. The focus is on scaling the framework for complex tasks, suggesting applicability across domains rather than a universal law."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Recently, research has been taking place to scale up this framework using Monte-Carlo tree search and deep learning. The goal of this activity is to solve more complicated tasks using deep active inference."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference is a theory of perception, learning and decision making, which can be applied to neuroscience, robotics, and machine learning."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2303.01618> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01618_FEP_UNIVERSALITY> .
}

