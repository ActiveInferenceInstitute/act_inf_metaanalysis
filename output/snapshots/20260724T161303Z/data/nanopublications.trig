    <http://activeinference.institute/ontology/assertion/llm_arxiv_2008.03238_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the FEP is being leveraged to develop a 'generic, generalizable model' applicable to 'living creatures,' suggesting universal applicability."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Given their ubiquity, we are concerned with distributed forms of representation (e.g., population codes), whereby patterns of ensemble activity in living tissue come to represent the causes of sensory input or data."^^xsd:string ;
