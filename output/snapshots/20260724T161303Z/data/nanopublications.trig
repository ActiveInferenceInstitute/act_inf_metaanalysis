<http://activeinference.institute/nanopub/34bed895d972#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2002.12636_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
