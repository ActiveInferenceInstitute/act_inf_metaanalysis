    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2014.01133_PREDICTIVE_CODING> ns2:citationCount 195 ;
        ns2:claim "The paper’s central argument – a generative model predicting sensations and minimizing prediction errors – is directly aligned with the core principles of predictive coding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "generates predictions of its sensations; sensory prediction errors"^^xsd:string ;
