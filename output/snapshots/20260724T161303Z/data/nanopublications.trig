<http://activeinference.institute/nanopub/f5b8fdf59bf1#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1002327_PREDICTIVE_CODING> ns2:citationCount 389 ;
        ns2:claim "The paper’s use of a hierarchical generative model with prediction errors aligns strongly with the core mechanism of predictive coding."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "These simulations provide a (Bayes-optimal) model of contextual uncertainty and set switching that can be quantified in terms of behavioural and electrophysiological responses."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This means that we can confuse agents by changing the context (order) in which cues are presented. These simulations provide a (Bayes-optimal) model of contextual uncertainty and set switching that can be quantified in terms of behavioural and electrophysiological responses."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1371_journal.pcbi.1002327> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1002327_PREDICTIVE_CODING> .
}

