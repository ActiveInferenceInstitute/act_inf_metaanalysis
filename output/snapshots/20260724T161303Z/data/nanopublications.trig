        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The free energy principle is a general mathematical theory of the necessary information-theoretic behaviours of systems that maintain a separation from their environment."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2107.00140> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2107.00140_FEP_UNIVERSALITY> .
}

