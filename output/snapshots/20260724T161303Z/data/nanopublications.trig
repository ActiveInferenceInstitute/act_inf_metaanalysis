<http://activeinference.institute/nanopub/5868cad46eb0#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.16086_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific image tokenization technique and doesn't directly address the universality of the FEP itself. While it utilizes free energy minimization, this is a common tool within the FEP framework, not a test of its fundamental principles."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "minimizes a variational free-energy objective, provably converging to nearest-neighbor quantization in the low-temperature limit"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "LGQ combines a token-level peakedness regularizer with a global usage regularizer to encourage confident yet balanced code utilization without imposing rigid grids."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2602.16086> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.16086_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/e5390fd87295#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2310.02946> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.02946_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.02946_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses Bethe-Kikuchi variational principles and their relationship to BP across different systems, suggesting a general framework but doesn't explicitly state universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The structure of BP equations is generalized to define continuous-time diffusions, solving localized versions of the max-entropy principle (A), the variational free energy principle (B), and a less usual equilibrium free energy principle (C)."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "A comprehensive picture of three Bethe-Kikuchi variational principles including their relationship to belief propagation (BP) algorithms on hypergraphs is given."^^xsd:string .
}

<http://activeinference.institute/nanopub/5c1d5162d306#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2203.12652_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses a new account of attention within the broader framework of the Free Energy Principle but doesn't explicitly address universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "For this, we make a distinction between attention and salience. Briefly, we associate attention with precision control, i.e., the confidence with which beliefs can be updated given sampled sensory data, and salience with uncertainty minimisation that underwrites the selection of future sensory data."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here, we reclaim salience as an active inference process that relies on two basic principles: uncertainty minimisation and rhythmic scheduling."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2203.12652> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2203.12652_FEP_UNIVERSALITY> .
}

