        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Modern models of active inference and the free energy principle (FEP) may shed some light on these processes."^^xsd:string .

