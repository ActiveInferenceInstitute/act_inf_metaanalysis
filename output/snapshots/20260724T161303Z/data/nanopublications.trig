<http://activeinference.institute/nanopub/3a94606f9837#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2604.13417_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The paper’s approach of extracting hidden states and calculating ‘Cognitive Dissonance Delta’ suggests a model of the internal representation *beyond* a simple Markov blanket; it posits an active inference process driving that representation."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "We demonstrate statistically significant detection of cognitive dissonance, highlight architecture-dependent Out-of-Distribution (OOD) generalization, and show that this framework adds negligible computational overhead to the active inference pipeline."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "By extracting hidden states during a model's forward pass, we calculate the ‘Cognitive Dissonance Delta’ -- the mathematical gap between an LLM’s outward semantic confidence (softmax probabilities) and its internal latent certainty (derived via linear probes)."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2604.13417> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2604.13417_MARKOV_BLANKET_REALISM> .
}

