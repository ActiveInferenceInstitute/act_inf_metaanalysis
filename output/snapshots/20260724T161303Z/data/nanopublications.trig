        ns2:claim "The paper argues that the proposed framework ‘effectively improves safety, efficiency, and smoothness of AV navigation compared to the state-of-the-art method,’ implying an optimality achieved through Active Inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "effectively improves safety, efficiency, and smoothness of AV navigation"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Simulation results indicate that our proposed framework effectively improves safety, efficiency, and smoothness of AV navigation compared to the state-of-the-art method."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2507.20850> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2507.20850_AIF_OPTIMALITY> .
