        ns2:claim "The paper explicitly argues that language syntax aligns with the FEP, suggesting a broader applicability of the principle."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…adhere to the FEP."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
