<http://activeinference.institute/nanopub/59b7da990a94#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2109.05866_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
