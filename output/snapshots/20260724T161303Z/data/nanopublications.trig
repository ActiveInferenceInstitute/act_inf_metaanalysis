        ns2:claim "The paper argues that Bayesian mechanics, rooted in the FEP, provides a framework applicable to *all* self-organising systems, suggesting a broad applicability of the principle."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The Hamiltonian...constitutes a class of generative models..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This work shows that the Hamiltonian of generic dynamical systems constitutes a class of generative models, thus rendering their Helmholtz energy equivalent to variational free energy under the identified generative model."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

