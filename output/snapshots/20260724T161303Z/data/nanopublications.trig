        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Specifically, we model the teammate’s decision process as follows: 1) Perception: observing environments; 2) Belief: forming beliefs; 3) Action: making decisions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2511.18761> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.18761_AIF_OPTIMALITY> .
}

