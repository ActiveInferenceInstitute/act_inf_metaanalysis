    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17880033_FEP_UNIVERSALITY> ns2:citationCount 2 ;
        ns2:claim "The paper contrasts its framework with FEP, suggesting it's a different approach but doesn’t explicitly endorse or refute the universality of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Rather than reducing intelligence to probabilistic inference in a fixed model, it treats emergent intelligence as the thermodynamically constrained organisation of information flows, structural growth, and boundary dynamics that support predictive, autopoietic semantics in open-ended systems."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Instead of assuming a fixed state space and model class, the paper introduces an open representation space of prefix-free codes for internal states, parameters, and architectures."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.17880033> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17880033_FEP_UNIVERSALITY> .
}

