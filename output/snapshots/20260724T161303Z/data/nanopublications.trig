        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "An approach to implementing variational Bayesian inference in biological systems is considered, under which the thermodynamic free energy of a system directly encodes its variational free energy. In the case of the brain, this assumption places constraints on the neuronal encoding of generative and recognition densities, in particular requiring a stochastic population code. The resulting relationship between thermodynamic and variational free energies is prefigured in mind-brain identity theses in philosoph"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:27:00.033376+00:00"^^xsd:dateTime ;
