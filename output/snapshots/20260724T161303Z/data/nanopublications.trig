    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2022.642397_AIF_OPTIMALITY> ns2:citationCount 31 ;
        ns2:claim "The paper heavily emphasizes active inference (AIF) and predictive processing models, which are fundamentally based on the idea that agents optimize their actions to minimize surprise or free energy – a core tenet of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "autoencoders (perceptual and active inference)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "I then go on to describe predictive processing models of brains and their connections to machine learning architectures, with particular emphasis on autoencoders (perceptual and active inference), turbo-codes (establishment of shared latent spaces for multi-modal integration and inferential synergy), and graph neural networks (spatial and somatic modeling and control)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

