<http://activeinference.institute/nanopub/3a45f5c8d39c#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2406.07577> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2406.07577_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2406.07577_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper introduces a formalization of active inference that expands its scope to include agents with structured interfaces and the ability to manage other agents. While this suggests broader applicability, it doesn't explicitly state universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "agents with structured interfaces (e.g. with 'mode-dependence', or that interact with computer APIs); agents that can manage other agents; and 'meta-agents', that use active inference to change their (internal or external) structure"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This opens the active inference landscape to new horizons, such as: agents with structured interfaces (e.g. with 'mode-dependence', or that interact with computer APIs); agents that can manage other agents; and 'meta-agents', that use active inference to change their (internal or external) structure."^^xsd:string .
}

<http://activeinference.institute/nanopub/9be0b8e18925#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1016_j.plrev.2024.01.004> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2024.01.004_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2024.01.004_FEP_UNIVERSALITY> ns2:citationCount 15 ;
        ns2:claim "The paper discusses the FEP as a framework for understanding behavior evolution in early Homo, suggesting its applicability to any self-organizing system. However, it doesn't explicitly test or argue for universal application."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We propose a parsimonious account that (1) could explain a particular, frequently-encountered, archeological outcome of behavior in early Homo - namely, the fashioning of a Paleolithic stone 'handaxe' - from a biological theoretic perspective informed by the free energy principle (FEP); and that (2) regards instances of the outcome as postdictive or retrodictive, circumstantial corroboration."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our proposal considers humankind evolving as a self-organizing biological ecosystem at a geological time-scale. We offer a narrative treatment of this self-organization in terms of the FEP."^^xsd:string .
}

