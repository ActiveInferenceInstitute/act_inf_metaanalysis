        ns2:claim "The paper demonstrates that active inference requires fewer iterations and performs better than standard bandit approaches when outcome preferences vary, suggesting it achieves a form of optimality within the context of the CMAB problem."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Results show that active inference requires fewer iterations than standard bandit approaches with real-world noisy and biased data..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Results show that active inference requires fewer iterations than standard bandit approaches with real-world noisy and biased data, and performs better when outcome preferences vary online by adapting the selection strategy to align with expert shifts."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_TRO.2025.3577041> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_TRO.2025.3577041_AIF_OPTIMALITY> .
