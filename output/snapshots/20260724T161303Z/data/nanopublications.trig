<http://activeinference.institute/nanopub/8b99fc46774c#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fncom.2015.00136> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2015.00136_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2015.00136_FEP_UNIVERSALITY> ns2:citationCount 126 ;
        ns2:claim "The paper presents a specific application of the FEP (active inference) to instrumental learning, focusing on dopamine's role. While it offers a resolution to existing paradoxes, it doesn’t directly address the broader claim of universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…extend an active inference scheme for solving Markov decision processes to include learning, and show that simulated dopamine dynamics strongly resemble those actually observed during instrumental conditioning."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We offer a resolution to this paradox based on an hypothesis that dopamine encodes the precision of beliefs about alternative actions..."^^xsd:string .
}

<http://activeinference.institute/nanopub/7180d9496312#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2402.03824> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.03824_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.03824_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly positions Embodied AI as a step towards AGI and aligns it with Active Inference, which is fundamentally about optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Embodied AI as the next fundamental step in the pursuit of Artificial General Intelligence"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We propose Embodied AI as the next fundamental step in the pursuit of Artificial General Intelligence, juxtaposing it against current AI advancements, particularly Large Language Models."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

