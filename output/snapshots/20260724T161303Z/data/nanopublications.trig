        ns2:evidenceQuote "…emulates the active inference process of IGM."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this study, we introduce an innovative BIQA metric that emulates the active inference process of IGM."^^xsd:string .
}

