    <http://activeinference.institute/ontology/paper/arxiv_2104.09163> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2104.09163_PREDICTIVE_CODING> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2104.09163_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper utilizes Predictive Coding as a foundational framework and describes how sensory predictions minimize prediction errors."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "We highlight how sequences of sensory predictions can act as rails guiding learning, control and online adaptation of motor trajectories."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We build upon the Active Inference (AIF) and Predictive Coding (PC) frameworks..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .
