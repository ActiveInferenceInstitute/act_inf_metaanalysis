        ns2:claim "The paper explicitly outlines two approaches to action selection within Active Inference – one based on maximizing entropy and the other minimizing error – both of which are fundamentally linked to achieving optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The second approach directly aims to formulate the action selection problem as an inference problem in the context of Bayesian brain theories, also known as Active Inference in the literature."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The second approach directly aims to formulate the action selection problem as an inference problem in the context of Bayesian brain theories, also known as Active Inference in the literature."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1371_journal.pcbi.1008420> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pcbi.1008420_AIF_OPTIMALITY> .
}

