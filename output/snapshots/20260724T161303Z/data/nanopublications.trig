    <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.02241_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The model's design – minimizing prediction errors via synaptic and structural plasticity – directly reflects the core principles of predictive coding."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "The network’s intrinsic drive to minimize prediction error and maintain homeostasis was sufficient to discover a stable balancing policy."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The model operates on a 2D grid where processing units, or cells, learn by minimizing local prediction errors."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/arxiv_2511.02241> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.02241_PREDICTIVE_CODING> .
}

