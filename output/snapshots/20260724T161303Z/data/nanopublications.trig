<http://activeinference.institute/nanopub/7951de6584ae#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2409.01066_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses active inference within a broader framework but doesn't explicitly test the universality of the FEP itself. It focuses on extending an existing model rather than establishing a fundamental principle."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We make use of recent work in recurrent switching linear dynamical systems (rSLDS) which implement end-to-end learning of meaningful discrete representations via the piecewise linear decomposition of complex continuous dynamics."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
