    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e22050564_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly uses predictive coding as a foundational framework for the model and highlights its role in minimizing prediction errors."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "partial models...habituated sensory-motor experiences...predictive coding (PC)...generative model"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
