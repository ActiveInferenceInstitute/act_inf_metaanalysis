        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "We show how any system with morphological degrees of freedom and locally limited free energy will, under the constraints of the free energy principle, evolve toward a neuromorphic morphology that supports hierarchical computations in which each level of the hierarchy enacts a coarse-graining of its inputs, and dually a fine-graining of its outputs. Such hierarchies occur throughout biology, from the architectures of intracellular signal transduction pathways to the large-scale organization of perception and"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T21:44:15.947190+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1088_2634-4386_aca7de> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/52587a766cbd> .
}

