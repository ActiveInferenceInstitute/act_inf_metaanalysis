    <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pone.0331047_AIF_OPTIMALITY> ns2:citationCount 2 ;
        ns2:claim "The paper explicitly states that agents derive policies by minimizing expected free energy, a core principle of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
