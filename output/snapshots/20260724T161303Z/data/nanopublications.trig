        ns2:claim "The paper reframes the Markov blanket as an 'abstraction' and introduces a 'compositional abstraction of the usual notion', suggesting it is not necessarily a reflection of real physical boundaries."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
