<http://activeinference.institute/nanopub/c32eb8b951db#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2211.10419> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2211.10419_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2211.10419_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific visual-motor task and doesn't broadly address the universality of the FEP across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"anticipatory behavior emerged only when required by limitations on the agent's movement capabilities, and only when the agent was able to estimate accumulated free energy over sufficiently long durations into the future\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our proposed \"neural\" AIF agent uses artificial neural networks to select actions on the basis of a very short term prediction of the information about the task environment that these actions would reveal along with a long-term estimate of the resulting cumulative expected free energy."^^xsd:string .
}

