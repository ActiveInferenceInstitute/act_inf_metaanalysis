    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17873550_AIF_OPTIMALITY> ns2:citationCount 4 ;
        ns2:claim "The paper's focus on a local thermodynamic state inequality and the explicit modeling of semantic processing as driven by viability-based prediction suggests an alternative to the optimization assumptions inherent in AIF. The emphasis on internal prediction rather than externally imposed goals challenges the notion of optimality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "Semantic activity is defined in terms of internal prediction of viability rather than an externally imposed ‘true’ future, implementing a strictly no-meta observability stance."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Semantic activity is defined in terms of internal prediction of viability rather than an externally imposed ‘true’ future, implementing a strictly no-meta observability stance."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.17873550> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.17873550_AIF_OPTIMALITY> .
}

