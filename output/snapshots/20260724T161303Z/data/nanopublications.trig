    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e22050564_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses general principles of Active Inference and Predictive Coding without explicitly testing universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "predictive coding (PC) and active inference (AIF) frameworks...generative model...prior distribution..."^^xsd:string ;
