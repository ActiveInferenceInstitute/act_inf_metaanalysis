        ns2:claim "The paper discusses a specific algorithmic agent within a constrained framework, but doesn't directly address the universality of the FEP across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The agent must find patterns and operate at some coarse-graining level to ensure survival."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Due to its limited resources, the agent must employ coarse-graining to transform data that initially appears incompressible into a compressible, aggregate form while retaining a non-trivial structure."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.31234_osf.io_3xy5d> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_3xy5d_FEP_UNIVERSALITY> .
}

