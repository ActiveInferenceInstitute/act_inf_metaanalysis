<http://activeinference.institute/nanopub/de80b80aeea4#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1075_tcb.00088.car_FEP_UNIVERSALITY> ns2:citationCount 20 ;
        ns2:claim "The paper introduces FEP and AIF as a framework for modeling translation processes, suggesting its applicability across various systems but doesn't explicitly state universality."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "The article introduces innovative methods for quantifying fundamental concepts of Relevance Theory (relevance, s-mode, and i-mode translation) and establishes their connection with the Monitor Model, framing relevance maximization as a special case of free energy minimization."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The article puts forth the Free Energy Principle (FEP) and Active Inference (AIF) as a promising framework for modeling these intricately embedded processes."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1075_tcb.00088.car> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1075_tcb.00088.car_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/6c9d01f4c8c7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1806.00201_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that an agent using learned attention (driven by novelty search) can outperform a passive approach in discovering the correct number, suggesting Active Inference leads to optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…guessing according to the learned attention profile performs active inference and can discover the correct number more quickly than an exact but passive approach."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "guessing according to the learned attention profile performs active inference and can discover the correct number more quickly than an exact but passive approach."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_1806.00201> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1806.00201_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/64b53f1b1bdd#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e25060928_AIF_OPTIMALITY> ns2:citationCount 8 ;
        ns2:claim "The paper explicitly connects translation policies to minimizing free energy via active inference, aligning with the core principle of AIF optimality."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Sequences of translation states combine into translation policies that reduce expected free energy"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "I map these concepts on the translation process and exemplify them with behavioural data. Sequences of TUs cluster into translation states (steady state, orientation, and hesitation). Drawing on active inference, sequences of translation states combine into translation policies that reduce expected free energy."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e25060928> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e25060928_AIF_OPTIMALITY> .
}

