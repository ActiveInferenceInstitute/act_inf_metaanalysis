    <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.20927_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames AIF as a foundational approach stemming from the Free Energy Principle, suggesting its applicability across diverse self-organizing systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "From the FEP perspective, systems that maintain their structural and functional integrity over time can, under suitable assumptions, be described as minimizing variational free energy (VFE)."^^xsd:string ;
