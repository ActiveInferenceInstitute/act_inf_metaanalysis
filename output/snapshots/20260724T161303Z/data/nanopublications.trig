<http://activeinference.institute/nanopub/665fbfb8e72c#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2025.1438080> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2025.1438080_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2025.1438080_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on epistemic emotions within a specific cognitive domain (inquiry) and doesn't directly address the universal applicability of the FEP to all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "By applying a Gaussian generative model with an additional uniform likelihood, we found that KLD and BS form an upward-convex function of surprise (minimized free energy and prediction error), similar to Berlyne's arousal potential functions, or the Wundt curve."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We consider that curiosity and interest drive to facilitate the cyclic process."^^xsd:string .
}

