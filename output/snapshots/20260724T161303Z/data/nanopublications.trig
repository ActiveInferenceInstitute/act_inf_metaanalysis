        ns2:prov_processing_date "2026-07-23T16:57:42.154483+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "By dynamic planning, we refer to the ability of the human brain to infer and impose motor trajectories related to cognitive decisions. A recent paradigm, active inference, brings fundamental insights into the adaptation of biological organisms, constantly striving to minimize prediction errors to restrict themselves to life-compatible states. Over the past years, many studies have shown how human and animal behaviors could be explained in terms of active inference - either as discrete decision-making or con"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T16:57:42.154615+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_2402.11658> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/07400faf2f6d> .
}

<http://activeinference.institute/nanopub/9bb9a2f68eac#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2302.05776> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2302.05776_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2302.05776_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses implications for cognitive psychology beyond neural networks, suggesting a broader applicability of the FEP but doesn't directly test its universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "This paper conjectures and validates a framework that allows for action during inference in supervised neural networks. Supervised neural networks are constructed with the objective to maximize their performance metric in any given task. This is done by reducing free energy and its associated surprisal during training."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We conclude by discussing the implications of the proposed stochastic surprisal in other areas of cognitive psychology including expectancy-mismatch and abductive reasoning."^^xsd:string .
}

<http://activeinference.institute/nanopub/e92982c72036#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s00422-012-0512-8_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
