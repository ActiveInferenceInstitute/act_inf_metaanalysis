<http://activeinference.institute/nanopub/d013adfbbbe2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.engappai.2026.114519_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper argues that active digital twins 'balance pragmatic exploitation and epistemic exploration' driven by free energy minimization, directly aligning with the core claim of AIF optimality – achieving optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The results demonstrate that active digital twins exhibit superior exploration capabilities compared to traditional reactive approaches, enabling enhanced autonomy and resilience."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "By modeling the dynamics of the coupled physical--digital system as a partially observable Markov decision process, active digital twins autonomously balance pragmatic exploitation (maximizing goal-directed utility) and epistemic exploration (actively resolving uncertainty)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1016_j.engappai.2026.114519> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.engappai.2026.114519_AIF_OPTIMALITY> .
}

