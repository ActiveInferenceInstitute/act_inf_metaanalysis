<http://activeinference.institute/nanopub/dee5ce6ba16e#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2109.04155_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
