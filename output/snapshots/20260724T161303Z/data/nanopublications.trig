<http://activeinference.institute/nanopub/4e3a5b63ed25#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2601.20985_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
