<http://activeinference.institute/nanopub/3d0e68bfa7b5#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10339-013-0571-3_PREDICTIVE_CODING> ns2:citationCount 515 ;
        ns2:claim "The paper describes active inference as a mechanism for minimizing prediction error within hierarchical cortical structures, aligning with the core principles of predictive coding."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…self-generated movements require predictions to override the sensory evidence that one is not actually moving."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "However, this creates a conflict between action and perception; in that, self-generated movements require predictions to override the sensory evidence that one is not actually moving."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s10339-013-0571-3> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10339-013-0571-3_PREDICTIVE_CODING> .
}

