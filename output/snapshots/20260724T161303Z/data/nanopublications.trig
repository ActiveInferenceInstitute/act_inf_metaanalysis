<http://activeinference.institute/nanopub/b835b122ad1e#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1606.04820_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
