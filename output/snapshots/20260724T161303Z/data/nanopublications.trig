        ns2:prov_processing_date "2026-07-23T23:44:26.026717+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "Minimal phenomenal experience (MPE), or \"pure consciousness,\" represents a fundamental form of conscious experience characterised by reflexive meta-awareness and the absence of many features of regular phenomenology. It has been described as e.g. non-conceptual, atemporal, non-egoic and aperspectival. This paper aims to develop a computational model of MPE using the mathematics of variational free energy minimization derived from the free energy principle (FEP). I employ a computational neurophenomenology a"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T23:44:26.027659+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.20944_preprints202411.0649.v3> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/e8a05b5f7333> .
}

