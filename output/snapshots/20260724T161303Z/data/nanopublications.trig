<http://activeinference.institute/nanopub/0f158be42a3c#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-032-16955-6_19_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the AIF agent achieves adaptive decision-making and goal-directed trajectories, aligning with the core premise of AIF optimality – minimizing surprise/prediction error."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Our model creates and updates a topological map of the environment in real-time, planning goal-directed trajectories to explore or reach objectives without requiring pre-training."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This paper introduces a bio-inspired agent based on the Active Inference Framework (AIF), which unifies mapping, localisation, and adaptive decision-making for autonomous navigation, including exploration and goal-reaching."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1007_978-3-032-16955-6_19> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-032-16955-6_19_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/a6a7a28f92c2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01698_SCALABILITY> ns2:citationCount 5 ;
        ns2:claim "The paper proposes a unified principle to integrate AIF and RL, aiming to overcome computational challenges associated with EFE in continuous spaces, suggesting improved scalability."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "…continuous space POMDP settings…rigorous theoretical analysis"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…overcoming their limitations in continuous space POMDP settings. We substantiate our findings with rigorous theoretical analysis, providing novel perspectives for using AIF in designing and implementing artificial agents."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01698> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01698_SCALABILITY> .
}

