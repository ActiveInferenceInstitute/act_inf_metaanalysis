<http://activeinference.institute/nanopub/42ebc9b4e7d4#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnsys.2022.787659_AIF_OPTIMALITY> ns2:citationCount 23 ;
        ns2:claim "The paper explicitly frames navigation and planning within the FEP-AI framework, emphasizing adaptive cognitive equilibration between exploration and exploitation, suggesting optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…balance model simplicity and accuracy"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…adaptive cognitive equilibration between assimilation and accommodation involves balancing tradeoffs between exploration and exploitation; this dynamic equilibrium may be near optimally realized in FEP-AI, wherein control systems governed by expected free energy objective functions naturally balance model simplicity and accuracy."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnsys.2022.787659> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnsys.2022.787659_AIF_OPTIMALITY> .
}

