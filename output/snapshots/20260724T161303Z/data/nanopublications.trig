    <http://activeinference.institute/ontology/assertion/llm_arxiv_2309.11263_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the UAV dynamically selects subchannels and power to *maximize* sum rate, a core tenet of Active Inference – agents optimizing their actions based on minimizing prediction error (free energy). The adaptive learning component further strengthens this connection."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "By leveraging the errors in each episode, the UAV can adapt its resource allocation policies and belief updating to improve its performance over time."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "the UAV dynamically selects discrete subchannels and continuous power to maximize the sum rate..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2309.11263> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2309.11263_AIF_OPTIMALITY> .
