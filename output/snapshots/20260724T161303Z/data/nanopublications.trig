<http://activeinference.institute/nanopub/01473b89c663#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1146_annurev-clinpsy-050718-095617_FEP_UNIVERSALITY> ns2:citationCount 347 ;
        ns2:claim "The paper focuses on a specific application of Active Inference (interoceptive psychopathology) and doesn't directly address the broader universality claim of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "individuals have abnormally strong expectations of the situations that elicit bodily change (i.e., hyperprecise priors), and they have great difficulty adjusting these expectations when the environment changes (i.e., context rigidity)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this review we propose that interoceptive psychopathology results from two primary interoceptive dysfunctions: First, individuals have abnormally strong expectations of the situations that elicit bodily change (i.e., hyperprecise priors), and second, they have great difficulty adjusting these expectations when the environment changes (i.e., context rigidity)."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1146_annurev-clinpsy-050718-095617> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1146_annurev-clinpsy-050718-095617_FEP_UNIVERSALITY> .
}

