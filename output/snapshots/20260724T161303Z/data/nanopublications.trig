<http://activeinference.institute/nanopub/607688f90c59#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_udc42_AIF_OPTIMALITY> ns2:citationCount 5 ;
        ns2:claim "The paper explicitly describes how ESMs function as predictive-memory systems and cybernetic controllers, aligning with the core principles of Active Inference – agents actively minimizing free energy through optimized inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…functioning as predictive-memory systems and cybernetic controllers"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "quasi-homuncular ESMs are suggested to constitute a major organizing principle for neural architectures due to their initial and ongoing significance for solutions to inference problems in cognitive (and affective) development."^^xsd:string ;
