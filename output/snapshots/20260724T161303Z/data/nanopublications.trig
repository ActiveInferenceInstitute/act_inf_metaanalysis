<http://activeinference.institute/nanopub/587497aa5eff#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2108.13343> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2108.13343_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2108.13343_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper presents the FEP as a general principle applicable to self-organizing systems, but doesn't definitively prove universality. It highlights applications in neuroscience and machine learning without asserting it applies to *all* such systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "any self-organizing system which can be statistically separated from its environment, and which maintains itself at a non-equilibrium steady state"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Specifically, it claims that any self-organizing system which can be statistically separated from its environment, and which maintains itself at a non-equilibrium steady state, can be construed as minimizing an information-theoretic functional -- the variational free energy -- and thus performing variational Bayesian inference to infer the hidden state of its environment."^^xsd:string .
}

