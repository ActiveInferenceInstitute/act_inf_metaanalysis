        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The aim of this paper is to leverage the free-energy principle and its corollary process theory, active inference, to develop a generic, generalizable model of the representational capacities of living creatures; that is, a theory of phenotypic representation."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.1016_j.neubiorev.2020.11.024> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.neubiorev.2020.11.024_FEP_UNIVERSALITY> .
}

