        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our approach employs a dual-policy architecture: one policy focuses on insertion, integrating force control and RL to guide the object into the hole, while the other policy performs active inference based on tactile feedback to align the tilted peg with the hole."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2309.15681> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2309.15681_FEP_UNIVERSALITY> .
