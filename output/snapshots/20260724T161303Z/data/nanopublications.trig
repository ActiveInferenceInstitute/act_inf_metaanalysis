    <http://activeinference.institute/ontology/assertion/llm_arxiv_2308.08029_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates SL outperforming other algorithms (BARL and SI) in a task requiring balance between reward harvesting and information gathering, suggesting AIF agents can achieve better outcomes."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "SL agents survive, on average, 8.2% longer than SI and 35% longer than Bayes-adaptive Reinforcement Learning"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
