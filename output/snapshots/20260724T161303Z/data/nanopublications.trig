<http://activeinference.institute/nanopub/03faa7d5199f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.15844_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper proposes a model (Quantal Hierarchy) that relaxes assumptions of best response and mutual consistency, suggesting agents can achieve better outcomes by adapting to bounded rationality – a core tenet of Active Inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Specifically, we propose an information-theoretic two-parameter model called the Quantal Hierarchy model, which can relax both mutual consistency and best response while still approximating level-$k$, QRE, or typical Nash equilibrium behaviour in the limiting cases."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Specifically, we propose an information-theoretic two-parameter model called the Quantal Hierarchy model, which can relax both mutual consistency and best response while still approximating level-$k$, QRE, or typical Nash equilibrium behaviour in the limiting cases."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

