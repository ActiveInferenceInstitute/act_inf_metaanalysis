        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We apply this concept to a typical problem known to the RL community, the mountain car problem..."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_1904.08149> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_1904.08149_FEP_UNIVERSALITY> .
}

