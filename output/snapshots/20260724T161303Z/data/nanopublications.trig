<http://activeinference.institute/nanopub/56c4582607c2#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.02197_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
