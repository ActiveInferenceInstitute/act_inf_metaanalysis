    <http://activeinference.institute/ontology/assertion/llm_doi_10.31234_osf.io_kr5xf_FEP_UNIVERSALITY> ns2:citationCount 11 ;
        ns2:claim "The paper focuses on resolving a specific tension within Active Inference (AI) regarding desires and folk psychology, not directly addressing the universality of the FEP itself."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "Despite their consistency, we further show how active inference may increase the granularity of folk-psychological descriptions by highlighting distinctions between drives to seek information vs. reward – and how it may also offer more precise, quantitative folk-psychological predictions."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference may increase the granularity of folk-psychological descriptions by highlighting distinctions between drives to seek information vs. reward – and how it may also offer more precise, quantitative folk-psychological predictions."^^xsd:string .
}

