<http://activeinference.institute/nanopub/ec2644164d41#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "AXIOM's core mechanism – learning a generative model to predict sensory input – is fundamentally based on predictive coding principles."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "The structure of the generative model is expanded online by growing and learning mixture models from single events and periodically refined through Bayesian model reduction to induce generalization."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The resulting approach, which we call AXIOM, combines the usual data efficiency and interpretability of Bayesian approaches with the across-task generalization usually associated with DRL."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/arxiv_2505.24784> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_PREDICTIVE_CODING> .
}

