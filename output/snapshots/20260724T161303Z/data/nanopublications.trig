    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_netn_a_00018_FEP_UNIVERSALITY> ns2:citationCount 422 ;
        ns2:claim "The paper focuses on neuronal message passing within the brain and doesn't directly address the broader applicability of the FEP to all self-organizing systems."^^xsd:string ;
