    <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2012_937860_FEP_UNIVERSALITY> ns2:citationCount 141 ;
        ns2:claim "The paper discusses the Free Energy Principle in a general context of self-organizing systems without explicitly testing its universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "However, the free energy account does not invoke reward or cost-functions..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The free energy account does not invoke reward or cost-functions from reinforcement-learning and optimal control theory."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1155_2012_937860> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2012_937860_FEP_UNIVERSALITY> .
