<http://activeinference.institute/nanopub/ba1bb3722796#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2312.12009_LANGUAGE_AIF> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
