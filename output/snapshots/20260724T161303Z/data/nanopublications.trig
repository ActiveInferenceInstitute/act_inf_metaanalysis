    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_tsp.2021.3095711_AIF_OPTIMALITY> ns2:citationCount 10 ;
        ns2:claim "The paper explicitly states that ActInf gives rise to a minimization problem including information-theoretic surprise and model-predictive control cost terms, suggesting it achieves optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…an information-theoretic surprise term and a model-predictive control cost term."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…ActInf gives rise to a minimization problem that includes both an information-theoretic surprise term and a model-predictive control cost term."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_tsp.2021.3095711> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_tsp.2021.3095711_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/7d579bd60712#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2003.03220_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses Active Inference as a general theory underpinning perception and action, but doesn't explicitly test universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "At its core, active inference is based on the principle that the brain is an approximate Bayesian inference engine, building an internal generative model to drive agents towards minimal surprise."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference is a theory that underpins the way biological agent's perceive and act in the real world."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2003.03220> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2003.03220_FEP_UNIVERSALITY> .
}

