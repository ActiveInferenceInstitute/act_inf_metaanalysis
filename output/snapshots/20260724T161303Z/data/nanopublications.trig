<http://activeinference.institute/nanopub/15cee83e7fb7#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2013.00547_PREDICTIVE_CODING> ns2:citationCount 279 ;
        ns2:claim "The paper directly discusses predictive coding as a core mechanism within the FEP and its role in self-modeling."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The free energy principle (FEP; Friston, 2010) is a novel unified theory of cortical function built upon the imperative that self-organizing systems entail hierarchical generative models of the causes of their sensory input, which are optimized by minimizing free energy as an approximation of the log-likelihood of the model."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The implementation of the FEP via predictive coding mechanisms..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnhum.2013.00547> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2013.00547_PREDICTIVE_CODING> .
}

