        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We offer a formal treatment of choice behavior based on the premise that agents minimize the expected free energy of future outcomes."^^xsd:string .

