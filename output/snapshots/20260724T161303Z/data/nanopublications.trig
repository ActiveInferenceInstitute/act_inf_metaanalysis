    <http://activeinference.institute/ontology/assertion/llm_arxiv_2006.04176_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates the use of deep active inference in complex, continuous state-spaces and high-dimensional environments (dSprites, Animal-AI), directly addressing scalability."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "In a more complex Animal-AI environment, our agents (using the same neural architecture) are able to simulate future state transitions and actions (i.e., plan), to evince reward-directed navigation - despite temporary suspension of visual input."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "For this, we present a neural architecture for building deep active inference agents operating in complex, continuous state-spaces using multiple forms of Monte-Carlo (MC) sampling."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2006.04176> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2006.04176_SCALABILITY> .
}

