    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_TSMC.2023.3312585_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that interactive inference aligns beliefs and behavioral strategies to ensure the success of joint action, which is a core tenet of Active Inference – agents are attempting to minimize their surprise (free energy) by optimizing their actions."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…hence ensuring the success of the joint action."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Over time, the interactive inference aligns both the beliefs and the behavioral strategies of the agents, hence ensuring the success of the joint action."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_TSMC.2023.3312585> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_TSMC.2023.3312585_AIF_OPTIMALITY> .
}

