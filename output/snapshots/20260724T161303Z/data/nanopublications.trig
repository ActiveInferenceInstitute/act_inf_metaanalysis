<http://activeinference.institute/nanopub/195a5d27a441#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.10088_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames planning and control as an inference process within Active Inference, suggesting that this approach *could* lead to optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…used to infer and plan with dynamic elements at different temporal scales."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…active inference approach that exploits discrete and continuous processing, based on three features: the representation of potential body configurations in relation to the objects of interest; the use of hierarchical relationships that enable the agent to easily interpret and flexibly expand its body schema for tool use; the definition of potential trajectories related to the agent’s intentions, used to infer and plan with dynamic elements at different temporal scales."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2402.10088> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.10088_AIF_OPTIMALITY> .
}

