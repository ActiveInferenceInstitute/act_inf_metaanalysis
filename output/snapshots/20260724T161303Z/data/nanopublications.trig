        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "at the same time uses the model to infer the current and future states and actions that maximize rewards"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2107.11811> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.11811_AIF_OPTIMALITY> .
