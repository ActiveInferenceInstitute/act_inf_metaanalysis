<http://activeinference.institute/nanopub/8c9b00f3183b#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2001.11841> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2001.11841_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2001.11841_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific implementation of Active Inference using deep learning and doesn't directly address the broader claim of universality for the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "However, current experiments are limited to predefined, often discrete, state spaces."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference is a process theory of the brain that states that all living organisms infer actions in order to minimize their (expected) free energy."^^xsd:string .
}

<http://activeinference.institute/nanopub/22d940c5a09c#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e23070830_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper posits that AIF agents achieve optimal decision-making through their dynamics, aligning with the core principle of AIF."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…these stepwise cognitive transitions in sophistication of cognitive ability are motivated by the types of advancements plausibly required for an AIF agent to persist and flourish in an environment populated by other AIF agents..."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…to posit a minimal agent-based model that simulates the relationship between local individual-level interaction and collective intelligence (operationalized as system-level performance)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e23070830> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e23070830_AIF_OPTIMALITY> .
}

