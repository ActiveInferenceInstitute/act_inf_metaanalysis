    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsif.2017.0376_FEP_UNIVERSALITY> ns2:citationCount 261 ;
        ns2:claim "The paper presents a specific example of Active Inference in visual foraging, focusing on uncertainty and sensory precision. While it highlights the robustness of this approach, it doesn't directly address the broader claim of universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "By simulating a noisy and volatile environment, we demonstrate how uncertainty influences optimal epistemic (visual) foraging."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We propose a generative model that represents the beliefs an agent might possess about their own uncertainty."^^xsd:string .
}

