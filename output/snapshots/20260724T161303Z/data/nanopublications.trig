        ns2:claim "The paper demonstrates a framework where the agent minimizes contrastive variational free energy and learns adaptive actions to reduce estimates from the expected free-energy model, suggesting optimal decision-making."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "minimizing the estimates provided by the expected free-energy model"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Meanwhile, the action model generates adaptive actions by learning from demonstrations, with the aim of minimizing the estimates provided by the expected free-energy model."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_access.2024.3477306> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_access.2024.3477306_AIF_OPTIMALITY> .
}

