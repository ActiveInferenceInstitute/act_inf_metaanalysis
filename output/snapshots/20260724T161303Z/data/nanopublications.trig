<http://activeinference.institute/nanopub/e8a05b5f7333#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints202411.0649.v3_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.20944/preprints202411.0649.v3"^^xsd:string ;
