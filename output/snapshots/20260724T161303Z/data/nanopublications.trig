<http://activeinference.institute/nanopub/64f40736fa76#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2404.12895_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
