<http://activeinference.institute/nanopub/575da6155add#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2407.02465_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper argues that naive belief sharing leads to negative social dynamics (echo chambers, self-doubt), suggesting that simply minimizing free energy doesn't necessarily lead to optimal decision-making in complex social contexts."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "naively sharing posterior beliefs can give rise to the negative social dynamics of echo chambers and self-doubt"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "naively sharing posterior beliefs can give rise to the negative social dynamics of echo chambers and self-doubt"^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2407.02465> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2407.02465_AIF_OPTIMALITY> .
}

