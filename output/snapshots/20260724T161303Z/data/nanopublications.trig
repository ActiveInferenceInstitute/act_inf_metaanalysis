        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "Cognition is governed by the Context-Content Uncertainty Principle (CCUP), a dynamical cycle aligning these parities."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Cognition is governed by the Context-Content Uncertainty Principle (CCUP), a dynamical cycle aligning these parities."^^xsd:string .
}

