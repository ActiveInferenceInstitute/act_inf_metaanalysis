<http://activeinference.institute/nanopub/c6e61bce646f#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2604.05251> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2604.05251_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2604.05251_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses the FEP as an interpretation of the LFT framework, but doesn't explicitly state that it applies universally."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "From a neuroscience point of view, our method modifies the Maximum Entropy model for neural networks so that also the time evolution of the system is taken into account and it can be interpreted as another version of the Free Energy principle (FEP)."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This framework is naturally tailored to interpret recordings from chronic multi-site BCIs, especially spike rasters from measurements of single neuron activity."^^xsd:string .
}

