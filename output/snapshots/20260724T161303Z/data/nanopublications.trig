    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.06331_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The paper proposes a mechanism (TFER) that actively shapes the model's internal representation to repel OOD data, directly challenging the notion of Markov blankets as static, real boundaries."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "parameter-efficient fine-tuning"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This approach is implemented via parameter-efficient fine-tuning, circumventing the prohibitive cost of full retraining."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2602.06331> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.06331_MARKOV_BLANKET_REALISM> .
