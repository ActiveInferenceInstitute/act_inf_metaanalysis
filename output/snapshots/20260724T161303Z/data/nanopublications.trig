    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2016.00056_PREDICTIVE_CODING> ns2:citationCount 178 ;
        ns2:claim "The paper describes active inference as minimizing prediction errors through a hierarchical process, aligning with the core principles of predictive coding."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "This means that evidence for competing hypotheses about the scene has to be accumulated sequentially, calling upon both prediction (planning) and postdiction (memory)."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We consider the (difficult) problem of categorizing a scene, based on the spatial relationship among visual objects where, crucially, visual cues are sampled myopically through a sequence of saccadic eye movements."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fncom.2016.00056> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fncom.2016.00056_PREDICTIVE_CODING> .
}

