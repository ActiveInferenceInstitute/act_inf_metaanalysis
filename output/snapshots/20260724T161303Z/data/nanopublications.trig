<http://activeinference.institute/nanopub/07400faf2f6d#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2402.11658_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:2402.11658"^^xsd:string ;
