<http://activeinference.institute/nanopub/2f8579529a40#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.05053_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
