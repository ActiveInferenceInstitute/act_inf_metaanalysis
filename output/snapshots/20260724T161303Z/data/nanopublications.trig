<http://activeinference.institute/nanopub/d8a3905fc7f7#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frai.2020.00030_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
