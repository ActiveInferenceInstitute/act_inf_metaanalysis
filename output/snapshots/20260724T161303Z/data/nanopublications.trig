<http://activeinference.institute/nanopub/dd95e989a83a#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.00401_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that ToM agents cooperate better and achieve improved collision avoidance/foraging due to their ability to infer others' beliefs and plan accordingly – a core tenet of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Crucially, ToM agents accomplish this by inferring others' beliefs solely from observable behaviour and considering them when planning their own actions."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Results suggest that ToM agents cooperate better compared to non-ToM counterparts by being able to avoid collisions and reduce redundant efforts."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2508.00401> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2508.00401_AIF_OPTIMALITY> .
}

