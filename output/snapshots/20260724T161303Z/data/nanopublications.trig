<http://activeinference.institute/nanopub/379bbf4f5984#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-030-64919-7_8_AIF_OPTIMALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
