        ns2:prov_source_passage "In this comment on \"The Markov blanket trick: On the scope of the free energy principle and active inference\" by Raja and colleagues (2021) in Physics of Life Reviews, I argue that the argument presented by the authors is valid; however, I claim that the argument contains a flawed premise, which undermines their conclusions. In addition, I argue that work on the FEP that has appeared since the target paper was published underwrites a cogent response to the issues that are raised by Raja and colleagues."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T23:27:54.839757+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2208.04275> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/d8b1508a4b57> .
}

