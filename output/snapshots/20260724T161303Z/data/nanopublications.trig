        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "we propose an enactive interpretation of active inference - what might be called <i>enactive inference</i>. In active inference under the FEP, the generative and recognition models are best cast as realising inference and control - the self-organising, belief-guided selection of action policies - and do not have the properties ascribed by structural representationalists."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:39:39.545773+00:00"^^xsd:dateTime ;
