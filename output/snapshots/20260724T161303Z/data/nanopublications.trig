        ns2:claim "The paper’s focus on geometric precision allocation and cross-level coupling suggests a model of hierarchical inference that doesn't align with the idea of Markov blankets representing real physical boundaries."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceStatus "no_evidence"^^xsd:string ;
        ns2:evidenceType "none"^^xsd:string ;
        ns2:sourceClaim "Imposing a globalprecision budget introduces a structural constraint on total confidence, inducing competitivecross-level coupling."^^xsd:string .
}

