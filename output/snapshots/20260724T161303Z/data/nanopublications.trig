    <http://activeinference.institute/ontology/assertion/llm_doi_10.1177_1059712319862774_PREDICTIVE_CODING> ns2:citationCount 223 ;
        ns2:claim "The paper argues against a structural representationalist interpretation of generative models, which aligns with the core tenets of predictive coding, but suggests it's a misinterpretation."^^xsd:string ;
