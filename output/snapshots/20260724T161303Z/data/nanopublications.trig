        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "active inference formulations of decision processes (which do have desires within folk psychology)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "active inference formulations of decision processes (which do have desires within folk psychology)"^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s11229-022-03480-w> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-022-03480-w_AIF_OPTIMALITY> .
