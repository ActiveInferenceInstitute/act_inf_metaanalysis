        ns2:prov_source_passage "The free energy principle (FEP; Friston, 2010) is a novel unified theory of cortical function built upon the imperative that self-organizing systems entail hierarchical generative models of the causes of their sensory input, which are optimized by minimizing free energy as an approximation of the log-likelihood of the model."^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:40:12.565618+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.3389_fnhum.2013.00547> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/15cee83e7fb7> .
}

<http://activeinference.institute/nanopub/bbadb1259c8d#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.3390_e27050461> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e27050461_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e27050461_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses applications across diverse domains (machine learning, portfolio theory), suggesting broad applicability of the underlying principle but doesn't explicitly test universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"Shannon information is similar to free energy; semantic information to free energy in local equilibrium systems; and information efficiency to the efficiency of free energy in performing work.\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Insights from statistical physics are discussed: Shannon information is similar to free energy; semantic information to free energy in local equilibrium systems; and information efficiency to the efficiency of free energy in performing work."^^xsd:string .
}

