    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fsoc.2023.1269621_LANGUAGE_AIF> ns2:citationCount 2 ;
        ns2:claim "The paper posits that belief in shared norms (a form of symbolic representation) is a motivational cornerstone of language, suggesting AIF can explain its origins and function."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"...shared belief in moral conceptions, i.e., what amounts to a religious faith...\""^^xsd:string ;
