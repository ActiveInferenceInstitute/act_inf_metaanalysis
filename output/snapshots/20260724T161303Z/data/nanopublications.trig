<http://activeinference.institute/nanopub/15eacd2ac4a8#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1016_j.physrep.2023.07.001> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.physrep.2023.07.001_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.physrep.2023.07.001_FEP_UNIVERSALITY> ns2:citationCount 140 ;
        ns2:claim "The paper presents a foundational description of the FEP but doesn't explicitly address its universal applicability."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "These steps entail (i) establishing a particular partition of states based upon conditional independencies that inherit from sparsely coupled dynamics, (ii) unpacking the implications of this partition in terms of Bayesian inference and (iii) describing the paths of particular states with a variational principle of least action."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Teleologically, the free energy principle offers a normative account of self-organisation in terms of optimal Bayesian design and decision-making, in the sense of maximising marginal likelihood or Bayesian model evidence."^^xsd:string .
}

