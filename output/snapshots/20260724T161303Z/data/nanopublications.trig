    <http://activeinference.institute/ontology/paper/doi_10.1080_01691864.2023.2225175> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_01691864.2023.2225175_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_01691864.2023.2225175_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames the robot's action as ‘active exploration based on information gain,’ suggesting a mechanism for optimizing decision-making under uncertainty – a core tenet of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "information gain-based destination determination"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "we propose an active inference method, referred to as spatial concept formation with information gain-based active exploration (SpCoAE) that combines sequential Bayesian inference using particle filters and information gain-based destination determination in a probabilistic generative model."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

