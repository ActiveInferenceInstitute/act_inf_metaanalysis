<http://activeinference.institute/nanopub/9740cd87dc67#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.07065_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application of Active Inference within an MDP framework – incentive design for inference – and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "To improve inference accuracy and efficiency, the leader can offer side payments (incentives) to the followers such that different types of them, under the incentive design, can exhibit diverging behaviors that facilitate the leader's inference task."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We show the problem of active inference through incentive design can be formulated as a special class of leader-follower games, where the leader's objective is to balance the information gain and cost of incentive design."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2502.07065> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.07065_FEP_UNIVERSALITY> .
}

