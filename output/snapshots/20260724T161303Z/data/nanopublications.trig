        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/predictive_coding> ;
        ns2:sourceClaim "…mediated through recent developments in predictive processing and the free energy principle."^^xsd:string .

