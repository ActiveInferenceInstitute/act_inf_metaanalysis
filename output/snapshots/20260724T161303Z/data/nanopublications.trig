    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s10539-022-09864-z_FEP_UNIVERSALITY> ns2:citationCount 17 ;
        ns2:claim "The paper provides a foundational overview of Active Inference without explicitly endorsing or refuting the universality claim. It focuses on analysis and critical evaluation."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"…in three ways. First, we give simplified versions of its core mathematical models. Second, we outline the historical development of active inference and its relationship to other theoretical approaches. Third, we describe three different kinds of claim—labelled mathematical, empirical and general—routinely made by proponents of the framework, and suggest dialectical links between them.\""^^xsd:string ;
        ns2:evidenceStatus "no_evidence"^^xsd:string ;
        ns2:evidenceType "none"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here, we lay the ground for proper critical analysis of active inference..."^^xsd:string .
}

