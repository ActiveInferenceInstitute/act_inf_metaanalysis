<http://activeinference.institute/nanopub/26863dcc39a3#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_978-3-032-16955-6_19> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-032-16955-6_19_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-032-16955-6_19_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses a general navigation framework based on AIF without explicitly claiming universality of the FEP itself. It focuses on application within robotics."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Our model creates and updates a topological map of the environment in real-time, planning goal-directed trajectories to explore or reach objectives without requiring pre-training."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This paper introduces a bio-inspired agent based on the Active Inference Framework (AIF), which unifies mapping, localisation, and adaptive decision-making for autonomous navigation, including exploration and goal-reaching."^^xsd:string .
}

