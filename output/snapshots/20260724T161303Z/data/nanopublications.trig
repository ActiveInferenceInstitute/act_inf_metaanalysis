        ns2:claim "The paper explicitly uses the Free Energy Principle (FEP) as the foundation for its computational model of MPE, suggesting a universal application."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "I employ a computational neurophenomenology approach, formalising key phenomenological features of MPE within the active inference framework."^^xsd:string ;
