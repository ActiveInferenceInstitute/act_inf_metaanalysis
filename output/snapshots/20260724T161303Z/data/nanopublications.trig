    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsfs.2022.0077_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that agents learn by minimizing Free Energy (surprisal), which aligns with the concept of optimal decision-making under uncertainty within Active Inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "agents learn and act by minimizing an upper bound on their surprisal, i.e. their Free Energy."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "agents learn and act by minimizing an upper bound on their surprisal, i.e. their Free Energy."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1098_rsfs.2022.0077> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rsfs.2022.0077_AIF_OPTIMALITY> .
