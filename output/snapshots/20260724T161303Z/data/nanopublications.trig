    <http://activeinference.institute/ontology/assertion/llm_arxiv_1904.08149_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper introduces active inference as a general theory from neuroscience, but doesn't explicitly state that it applies universally."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…casting action selection as an inference problem."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
