    <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01618_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The paper's efforts to scale Active Inference using Monte Carlo tree search and deep learning directly address the scalability hypothesis by attempting to apply the framework to complex environments like dSprites."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "First, we review the existing literature, then, we progresively build a deep active inference agent."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Recently, research has been taking place to scale up this framework using Monte-Carlo tree search and deep learning. The goal of this activity is to solve more complicated tasks using deep active inference."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/arxiv_2303.01618> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.01618_SCALABILITY> .
}

