    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-019-02115-x_FEP_UNIVERSALITY> ns2:citationCount 156 ;
        ns2:claim "The paper discusses a multiscale integrationist interpretation of cognitive boundaries but doesn't directly address the universality of the FEP itself. It focuses on *how* to define those boundaries within an Active Inference framework."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Our approach does not privilege any given boundary (whether it be that of the brain, body, or world), nor does it argue that all boundaries are equally prescient."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We develop our positive multiscale account."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1007_s11229-019-02115-x> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-019-02115-x_FEP_UNIVERSALITY> .
}

