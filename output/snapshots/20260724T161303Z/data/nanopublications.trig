        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "regulation of complexity in the evidence lower bound of an agent’s model should affect the strength of the agent’s SoA"^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnbot.2020.00061> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnbot.2020.00061_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/5abb19a7bb9f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-030-64919-7_10_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific illusion (RHI) and a particular model implementation within Active Inference. While the RHI provides an interesting case study, it doesn't definitively prove the universal applicability of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…that is able to account for these results."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We describe a deep active inference agent in a virtual environment, which we subjected to the rubber-hand illusion, that is able to account for these results."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1007_978-3-030-64919-7_10> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-030-64919-7_10_FEP_UNIVERSALITY> .
}

