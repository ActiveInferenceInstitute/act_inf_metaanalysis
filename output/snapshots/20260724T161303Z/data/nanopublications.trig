        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this paper, we examine two decision-making schemes in active inference based on 'planning' and 'learning from experience'."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.3390_e26060484> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e26060484_FEP_UNIVERSALITY> .
