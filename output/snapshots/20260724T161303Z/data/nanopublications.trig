<http://activeinference.institute/nanopub/33892a7d8562#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frai.2020.00030_PREDICTIVE_CODING> ns2:citationCount 140 ;
        ns2:claim "The paper describes streams of consciousness as an evolving generation of sensorimotor predictions and proposes turbo coding via loopy message-passing over predictive (autoencoding) networks, directly relating to the core mechanism of predictive coding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "turbo coding via loopy message-passing over predictive (autoencoding) networks"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "streams of consciousness may emerge as an evolving generation of sensorimotor predictions"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_frai.2020.00030> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frai.2020.00030_PREDICTIVE_CODING> .
