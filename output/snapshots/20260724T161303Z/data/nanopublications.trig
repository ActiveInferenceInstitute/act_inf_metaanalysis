<http://activeinference.institute/nanopub/ccb6347a126a#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.1906.10184_FEP_UNIVERSALITY> ns2:citationCount 237 ;
        ns2:claim "The paper explicitly states a theory of 'every thing' and proposes a single FEP framework encompassing quantum, statistical, and classical mechanics, suggesting universal applicability."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "These descriptions are complemented with a Bayesian mechanics for autonomous or active things. Although this work provides a formulation of every thing, its main contribution is to examine the implications of Markov blankets for self-organisation to nonequilibrium steady-state."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This monograph attempts a theory of every 'thing' that can be distinguished from other things in a statistical sense."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.1906.10184> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.1906.10184_FEP_UNIVERSALITY> .
}

