<http://activeinference.institute/nanopub/019f01276695#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.08014_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that AIF minimizes free energy functionals, which aligns with the concept of optimality in an uncertain environment."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Active Inference (AIF) is a corollary of the FEP that specifically details how systems that are able to plan for the future (agents) function by minimising particular free energy functionals that incorporate information seeking components."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Active Inference (AIF) is a corollary of the FEP that specifically details how systems that are able to plan for the future (agents) function by minimising particular free energy functionals that incorporate information seeking components."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2306.08014> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.08014_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/b4971f87288a#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01698_AIF_OPTIMALITY> ns2:citationCount 5 ;
        ns2:claim "The paper argues that AIF minimizes expected free energy, which aligns with reward maximization and exploration, suggesting optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…minimizing a function called expected free energy (EFE)…reward-maximizing (or exploitative) behavior…information-seeking (or exploratory) behavior"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…directs agents to select actions by minimizing a function called expected free energy (EFE)… This supplies reward-maximizing (or exploitative) behavior, as in RL, with information-seeking (or exploratory) behavior."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01698> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01698_AIF_OPTIMALITY> .
}

