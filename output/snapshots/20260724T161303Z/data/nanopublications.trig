    <http://activeinference.institute/ontology/assertion/llm_arxiv_2208.08713_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that an agent minimizes variational free energy, implying optimality in its behavior given uncertainty."^^xsd:string ;
