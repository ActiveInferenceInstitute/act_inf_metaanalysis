        ns2:claim "The paper discusses efficiency in language design, which could relate to optimality within active inference, but doesn't directly test or confirm this."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "ground core principles of efficient syntactic computation within active inference"^^xsd:string ;
