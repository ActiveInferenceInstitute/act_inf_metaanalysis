<http://activeinference.institute/nanopub/5d52462240dd#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2412.10425_FEP_UNIVERSALITY> ns2:citationCount 1 ;
        ns2:claim "The paper frames its approach within the broader Free Energy Principle, suggesting universality but doesn't explicitly test it against other systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "By framing the agent’s learning through the free energy principle..."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We enable systematic exploration of prompt combinations and search strategies by framing the agent’s learning through the free energy principle."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2412.10425> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2412.10425_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/12d9054be225#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2011.00218_AIF_OPTIMALITY> ns2:citationCount 173 ;
        ns2:claim "The paper proposes that motor preparation is an attentional phenomenon driven by active inference, suggesting a mechanism for achieving optimal decision-making (efficient movement) under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…where predictions of proprioceptive signals are fulfilled by peripheral motor reflexes."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This rests on a view of motor control as active inference, where predictions of proprioceptive signals are fulfilled by peripheral motor reflexes."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fpsyg.2011.00218> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fpsyg.2011.00218_AIF_OPTIMALITY> .
}

