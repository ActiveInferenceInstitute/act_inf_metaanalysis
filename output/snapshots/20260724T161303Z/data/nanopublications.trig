    <http://activeinference.institute/ontology/paper/arxiv_2509.14201> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2509.14201_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2509.14201_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application (UAVs) and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "By formulating a unified generative model, the problem reduces to minimizing variational free energy for inference and expected free energy for action planning."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We introduce the active inference framework (AIF) into SCC-enabled unmanned aerial vehicle (UAV) systems for joint state estimation, control, and sensing resource allocation."^^xsd:string .
}

