    <http://activeinference.institute/ontology/assertion/llm_arxiv_2510.25053_SCALABILITY> ns2:citationCount 0 ;
        ns2:claim "The model's ability to handle 30,000-dimensional inputs without dimensionality reduction demonstrates scalability. The hierarchical architecture is designed for processing complex sensory information."^^xsd:string ;
