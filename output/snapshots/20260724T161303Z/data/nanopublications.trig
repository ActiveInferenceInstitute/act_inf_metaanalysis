    <http://activeinference.institute/ontology/assertion/llm_doi_10.1101_2025.08.06.668947_FEP_UNIVERSALITY> ns2:citationCount 2 ;
        ns2:claim "The paper explicitly demonstrates the FEP's application in a behaving animal (zebrafish) and suggests its validity extends beyond in vitro experiments, bolstering the universality claim."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "These agents recapitulated individual variability in zebrafish neuronal dynamics and behaviour by identifying subject-specific prior and posterior beliefs."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Leveraging the formal equivalence between neural network dynamics and variational Bayesian inference, we constructed biologically plausible synthetic agents capable of active inference."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.1101_2025.08.06.668947> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1101_2025.08.06.668947_FEP_UNIVERSALITY> .
}

