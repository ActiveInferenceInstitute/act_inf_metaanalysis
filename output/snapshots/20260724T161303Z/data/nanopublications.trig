<http://activeinference.institute/nanopub/ab83ced387ca#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.10571_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper frames sensory adaptation within a field-theoretic framework based on the variational free-energy principle, suggesting its applicability across diverse biological systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Using an Onsager--Machlup path-integral formalism, we show that the resulting adaptive dynamics are mathematically equivalent to a class of model reference adaptive control schemes and can be interpreted as a dynamic renormalization of the system's Green’s function."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Here, we present a field-theoretic framework in which sensory adaptation emerges from a variational free-energy principle..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/arxiv_2602.10571> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.10571_FEP_UNIVERSALITY> .
}

<http://activeinference.institute/nanopub/b5104eaf41ca#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2023.1170480_CLINICAL_UTILITY> ns2:citationCount 3 ;
        ns2:claim "The paper explicitly discusses the potential theoretical and clinical significance of psychodynamic approaches informed by Active Inference for understanding and treating psychiatric conditions."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Ciera and colleagues examine the functional brain changes accompanying different mental disorders with fMRI, through a meta-analysis and systematic review, to better understand the general neural mechanism involved in psychotherapy and the potential neural differences between psychodynamic and non-psychodynamic approaches."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Potential theoretical and clinical significance for psychoanalysis and psychodynamic neuroscience, is discussed."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/clinical_utility> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_fnhum.2023.1170480> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnhum.2023.1170480_CLINICAL_UTILITY> .
}

<http://activeinference.institute/nanopub/cf1f51684adc#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2503.22181> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.22181_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.22181_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses the FEP as a unifying principle of brain function and its application to AI ethics, but doesn't explicitly state or test universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "we support the development of unified and incremental development of AI ethics. By classifying and defining uncertainty along two axes - (1) first, second, and third person perspectives, and (2) the difficulty of inference based on the depth of information –"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "By considering the reduction of uncertainty as a unifying principle of brain function, we aim to implement the e-person architecture."^^xsd:string .
}

