<http://activeinference.institute/nanopub/43121ff26cb9#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1016_j.engappai.2026.114519> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.engappai.2026.114519_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.engappai.2026.114519_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses active digital twins as an application of Active Inference, but doesn't explicitly address the universality claim of the FEP itself. It focuses on a specific system (coupled physical-digital) and its behavior."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "By modeling the dynamics of the coupled physical--digital system as a partially observable Markov decision process, active digital twins autonomously balance pragmatic exploitation (maximizing goal-directed utility) and epistemic exploration (actively resolving uncertainty)."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference is a neuroscience-inspired Bayesian framework for probabilistic reasoning and predictive modeling that unifies inference, decision-making, and learning under a single free energy minimization objective."^^xsd:string .
}

