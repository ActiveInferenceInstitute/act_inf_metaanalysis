<http://activeinference.institute/nanopub/7b1746e21b9d#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2404.12895_CLINICAL_UTILITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the computational model can explain numerous alterations of subjective temporal experience, including those associated with psychiatric conditions (e.g., near death-experiences, psychopathologies), suggesting clinical relevance."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "…numerous systematic and domain-specific alterations of subjective temporal experience are computationally explained in a unified manner, as enabled by integration with current active inference accounts mapping onto the respective domains. This concerns, next to attentional and central tendency effects, the temporality-modulating role of valence, impulsivity, boredom, flow-states, near death-experiences, and various psychopathologies…"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/clinical_utility> .

    <http://activeinference.institute/ontology/paper/arxiv_2404.12895> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2404.12895_CLINICAL_UTILITY> .
}

