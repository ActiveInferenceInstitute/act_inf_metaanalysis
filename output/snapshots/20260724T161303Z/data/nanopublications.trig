<http://activeinference.institute/nanopub/54b95f360227#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1109_LRA.2025.3636032> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2025.3636032_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2025.3636032_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific robotic application of Active Inference and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The world model encodes environmental dynamics into hidden state representations at slow and fast timescales. The action model compresses action sequences into abstract actions using vector quantization, and the abstract world model predicts future slow states conditioned on the abstract action."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We propose a novel deep active inference framework that consists of a world model, an action model, and an abstract world model."^^xsd:string .
}

<http://activeinference.institute/nanopub/22d2a32ffb17#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1007_s11229-024-04679-9> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-024-04679-9_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_s11229-024-04679-9_AIF_OPTIMALITY> ns2:citationCount 8 ;
        ns2:claim "The paper explicitly uses the concept of 'optimal grip on a field of affordances' and links it to active inference’s goal of achieving an optimal state."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "in an adaptive way that supports an optimal grip on a field of affordances"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We argue that ambient smart environments should be understood as playing an'upstream' role, shaping an agent's field of affordances in real time, in an adaptive way that supports an optimal grip on a field of affordances."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

