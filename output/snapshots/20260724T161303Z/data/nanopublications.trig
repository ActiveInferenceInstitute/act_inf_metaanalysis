<http://activeinference.institute/nanopub/11fae74bbd41#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2503.06049_CLINICAL_UTILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "arxiv:2503.06049"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T16:41:05.121356+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "Studying psychiatric illness has often been limited by difficulties in connecting symptoms and behavior to neurobiology. Computational psychiatry approaches promise to bridge this gap by providing formal accounts of the latent information processing changes that underlie the development and maintenance of psychiatric phenomena. Models based on these theories generate individual-level parameter estimates which can then be tested for relationships to neurobiology. In this review, we explore computational mode"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T16:41:05.121459+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_2503.06049> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/11fae74bbd41> .
}

<http://activeinference.institute/nanopub/96e7b1bac522#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1017_s0140525x19001213> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0140525x19001213_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0140525x19001213_FEP_UNIVERSALITY> ns2:citationCount 357 ;
        ns2:claim "The paper discusses applying the FEP to cognition and culture, but doesn't explicitly state that it applies universally. It focuses on human social interactions within a specific context."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "\"We integrate these candidates using the variational (free-energy) approach to human cognition and culture in theoretical neuroscience.\""^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We describe the construction by humans of social niches that afford epistemic resources called cultural affordances."^^xsd:string .
}

