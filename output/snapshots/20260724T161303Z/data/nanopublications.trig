<http://activeinference.institute/nanopub/ba959b5680ce#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2208.10914_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper highlights a limitation of the standard AIF model – its inability to explain mice's actual behavior (home runs) by simply using a ‘map’ built from explored trajectories. This suggests the model doesn't necessarily achieve optimal decision-making."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "However, using this ‘map’ for planning, only allows the agent to find trajectories that it previously explored, far from the observed mice's behaviour."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "However, using this ``map'' for planning, only allows the agent to find trajectories that it previously explored, far from the observed mice's behaviour."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2208.10914> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2208.10914_AIF_OPTIMALITY> .
}

