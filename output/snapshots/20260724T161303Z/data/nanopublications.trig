    <http://activeinference.institute/ontology/assertion/llm_doi_10.1075_tcb.00088.car_LANGUAGE_AIF> ns2:citationCount 20 ;
        ns2:claim "The paper explicitly proposes AIF as a framework for modeling translation processes, suggesting it could be applicable to broader language processing questions."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "The article introduces innovative methods for quantifying fundamental concepts of Relevance Theory (relevance, s-mode, and i-mode translation) and establishes their connection with the Monitor Model, framing relevance maximization as a special case of free energy minimization."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The article puts forth the Free Energy Principle (FEP) and Active Inference (AIF) as a promising framework for modeling these intricately embedded processes"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/language_aif> .

    <http://activeinference.institute/ontology/paper/doi_10.1075_tcb.00088.car> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1075_tcb.00088.car_LANGUAGE_AIF> .
}

