    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2505.22749_FEP_UNIVERSALITY> ns2:citationCount 3 ;
        ns2:claim "The paper explicitly states that the free energy principle emerges from a universal partitioning of dynamical systems, suggesting its applicability across diverse self-organizing systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "Our approach obviates the need for explicitly imposed learning and inference rules and identifies emergent, but efficient and biologically plausible inference and learning dynamics for such self-organizing systems."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Our approach obviates the need for explicitly imposed learning and inference rules and identifies emergent, but efficient and biologically plausible inference and learning dynamics for such self-organizing systems."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2505.22749> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2505.22749_FEP_UNIVERSALITY> .
}

