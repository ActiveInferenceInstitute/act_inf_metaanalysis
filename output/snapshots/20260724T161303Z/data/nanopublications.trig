<http://activeinference.institute/nanopub/822474f599af#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2005.06269> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2005.06269_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2005.06269_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses LQG and Active Inference as frameworks for sensorimotor control, but doesn't explicitly address the universality of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Nowadays, LQG is also a common paradigm in neuroscience, where it is used to characterise different approaches to sensorimotor control based on state estimators, forward and inverse models."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This framework combines Kalman-Bucy filters for the estimation of hidden states with Linear Quadratic Regulators for the control of their dynamics."^^xsd:string .
}

