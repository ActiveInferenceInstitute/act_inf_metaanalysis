<http://activeinference.institute/nanopub/386702837fd2#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2306.08014_SCALABILITY> ns2:citationCount 1 ;
        ns2:claim "The development of a CFFG notation and an algorithm for direct policy inference aims to address the scaling issue that has previously limited AIF's applicability in complex environments."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We also identify a gap in the graphical notation used for factor graphs. While factor graphs are great at expressing a generative model, they have so far been unable to specify the full optimisation problem including constraints. To solve this problem we develop Constrained Forney-style Factor Graph (CFFG) notation which permits a fully graphical description of variational inference objectives."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We also identify a gap in the graphical notation used for factor graphs. While factor graphs are great at expressing a generative model, they have so far been unable to specify the full optimisation problem including constraints. To solve this problem we develop Constrained Forney-style Factor Graph (CFFG) notation which permits a fully graphical description of variational inference objectives."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2306.08014> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2306.08014_SCALABILITY> .
}

