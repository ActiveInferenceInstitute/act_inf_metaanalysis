<http://activeinference.institute/nanopub/5497b55a14f3#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.15213_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper describes how the robot's force generation adapts to human-induced transitions (trained vs. untrained), suggesting an active inference system optimizing its state given uncertainty and minimizing prediction errors."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "the human experimenter needs more force to act on the robot when he attempts to induce untrained as opposed to trained movement pattern transitions."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "the human experimenter needs more/less force to induce trained transitions when $w$ is set with larger/smaller values"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2303.15213> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2303.15213_AIF_OPTIMALITY> .
}

