<http://activeinference.institute/nanopub/a46ca5103437#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2408.12777_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The paper fundamentally alters the definition of the Markov Blanket by shifting its origin from the agent to the environment, directly challenging the notion that it represents a real physical boundary."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "\"That is, first the agent was defined as the entity that performs the \"action\" such as a robot or a person, then the environment was defined as other people or objects that are directly affected by the agent's \"action,\" and the boundary between the agent and the environment was defined as the Markov Blanket.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In normal active inference, the Markov Blanket is defined starting from the agent. That is, first the agent was defined as the entity that performs the \"action\" such as a robot or a person, then the environment was defined as other people or objects that are directly affected by the agent's \"action,\" and the boundary between the agent and the environment was defined as the Markov Blanket."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2408.12777> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2408.12777_MARKOV_BLANKET_REALISM> .
}

