<http://activeinference.institute/nanopub/74eb64575b0f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_9781009026949.007_AIF_OPTIMALITY> ns2:citationCount 12 ;
        ns2:claim "The paper argues that active inference reduces to optimal Bayesian design and expected utility maximization, implying agents *do* achieve optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…reduces to optimal Bayesian design (i.e., information gain maximization). Conversely, active inference reduces to Bayesian decision theory in the absence of ambiguity and relative risk (i.e., expected utility maximization)."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "It is this aspect of active inference that allows for the natural emergence of information-seeking behavior."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1017_9781009026949.007> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_9781009026949.007_AIF_OPTIMALITY> .
}

