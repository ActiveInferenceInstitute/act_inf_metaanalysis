        ns2:sourceClaim "This paper aims to develop a computational model of MPE using the mathematics of variational free energy minimization derived from the free energy principle (FEP)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .
}

