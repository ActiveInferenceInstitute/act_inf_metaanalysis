    <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.12797_MARKOV_BLANKET_REALISM> ns2:citationCount 0 ;
        ns2:claim "The paper’s approach of splitting GPs based on Wasserstein distance suggests a model where the Markov blanket is not a fixed physical boundary but rather a dynamically changing representation reflecting posterior distribution shifts."^^xsd:string ;
