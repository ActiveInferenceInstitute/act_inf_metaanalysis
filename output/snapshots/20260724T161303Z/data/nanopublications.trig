    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_tmm.2017.2729020_PREDICTIVE_CODING> ns2:citationCount 151 ;
        ns2:claim "The paper's approach – approximating the internal generative model with sparse representation and minimizing prediction errors – directly aligns with the core mechanism of predictive coding."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In FSI, the reference and distorted images are, respectively, predicted by the sparse representation at first."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In FSI, the reference and distorted images are, respectively, predicted by the sparse representation at first. Then, the difference between the entropies of the prediction discrepancies is defined to measure the image quality."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_tmm.2017.2729020> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_tmm.2017.2729020_PREDICTIVE_CODING> .
}

