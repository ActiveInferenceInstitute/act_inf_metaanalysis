    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3084523811_FEP_UNIVERSALITY> ns2:citationCount 22 ;
        ns2:claim "The paper focuses on a specific application of the FEP (active inference) within reinforcement learning and doesn't broadly address universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "We show that, on partially observable Markov decision processes, dynamic programming is a limiting case of active inference."^^xsd:string ;
