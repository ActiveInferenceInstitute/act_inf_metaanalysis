<http://activeinference.institute/nanopub/fe1eee3b05eb#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2203.14194_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the Free Energy Principle describes an organism's homeostasis as regulation of biochemical work constrained by physical free-energy cost, suggesting a broad applicability beyond just neuroscience."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…the Free Energy Principle describes an organism's homeostasis as the regulation of biochemical work constrained by the physical free-energy cost."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Our results reveal that the perception and action of animals result from active inference entailed by free-energy minimization in the brain..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

