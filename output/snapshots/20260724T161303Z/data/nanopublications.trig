<http://activeinference.institute/nanopub/b25fcc4f2cdd#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3037369448_AIF_OPTIMALITY> ns2:citationCount 10 ;
        ns2:claim "The paper explicitly frames choke as a failure of active inference to attenuate error signals, implying that optimal performance relies on the system's ability to manage prediction errors according to AIF principles."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "This model predicts that choke arises when the system fails to attenuate the error signal generated by proprioceptive sensory input."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The active inference scheme can explain certain forms of sensorimotor skills disruption in terms of precision-modulated imbalance between sensory input and higher-level predictions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/openalex_https___openalex.org_W3037369448> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_openalex_https___openalex.org_W3037369448_AIF_OPTIMALITY> .
}

