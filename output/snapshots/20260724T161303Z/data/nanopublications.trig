        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "In a recent technical critique of the free energy principle (FEP) due to Aguilera-Millidge-Tschantz-Buckley, it is argued that there are a number of instances where the FEP$\\unicode{x2014}$as conventionally written, in terms of densities over states$\\unicode{x2014}$is uninformative about the dynamics of many physical systems, and by extension, many 'things.' In this informal comment on their critique, I highlight two points of interest where their derivations are largely correct, but where their arguments a"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T21:48:39.057774+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1016_j.plrev.2022.05.009> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/085fe08e1d52> .
}

