        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "Abstract Recent work in computational and cognitive neuroscience depicts the brain as an ever‐active prediction machine: an inner engine continuously striving to anticipate the incoming sensory barrage. I briefly introduce this class of models before contrasting two ways of understanding the implied vision of mind. One way (Conservative Predictive Processing) depicts the predictive mind as an insulated inner arena populated by representations so rich and reconstructive as to enable the organism to ‘throw aw"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-24T00:02:51.237956+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1111_sjp.12120> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/365153a45f89> .
}

<http://activeinference.institute/nanopub/fb6c93e6775a#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.20944_preprints201902.0246.v1> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints201902.0246.v1_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.20944_preprints201902.0246.v1_FEP_UNIVERSALITY> ns2:citationCount 23 ;
        ns2:claim "The paper focuses on PID control as an instantiation of active inference within biological systems, not a universal application of the FEP itself."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "In this work, we will show how PID controllers can fit a more general theory of life and cognition under the principle of (variational) free energy minimisation when using approximate linear generative models of the world."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We argue that if the active inference proposal is to be taken as a general process theory for biological systems, it is necessary to understand how it relates to existing control theoretical approaches routinely used to study and explain biological systems."^^xsd:string .
}

<http://activeinference.institute/nanopub/0ed1c6ecfef7#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2506.22487> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.22487_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.22487_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses AGI-enhanced IoX systems but doesn't explicitly state or test the universality of the FEP. It focuses on a specific application area (IoX) and how AGI can address bottlenecks within it."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Specifically, this survey explores how AGI can mitigate IoX bottlenecks challenges by leveraging adaptive sensor fusion, edge preprocessing, and selective attention mechanisms at the sensing layer..."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The integration of the Internet of Everything (IoX) and Artificial General Intelligence (AGI) has given rise to a transformative paradigm aimed at addressing critical bottlenecks across sensing, network, and application layers in Cyber-Physical-Social Thinking (CPST) ecosystems."^^xsd:string .
}

