<http://activeinference.institute/nanopub/6fcb48b7d85a#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2306.15494> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.15494_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2306.15494_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly models agents using Active Inference and investigates conditions for achieving game-theoretic steady states, suggesting that the agents' dynamics are driven by optimizing their predictions and minimizing prediction errors – a core tenet of AIF."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…derivation of optimal conditions for phase transitions that are required to achieve certain game-theoretic steady states."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We show that the critical time points governing the phase transition are linearly related to each other as a function of learning rate and the reward function."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

<http://activeinference.institute/nanopub/6bc9052335cc#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rstb.2014.0169_MARKOV_BLANKET_REALISM> ns2:citationCount 451 ;
        ns2:claim "The paper's emphasis on modulatory connections and precision suggests a more active role for the brain in constructing its reality than implied by Markov blanket realism."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "We explore the implications of this distinction from a formal perspective (using simulations of feature-ground segregation) and consider the neurobiological substrates of the ensuing precision-engineered dynamics..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "a class of modulatory (second-order) connections that establish context-in the form of the salience or precision ascribed to content."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1098_rstb.2014.0169> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1098_rstb.2014.0169_MARKOV_BLANKET_REALISM> .
}

