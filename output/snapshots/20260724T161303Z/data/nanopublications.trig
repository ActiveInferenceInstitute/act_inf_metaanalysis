        ns2:sourceClaim "We propose a novel scalable VI method where the learning objective combines the score matching loss and the proximal penalty term in iterations, which helps our method avoid the reparametrized sampling..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/scalability> .
}

