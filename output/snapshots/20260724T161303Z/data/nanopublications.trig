<http://activeinference.institute/nanopub/d0275776e8e0#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses AXIOM as a general learning architecture leveraging core priors, aligning with the FEP's broader claim of universal self-organization but doesn’t directly test this universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "However, active inference models are usually crafted for a single task with bespoke knowledge, so they lack the domain flexibility typical of DRL approaches."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "To bridge this gap, we propose a novel architecture that integrates a minimal yet expressive set of core priors about object-centric dynamics and interactions to accelerate learning in low-data regimes."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2505.24784> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2505.24784_FEP_UNIVERSALITY> .
}

