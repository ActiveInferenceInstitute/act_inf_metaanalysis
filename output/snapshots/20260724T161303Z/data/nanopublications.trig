    <http://activeinference.institute/ontology/paper/doi_10.15502_9783958570207> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.15502_9783958570207_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.15502_9783958570207_FEP_UNIVERSALITY> ns2:citationCount 10 ;
        ns2:claim "The paper discusses a broad analogy between PP and scientific theory, suggesting connections to Popper and Kuhn without explicitly endorsing universal application of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "While many aspects of PP are in line with Karl Popper’s falsificationism, other aspects of PP conform to how Thomas Kuhn described scientific revolutions."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Seth draws a distinction between three types of active inference, applying PP to various phenomena including perceptual presence."^^xsd:string .
}

