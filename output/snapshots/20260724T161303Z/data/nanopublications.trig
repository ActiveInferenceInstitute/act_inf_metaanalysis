<http://activeinference.institute/nanopub/1dd220d83ec9#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.05794_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
