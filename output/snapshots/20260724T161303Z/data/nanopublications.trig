<http://activeinference.institute/nanopub/dacc60986c7d#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1016_j.jtbi.2019.110089> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.jtbi.2019.110089_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.jtbi.2019.110089_FEP_UNIVERSALITY> ns2:citationCount 106 ;
        ns2:claim "The paper presents a simulation exploring hierarchical self-organisation within a specific system (Markov blankets) using variational free energy minimisation. While this demonstrates a mechanism for self-organisation consistent with the FEP, it doesn't directly address universality across *all* self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Using simulations, based on the principle of variational free energy minimisation..."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Using simulations, based on the principle of variational free energy minimisation, we show that hierarchical self-organisation emerges when the microscopic elements of an ensemble have prior (e.g., genetic) beliefs that they participate in a macroscopic Markov blanket: i.e., they can only influence - or be influenced by - a subset of other elements."^^xsd:string .
}

