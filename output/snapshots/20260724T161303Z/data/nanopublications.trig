        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this paper, we clarify the connection between reward maximisation and active inference by demonstrating how and when active inference agents perform actions that are optimal for maximising reward."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.48550_arxiv.2009.08111> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.48550_arxiv.2009.08111_FEP_UNIVERSALITY> .
