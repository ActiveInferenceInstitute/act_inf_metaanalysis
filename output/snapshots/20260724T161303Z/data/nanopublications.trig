        ns2:claim "The paper focuses on quantum systems and Bayesian prediction error, not the specific relationship between Markov blankets and physical boundaries."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/markov_blanket_realism> ;
        ns2:evidenceQuote "standard freedom of choice assumption"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We show how generic quantum systems can be regarded as observers, which with the standard freedom of choice assumption become agents capable of assigning semantics to observational outcomes."^^xsd:string .

    <http://activeinference.institute/ontology/paper/doi_10.1016_j.pbiomolbio.2022.05.006> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.pbiomolbio.2022.05.006_MARKOV_BLANKET_REALISM> .
}

