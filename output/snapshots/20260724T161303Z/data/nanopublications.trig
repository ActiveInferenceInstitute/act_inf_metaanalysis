    <http://activeinference.institute/ontology/assertion/llm_arxiv_2211.10419_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly states that the AIF agent aims to achieve reward-based learning and capture human-like behavior through optimizing free energy minimization."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "\"our proposed \"neural\" AIF agent uses artificial neural networks to select actions on the basis of a very short term prediction of the information about the task environment that these actions would reveal along with a long-term estimate of the resulting cumulative expected free energy\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "The active inference framework (AIF) is a promising new computational framework grounded in contemporary neuroscience that can produce human-like behavior through reward-based learning."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2211.10419> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2211.10419_AIF_OPTIMALITY> .
}

