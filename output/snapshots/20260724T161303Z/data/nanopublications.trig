        ns2:prov_run_id "6e1ea49f49624c87a4cea11e3fc0a3b7"^^xsd:string ;
        ns2:prov_source_passage "The ability to plan ahead efficiently is key for both living organisms and artificial systems. Model-based planning and prospection are widely studied in cognitive neuroscience and artificial intelligence (AI), but from different perspectives--and with different desiderata in mind (biological realism versus scalability) that are difficult to reconcile. Here, we introduce a novel method to plan in POMDPs--Active Inference Tree Search (AcT)--that combines the normative character and biological realism of a le"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T17:32:49.832560+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1016_j.neucom.2024.129319> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/c281603b654e> .
}

