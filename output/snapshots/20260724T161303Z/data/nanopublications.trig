<http://activeinference.institute/nanopub/4de65778be43#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1155_2010_621670> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2010_621670_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1155_2010_621670_FEP_UNIVERSALITY> ns2:citationCount 167 ;
        ns2:claim "The paper describes a general filtering scheme applicable across nonlinear state-space models, aligning with the broad scope of the FEP but doesn't explicitly address universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "Crucially, the scheme operates online, assimilating data to optimize the conditional density on time-varying states and time-invariant parameters."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This scheme furnishes posterior (conditional) densities on hidden states and unknown parameters generating observed data."^^xsd:string .
}

