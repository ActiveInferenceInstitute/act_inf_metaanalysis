    <http://activeinference.institute/ontology/paper/arxiv_2112.13523> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.13523_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.13523_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific interpretation of states within dynamical systems – as Bayesian priors/posteriors – and doesn't directly address the universal applicability of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "These can be seen as an agent’s beliefs, expressed as a Bayesian prior or posterior."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Here we begin the development of a general theory that would tell us when it is appropriate to interpret states as representing beliefs in this way."^^xsd:string .
}

