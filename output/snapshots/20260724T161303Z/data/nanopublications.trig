        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Patterns function as shared priors for action selection, reflection, and revision in hybrid human/agent settings."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2506.09696> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2506.09696_FEP_UNIVERSALITY> .
}

