    <http://activeinference.institute/ontology/assertion/llm_doi_10.1101_796136_AIF_OPTIMALITY> ns2:citationCount 1 ;
        ns2:claim "The paper posits that disturbance facilitates learning by allowing agents to actively infer force-fields, aligning with the core tenets of Active Inference and optimizing for reduced surprise."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "continuous movements require active inference about external force-fields in order to create accurate internal models of the external world (motor learning)"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "continuous movements require active inference about external force-fields in order to create accurate internal models of the external world (motor learning)."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

