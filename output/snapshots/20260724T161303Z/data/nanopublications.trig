<http://activeinference.institute/nanopub/ab328fe58e0d#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2512.04404> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.04404_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.04404_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper frames multi-robot cooperation as a free-energy minimization process, directly aligning with the core principle of AIF – agents minimizing surprise/error."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "free-energy minimization process...preference matrix based on perceptual inputs and peer intentions"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Within this framework, multi-robot cooperation is formulated as a free-energy minimization process, where each robot dynamically updates its preference matrix based on perceptual inputs and peer intentions, thereby achieving adaptive coordination in partially observable and dynamic environments."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

