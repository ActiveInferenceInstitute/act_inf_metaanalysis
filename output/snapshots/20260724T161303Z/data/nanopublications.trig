        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This comparison is done on two types of bandit problems: a stationary and a dynamic switching bandit."^^xsd:string .

