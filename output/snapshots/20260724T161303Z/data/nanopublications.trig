        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "the framework enables the experimenter to specify generative (encoding) models of fMRI timeseries, in which experimental manipulations enter a pRF model of neural activity, which in turns drives a nonlinear model of neurovascular coupling and BOLD response."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/doi_10.1016_j.neuroimage.2017.09.008> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.neuroimage.2017.09.008_PREDICTIVE_CODING> .
}

