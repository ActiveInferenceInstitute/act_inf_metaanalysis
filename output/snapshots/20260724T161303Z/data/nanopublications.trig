<http://activeinference.institute/nanopub/f8c4daecb438#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2207.06970> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2207.06970_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2207.06970_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper establishes a specific equivalence between active inference and spin glass systems, suggesting a connection to self-organizing systems but doesn't explicitly claim universal applicability of the FEP."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "a collective of specifically-designed active inference agents can thus be described as implementing a form of sampling-based inference (namely, from a Boltzmann machine) at the higher level."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We show that the collective dynamics of a specific type of active inference agent is equivalent to sampling from the stationary distribution of a spin glass system."^^xsd:string .
}

