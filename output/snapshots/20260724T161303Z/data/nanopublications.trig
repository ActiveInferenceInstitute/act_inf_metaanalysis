<http://activeinference.institute/nanopub/e98595fb9c4f#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2007.09297> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2007.09297_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2007.09297_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames the agent's behavior as minimizing free energy, which aligns with the concept of achieving optimal decision-making under uncertainty within the AIF framework."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "minimize the expected free energy"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We explore a scenario in which the agent learns this distribution in a self-supervised manner. In particular, we highlight the distinction between observations induced by the environment and those pertaining more directly to the continuity of an agent in time. We evaluate our methodology in a dynamic environment with discrete time and actions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

<http://activeinference.institute/nanopub/e93c57a586fb#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2311.10216> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2311.10216_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2311.10216_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper describes how self-organisation minimizes Helmholtz energy, which aligns with the goal of Active Inference to minimize free energy. However, it doesn't explicitly state that this minimization *necessarily* equates to optimal decision-making."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "performing variational Bayesian inference..."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:sourceClaim "In essence, these self-organising systems can be read as performing variational Bayesian inference of their interacting environment."^^xsd:string .
}

<http://activeinference.institute/nanopub/610082e0ef7f#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.5281_zenodo.19582021> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.19582021_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.5281_zenodo.19582021_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific simulation of organizational decision-making and doesn't directly address the broader claim of FEP universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "The simulation interface allows you to adjust the strength of probablistic beliefs for a manager and 4 team members, as well as their percieved precision of data coming from the market."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "This R code to deploy a simulation of organizational decision making as active inference following the Free Energy Principle"^^xsd:string .
}

<http://activeinference.institute/nanopub/db3326341e18#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2602.23681> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.23681_LANGUAGE_AIF> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2602.23681_LANGUAGE_AIF> ns2:citationCount 0 ;
        ns2:claim "The paper proposes a framework (ODAR) for LLM reasoning using active inference principles, directly addressing the question of whether Active Inference can provide a viable framework for language processing."^^xsd:string ;
        ns2:confidence 9e-01 ;
        ns2:evidenceQuote "ODAR uses a difficulty estimator grounded in amortized active inference to dynamically route queries…"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We propose ODAR-Expert, an adaptive routing framework that optimizes the accuracy-efficiency trade-off via principled resource allocation. ODAR uses a difficulty estimator grounded in amortized active inference to dynamically route queries between a heuristic Fast Agent and a deliberative Slow Agent."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/language_aif> .
}

