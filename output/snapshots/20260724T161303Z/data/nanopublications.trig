    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_IJCNN.2019.8852048_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly advocates for a nonmodular architecture rooted in Active Inference, aligning with the broader Free Energy Principle's claim of universal applicability to self-organizing systems."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "In psychology and neuroscience it is common to describe cognitive systems as input/output devices where perceptual and motor functions are implemented in a purely feedforward, open-loop fashion."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We then propose a nonmodular architecture based on the active inference framework."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .

    <http://activeinference.institute/ontology/paper/doi_10.1109_IJCNN.2019.8852048> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_IJCNN.2019.8852048_FEP_UNIVERSALITY> .
}

