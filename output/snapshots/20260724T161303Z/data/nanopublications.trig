<http://activeinference.institute/nanopub/5c25644db12f#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01341_AIF_OPTIMALITY> ns2:citationCount 220 ;
        ns2:claim "The paper explicitly states that the agent optimizes confidence in action selection through internal valence representations and updating of subjective fitness. This aligns with the core principle of Active Inference – agents pursuing optimal control by minimizing surprise."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "This index of subjective fitness can be estimated within any environment and exploits the domain generality of second-order beliefs (beliefs about beliefs)."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "This formulation asserts that agents infer their valence state based on the expected precision of their action model-an internal estimate of overall model fitness (\"subjective fitness\")"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.1162_neco_a_01341> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1162_neco_a_01341_AIF_OPTIMALITY> .
}

<http://activeinference.institute/nanopub/a87113e3d735#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2112.07406_SCALABILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
