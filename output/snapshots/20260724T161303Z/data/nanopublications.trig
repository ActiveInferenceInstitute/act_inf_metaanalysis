<http://activeinference.institute/nanopub/cbd290d88ddf#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1109_LRA.2020.2974451_SCALABILITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
