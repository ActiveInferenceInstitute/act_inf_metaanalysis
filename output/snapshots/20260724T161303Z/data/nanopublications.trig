<http://activeinference.institute/nanopub/dc6b29fa348e#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.04316_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly describes a model-based Bayesian agent learning preferences to achieve predictable states – a core component of AIF’s goal of optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "These conjugate priors are used to augment the expected free energy planner for learning preferences over states (or outcomes) across time."^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "In such instances, the agent can learn preferred modes of behaviour that lead to predictable states -- necessary for survival."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2106.04316> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2106.04316_AIF_OPTIMALITY> .
