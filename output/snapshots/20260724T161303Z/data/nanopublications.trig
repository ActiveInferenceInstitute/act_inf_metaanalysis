    <http://activeinference.institute/ontology/paper/arxiv_2101.08937> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2101.08937_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2101.08937_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on a specific application of Active Inference (prior preference learning) and doesn't broadly address universality across all self-organizing systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "An agent will choose an action that leads to its prior preference for a future observation."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Active inference may be defined as Bayesian modeling of a brain with a biologically plausible model of the agent."^^xsd:string .
}

<http://activeinference.institute/nanopub/8409f7982a20#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2507.17338> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2507.17338_AIF_OPTIMALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2507.17338_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that active inference outperforms baselines on a complex benchmark (Habitat), suggesting it achieves effective decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "...demonstrating for the first time that active inference can scale to the complexity of modern robotics benchmarks."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "Our method outperforms state-of-the-art baselines across the three long-horizon tasks..."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

