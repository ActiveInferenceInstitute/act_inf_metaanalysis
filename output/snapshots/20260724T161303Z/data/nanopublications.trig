        ns2:claim "The paper describes a system (brain) learning statistical associations based on prediction errors, aligning with the core principle of AIF – agents actively minimizing surprise to achieve optimal control."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "AIF agents achieve optimal decision-making under uncertainty"^^xsd:string ;
        ns2:evidenceStatus "mentions"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We modeled incidental learning of these associations using a Rescorla-Wagner (RW) model."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .
}

