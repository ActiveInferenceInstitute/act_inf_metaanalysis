<http://activeinference.institute/nanopub/be0d2852d8a8#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2603.09729> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.09729_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2603.09729_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper focuses on spiking networks and their ability to constrain free energy, which is a specific instantiation of the FEP. It doesn't directly address the broader claim of universality."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "neurons only fire if they reduce the free energy of their internal representation"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "The networks function as free energy constrainers, in which neurons only fire if they reduce the free energy of their internal representation."^^xsd:string .
}

