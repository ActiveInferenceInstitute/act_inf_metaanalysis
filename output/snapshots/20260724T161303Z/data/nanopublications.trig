<http://activeinference.institute/nanopub/95d147a7b144#assertion> {
    <http://activeinference.institute/ontology/paper/arxiv_2210.15098> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2210.15098_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_arxiv_2210.15098_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly argues that natural language syntax aligns with the FEP, suggesting a broader applicability of this principle."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "\"This affords a greater degree of explanatory power to the FEP - with respect to higher language functions - and offers linguistics a grounding in first principles with respect to computability.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We argue that recently proposed principles of economy in language design - such as \"minimal search\" criteria from theoretical syntax - adhere to the FEP."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/fep_universality> .
}

<http://activeinference.institute/nanopub/9c3517a83057#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1016_j.plrev.2021.11.001> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2021.11.001_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1016_j.plrev.2021.11.001_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper argues that the FEP's assumptions (Markov blanket and solenoidal flows) are only valid for a narrow range of systems, suggesting it doesn’t apply universally."^^xsd:string ;
        ns2:confidence 8.5e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:evidenceQuote "\"Suitable systems require an absence of perception-action asymmetries that is highly unusual for living systems interacting with an environment.\""^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "Two requirements of the FEP -- the Markov blanket condition and stringent restrictions on its solenoidal flows -- are only valid for a very narrow space of parameters."^^xsd:string .
}

