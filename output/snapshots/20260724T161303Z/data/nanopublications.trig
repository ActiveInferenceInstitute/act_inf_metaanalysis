<http://activeinference.institute/nanopub/f0123f3771fc#assertion> {
    <http://activeinference.institute/ontology/paper/doi_10.1371_journal.pone.0047502> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pone.0047502_FEP_UNIVERSALITY> .

    <http://activeinference.institute/ontology/assertion/llm_doi_10.1371_journal.pone.0047502_FEP_UNIVERSALITY> ns2:citationCount 93 ;
        ns2:claim "The paper presents a specific application of the FEP (active inference) to oculomotor control, focusing on a biological system (human eye movements). While this demonstrates the FEP's potential in a complex domain, it doesn’t directly address the universal applicability claim."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "minimisation of variational free energy"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "Our model appeals to a single principle--the minimisation of variational free energy--to provide Bayes optimal solutions to the smooth pursuit problem."^^xsd:string .
}

