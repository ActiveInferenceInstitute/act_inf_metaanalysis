    <http://activeinference.institute/ontology/assertion/llm_arxiv_2311.10215_FEP_UNIVERSALITY> ns2:citationCount 0 ;
        ns2:claim "The paper discusses LLMs within the broader framework of the FEP but doesn't directly address whether the FEP applies universally to all systems."^^xsd:string ;
        ns2:confidence 6e-01 ;
        ns2:evidenceQuote "…lack a tight feedback loop between acting in the world and perceiving the impacts of their actions"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "We examine similarities and differences between traditional active inference systems and LLMs, leading to the conclusion that, currently, LLMs lack a tight feedback loop between acting in the world and perceiving the impacts of their actions."^^xsd:string .
}

