        ns2:claim "The paper focuses on the *mechanisms* of difference attribution and entropy reduction within active inference, rather than directly addressing whether this process necessarily leads to optimal decision-making. It describes a search strategy, not an optimality guarantee."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:contradicts <http://activeinference.institute/ontology/hypothesis/aif_optimality> ;
        ns2:evidenceQuote "‘...a search over possible difference attributions whose temporal evolution takes the form of entropy decay.’"^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "‘...the evaluation process can be interpreted as a search over possible difference attributions whose temporal evolution takes the form of entropy decay.’"^^xsd:string .

