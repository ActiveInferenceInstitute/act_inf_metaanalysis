<http://activeinference.institute/nanopub/a7d307f0ca03#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1017_s0140525x12000477_MARKOV_BLANKET_REALISM> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
        ns2:prov_paper_id "doi:10.1017/s0140525x12000477"^^xsd:string ;
        ns2:prov_pipeline_version "2.0.3"^^xsd:string ;
        ns2:prov_processing_date "2026-07-23T22:53:58.369856+00:00"^^xsd:string ;
        ns2:prov_prompt_version "v2.0.0-three-layer"^^xsd:string ;
        ns2:prov_run_id "2e6c209a7e9e43b4bb6be59c09ed0843"^^xsd:string ;
        ns2:prov_source_passage "Brains, it has recently been argued, are essentially prediction machines. They are bundles of cells that support perception and action by constantly attempting to match incoming sensory inputs with top-down expectations or predictions. This is achieved using a hierarchical generative model that aims to minimize prediction error within a bidirectional cascade of cortical processing. Such accounts offer a unifying model of perception and action, illuminate the functional role of attention, and may neatly capt"^^xsd:string ;
        ns2:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-23T22:53:58.370156+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1017_s0140525x12000477> ;
        prov:wasAttributedTo "pipeline_2.0.3:v2.0.0-three-layer"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/a7d307f0ca03> .
}

