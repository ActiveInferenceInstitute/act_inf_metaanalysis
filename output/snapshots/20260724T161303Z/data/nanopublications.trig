<http://activeinference.institute/nanopub/635694a538ef#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frsip.2022.842477_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper explicitly frames AIDA's design process as 'optimal (acoustic) context-aware Bayesian trial design,' directly aligning with the core tenet of Active Inference – that agents achieve optimal decision-making under uncertainty."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "AIDA interprets searching for the \"most interesting alternative\" as an issue of optimal (acoustic) context-aware Bayesian trial design."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "AIDA is realized as an active inference-based agent with an Expected Free Energy criterion for trial design."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/doi_10.3389_frsip.2022.842477> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_frsip.2022.842477_AIF_OPTIMALITY> .
}

