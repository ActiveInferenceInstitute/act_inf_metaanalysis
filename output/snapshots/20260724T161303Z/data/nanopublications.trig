    <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.10835_FEP_UNIVERSALITY> ns2:prov_llm_host "localhost:11434"^^xsd:string ;
        ns2:prov_model_id "gemma3:4b"^^xsd:string ;
