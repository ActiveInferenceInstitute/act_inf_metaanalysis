    <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.05935_PREDICTIVE_CODING> ns2:citationCount 0 ;
        ns2:claim "The model's core mechanism – minimizing prediction errors via Bayesian inference and SNR – aligns with the principles of predictive coding."^^xsd:string ;
        ns2:confidence 7e-01 ;
        ns2:evidenceQuote "This means errors rise quickly once average capacity is exceeded."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:sourceClaim "We show how the error between goal and progress distributions, or Bayesian surprise, can be modeled as a simple mean square error of the signal-to-noise ratio (SNR) of a task."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

    <http://activeinference.institute/ontology/paper/arxiv_2502.05935> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2502.05935_PREDICTIVE_CODING> .
}

