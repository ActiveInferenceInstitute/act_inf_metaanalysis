        ns2:claim "The paper describes a mechanism where cortical hierarchies minimize prediction errors via predictive coding, aligning with the core principles of Active Inference."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "We show that this is consistent with current models of neuronal dynamics and establish face validity by synthesising plausible electrophysiological responses."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "The free energy gradient is a prediction error—plausibly encoded in the average membrane potentials of neuronal populations"^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/predictive_coding> .

