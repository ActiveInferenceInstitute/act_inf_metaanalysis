<http://activeinference.institute/nanopub/918674e2ea5e#assertion> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2312.12009_AIF_OPTIMALITY> ns2:citationCount 0 ;
        ns2:claim "The paper demonstrates that an LLM using the proposed algorithm outperforms baselines in a preference inference task, suggesting it achieves a more optimal outcome (fewer interactions) compared to standard LLM prompting."^^xsd:string ;
        ns2:confidence 8e-01 ;
        ns2:evidenceQuote "…outperforms baselines with the same underlying LLM on task performance while using fewer user interactions."^^xsd:string ;
        ns2:evidenceStatus "explicit_claim"^^xsd:string ;
        ns2:evidenceType "empirical"^^xsd:string ;
        ns2:sourceClaim "…an LLM equipped with our entropy reduction algorithm outperforms baselines with the same underlying LLM on task performance while using fewer user interactions."^^xsd:string ;
        ns2:supports <http://activeinference.institute/ontology/hypothesis/aif_optimality> .

    <http://activeinference.institute/ontology/paper/arxiv_2312.12009> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2312.12009_AIF_OPTIMALITY> .
}

