        ns2:evidenceType "theoretical"^^xsd:string ;
        ns2:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns2:sourceClaim "In this study, we investigate how different predictive strategies and the inclusion of environmental dynamics, specifically an internal model of gravity, influence interceptive control within an Active Inference agent."^^xsd:string .

    <http://activeinference.institute/ontology/paper/arxiv_2512.17735> ns2:asserts <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.17735_FEP_UNIVERSALITY> .
}

