\begin{block}{Core Triple Patterns}
\protect\phantomsection\label{core-triple-patterns}
The knowledge graph encodes five fundamental relationships:

{\def\LTcaptype{none} % do not increment counter
\begin{longtable}[]{@{}ll@{}}
\toprule\noalign{}
Triple Pattern & Meaning \\
\midrule\noalign{}
\endhead
\texttt{Paper\ \ -\/-aif:asserts-\/-\textgreater{}\ \ \ \ \ \ Assertion}
& A paper makes a claim \\
\texttt{Paper\ \ -\/-aif:cites-\/-\textgreater{}\ \ \ \ \ \ \ \ Paper} &
Intra-corpus citation link \\
\texttt{Paper\ \ -\/-aif:belongsTo-\/-\textgreater{}\ \ \ \ Subfield} &
Domain classification \\
\texttt{Assertion\ -\/-aif:supports-\/-\textgreater{}\ \ Hypothesis} &
Supporting evidence \\
\texttt{Assertion\ -\/-aif:contradicts-\/-\textgreater{}\ Hypothesis} &
Contradicting evidence \\
\bottomrule\noalign{}
\end{longtable}
}
\end{block}
\end{block}
