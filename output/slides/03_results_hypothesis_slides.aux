\newlabel{temporal-dynamics-of-evidence-accumulation}{{1}{1}{}{temporal-dynamics-of-evidence-accumulation}{}}
\@writefile{snm}{\beamer@slide {temporal-dynamics-of-evidence-accumulation}{1}}
\newlabel{fig:evidence_timeline}{{2}{1}{Temporal evolution of cumulative citation-weighted evidence scores by hypothesis (2005--2026). Divergent trajectories around the shaded neutral boundary $(\pm 0.1)$ reveal which hypotheses are gaining or losing support over time. H4 (predictive coding) stabilized early; H5 (scalability) accelerated post-2017}{fig:evidence_timeline}{}}
\@writefile{snm}{\beamer@slide {fig:evidence_timeline}{1}}
\newlabel{assertion-composition-and-distribution}{{1}{1}{}{assertion-composition-and-distribution}{}}
\@writefile{snm}{\beamer@slide {assertion-composition-and-distribution}{1}}
\newlabel{fig:assertion_breakdown}{{3}{1}{Stacked horizontal bars decomposing per-hypothesis assertions into supports (green), contradicts (red-orange), and neutral (blue) categories ($N = 2,795$ total assertions). Labels show total count and support percentage. The high support fractions are partially attributable to publication bias and affirmative linguistic framing}{fig:assertion_breakdown}{}}
\@writefile{snm}{\beamer@slide {fig:assertion_breakdown}{1}}
\newlabel{fig:assertion_summary}{{4}{1}{Multi-panel assertion summary: (left) pie chart of overall assertion type distribution showing supports/contradicts/neutral proportions, (right) per-hypothesis assertion counts with palette-coded bars. $N = 2,795$ assertions extracted from $849$ papers}{fig:assertion_summary}{}}
\@writefile{snm}{\beamer@slide {fig:assertion_summary}{1}}
