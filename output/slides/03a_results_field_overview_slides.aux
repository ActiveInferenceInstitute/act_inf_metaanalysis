\newlabel{fig:field_summary}{{1}{1}{Publication counts by domain ($N = 849$). Domain A (Core Theory) dominates, with Domains B (Tools) and C (Applications) forming growing tiers}{fig:field_summary}{}}
\@writefile{snm}{\beamer@slide {fig:field_summary}{1}}
\newlabel{corpus-level-summary}{{1}{1}{}{corpus-level-summary}{}}
\@writefile{snm}{\beamer@slide {corpus-level-summary}{1}}
\newlabel{fig:growth_curve}{{2}{1}{Annual (bars) and cumulative (line) publication counts, 2005--2026 ($N = 849$, CAGR = 16.99\%). The inflection around 2013 marks the onset of rapid growth. Moving average trendline (dashed), peak year, and median year annotated}{fig:growth_curve}{}}
\@writefile{snm}{\beamer@slide {fig:growth_curve}{1}}
