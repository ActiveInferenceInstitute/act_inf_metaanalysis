        ns1:prov_run_id "f198c4266b204f7393c0e15fcc1e18c4"^^xsd:string ;
        ns1:prov_source_passage "Accurate perceptual inference fundamentally depends upon accurate beliefs about the reliability of sensory data. In this paper, we describe a Bayes optimal and biologically plausible scheme that refines these beliefs through a gradient descent on variational free energy. To illustrate this, we simulate belief updating during visual foraging and show that changes in estimated sensory precision (i.e., confidence in visual data) are highly sensitive to prior beliefs about the contents of a visual scene. In bri"^^xsd:string ;
        ns1:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-25T03:12:37.748724+00:00"^^xsd:dateTime ;
