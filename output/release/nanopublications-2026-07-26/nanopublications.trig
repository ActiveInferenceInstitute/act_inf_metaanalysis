<http://activeinference.institute/nanopub/a32866c32369#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2604.21378_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
