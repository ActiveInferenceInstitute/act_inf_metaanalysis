<http://activeinference.institute/nanopub/b8fe64d74d8c#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1705.09156_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
