<http://activeinference.institute/nanopub/2f666d8c303e#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnint.2018.00039_PREDICTIVE_CODING> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
