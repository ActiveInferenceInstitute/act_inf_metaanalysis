<http://activeinference.institute/nanopub/1deb8afa982c#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2202.11154_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
