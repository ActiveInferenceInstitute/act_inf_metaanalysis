<http://activeinference.institute/nanopub/4bc9d6d5f77a#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_1903.02610_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
