<http://activeinference.institute/nanopub/dba7154a0253#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3390_e26010083_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
