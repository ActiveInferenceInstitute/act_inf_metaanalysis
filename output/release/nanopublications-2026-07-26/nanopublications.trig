<http://activeinference.institute/nanopub/22c58278542c#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2512.15381_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
