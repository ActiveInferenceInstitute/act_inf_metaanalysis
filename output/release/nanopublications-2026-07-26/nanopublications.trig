<http://activeinference.institute/nanopub/46dff105463f#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.00814_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
