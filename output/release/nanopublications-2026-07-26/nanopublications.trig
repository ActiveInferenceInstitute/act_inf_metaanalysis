<http://activeinference.institute/nanopub/81703d4cc6ca#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2509.12754_LANGUAGE_AIF> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
