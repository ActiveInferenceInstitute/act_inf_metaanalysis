<http://activeinference.institute/nanopub/fedd265f9705#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.00814_SCALABILITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
