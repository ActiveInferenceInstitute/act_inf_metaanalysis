<http://activeinference.institute/nanopub/5e2b34c2d658#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2409.01066_SCALABILITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
        ns1:prov_paper_id "arxiv:2409.01066"^^xsd:string ;
        ns1:prov_pipeline_version "2.0.6"^^xsd:string ;
        ns1:prov_processing_date "2026-07-25T02:01:47.767283+00:00"^^xsd:string ;
        ns1:prov_prompt_version "v2.0.6"^^xsd:string ;
        ns1:prov_run_id "f198c4266b204f7393c0e15fcc1e18c4"^^xsd:string ;
        ns1:prov_source_passage "An open problem in artificial intelligence is how systems can flexibly learn discrete abstractions that are useful for solving inherently continuous problems. Previous work in computational neuroscience has considered this functional integration of discrete and continuous variables during decision-making under the formalism of active inference (Parr, Friston & de Vries, 2017; Parr & Friston, 2018). However, their focus is on the expressive physical implementation of categorical decisions and the hierarchica"^^xsd:string ;
        ns1:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-25T02:01:47.767639+00:00"^^xsd:dateTime ;
