<http://activeinference.institute/nanopub/31f1f4c286d5#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2410.00240_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
        ns1:prov_paper_id "arxiv:2410.00240"^^xsd:string ;
