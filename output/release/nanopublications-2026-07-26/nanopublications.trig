<http://activeinference.institute/nanopub/f598ebb44117#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2511.16811_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
        ns1:prov_paper_id "arxiv:2511.16811"^^xsd:string ;
