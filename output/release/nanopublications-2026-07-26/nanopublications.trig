<http://activeinference.institute/nanopub/eebdc4ce9334#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1007_978-3-030-93080-6_15_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
