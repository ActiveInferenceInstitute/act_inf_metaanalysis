        ns1:prov_run_id "f198c4266b204f7393c0e15fcc1e18c4"^^xsd:string ;
        ns1:prov_source_passage "The black-box nature of deep learning models prevents them from being completely trusted in domains like biomedicine. Most explainability techniques do not capture the concept-based reasoning that human beings follow. In this work, we attempt to understand the behavior of trained models that perform image processing tasks in the medical domain by building a graphical representation of the concepts they learn. Extracting such a graphical representation of the model's behavior on an abstract, higher conceptua"^^xsd:string ;
        ns1:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-25T02:16:35.167319+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/doi_10.1007_978-3-030-93080-6_15> ;
        prov:wasAttributedTo "pipeline_2.0.6:v2.0.6"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/eebdc4ce9334> .
}

