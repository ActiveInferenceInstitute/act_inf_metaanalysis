        ns1:prov_run_id "f198c4266b204f7393c0e15fcc1e18c4"^^xsd:string ;
        ns1:prov_source_passage "The 'free energy principle' (FEP) has been suggested to provide a unified theory of the brain, integrating data and theory relating to action, perception, and learning. The theory and implementation of the FEP combines insights from Helmholtzian 'perception as inference', machine learning theory, and statistical thermodynamics. Here, we provide a detailed mathematical evaluation of a suggested biologically plausible implementation of the FEP that has been widely used to develop the theory. Our objectives ar"^^xsd:string ;
        ns1:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-25T02:35:01.617783+00:00"^^xsd:dateTime ;
