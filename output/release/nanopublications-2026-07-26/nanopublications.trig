<http://activeinference.institute/nanopub/d15ed34ca439#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2107.00814_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
