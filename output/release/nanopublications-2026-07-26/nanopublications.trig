<http://activeinference.institute/nanopub/637f900774d5#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2607.11555_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
