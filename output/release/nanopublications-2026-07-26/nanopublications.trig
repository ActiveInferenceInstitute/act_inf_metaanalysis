<http://activeinference.institute/nanopub/990bc7410101#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2605.11638_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
