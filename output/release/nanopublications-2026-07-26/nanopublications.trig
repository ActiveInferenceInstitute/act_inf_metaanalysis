        prov:wasAttributedTo "pipeline_2.0.6:v2.0.6"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/a32866c32369> .
}

<http://activeinference.institute/nanopub/b3787eae374c#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2310.11070_FEP_UNIVERSALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
