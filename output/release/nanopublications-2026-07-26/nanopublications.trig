<http://activeinference.institute/nanopub/d79a9c5aa3f5#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2509.12754_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
        ns1:prov_paper_id "arxiv:2509.12754"^^xsd:string ;
        ns1:prov_pipeline_version "2.0.6"^^xsd:string ;
        ns1:prov_processing_date "2026-07-25T01:55:14.162436+00:00"^^xsd:string ;
        ns1:prov_prompt_version "v2.0.6"^^xsd:string ;
        ns1:prov_run_id "f198c4266b204f7393c0e15fcc1e18c4"^^xsd:string ;
        ns1:prov_source_passage "Robots operating in domestic and office environments must understand object ownership to correctly execute instructions such as ``Bring me my cup.'' However, ownership cannot be reliably inferred from visual features alone. To address this gap, we propose Active Ownership Learning (ActOwL), a framework that enables robots to actively generate and ask ownership-related questions to users. ActOwL employs a probabilistic generative model to select questions that maximize information gain, thereby acquiring own"^^xsd:string ;
        ns1:prov_source_section "abstract"^^xsd:string ;
        prov:generatedAtTime "2026-07-25T01:55:14.162956+00:00"^^xsd:dateTime ;
        prov:hadPrimarySource <http://activeinference.institute/ontology/paper/arxiv_2509.12754> ;
        prov:wasAttributedTo "pipeline_2.0.6:v2.0.6"^^xsd:string ;
        prov:wasGeneratedBy <http://activeinference.institute/nanopub/d79a9c5aa3f5> .
}

