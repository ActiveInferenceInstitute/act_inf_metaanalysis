<http://activeinference.institute/nanopub/bdc967970056#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.3389_fnint.2018.00039_AIF_OPTIMALITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
