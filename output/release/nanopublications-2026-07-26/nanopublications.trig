        ns1:neutral <http://activeinference.institute/ontology/hypothesis/fep_universality> ;
        ns1:sourceClaim "Recently, two versions of branching time active inference (BTAI) based on Monte-Carlo tree search have been developed to handle the exponential (space and time) complexity class that occurs when computing the prior over all possible policies up to the time horizon."^^xsd:string .
}

