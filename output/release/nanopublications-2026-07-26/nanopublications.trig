<http://activeinference.institute/nanopub/5ae902ec2d7c#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_doi_10.1080_01691864.2023.2225175_SCALABILITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
        ns1:prov_model_id "gemma3:4b"^^xsd:string ;
