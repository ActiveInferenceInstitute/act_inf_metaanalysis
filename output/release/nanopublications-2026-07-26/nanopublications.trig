    <http://activeinference.institute/ontology/assertion/llm_arxiv_2206.12503_FEP_UNIVERSALITY> ns1:citationCount 0 ;
        ns1:claim "The paper focuses on a specific implementation of BTAI and its performance within a simulated environment; it doesn't directly address the universal applicability of the FEP."^^xsd:string ;
        ns1:confidence 6e-01 ;
        ns1:evidenceQuote "Those two versions of BTAI still suffer from an exponential complexity class w.r.t the number of observed and latent variables being modelled."^^xsd:string ;
