<http://activeinference.institute/nanopub/a5e479ff3b82#provenance> {
    <http://activeinference.institute/ontology/assertion/llm_arxiv_2605.11638_SCALABILITY> ns1:prov_llm_host "localhost:11435"^^xsd:string ;
